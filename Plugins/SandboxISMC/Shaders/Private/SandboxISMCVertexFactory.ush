// The engine owns all vertex-factory logic; only instance inputs are customized.
// Expose decoder dependencies to UE's source scanner before the
// generated include emits the adapter after the engine's instance-input types.
#include "/SandboxISMC/Private/PackedInstanceInput.ush"

#define LOCALVF_INSTANCE_ATTRIBUTES       \
    float3 InstancePosition : ATTRIBUTE8; \
    uint PackedRotation : ATTRIBUTE9;

#include "/Engine/Private/LocalVertexFactory.ush"

#if LOCALVF_INSTANCE_INPUT_HOOK_VERSION != 1
#error SandboxISMC requires the LocalVF hook; see Plugins/SandboxISMC/ARCHITECTURE.md
#endif
