#define LOCALVF_INSTANCE_ATTRIBUTES     \
    uint PackedPositionXY : ATTRIBUTE8; \
    uint PackedPositionZ : ATTRIBUTE9;  \
    uint PackedRotation : ATTRIBUTE10;

#include "/Engine/Private/LocalVertexFactory.ush"

#if LOCALVF_INSTANCE_INPUT_HOOK_VERSION != 1
