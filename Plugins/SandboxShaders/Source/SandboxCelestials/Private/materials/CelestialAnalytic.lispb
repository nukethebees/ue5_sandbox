(material M_CelestialAnalytic
  (asset "/SandboxShaders/CelestialBackdrop/M_CelestialAnalytic")
  (adopt-existing true)
  (domain surface)
  (blend alpha-composite)
  (shading unlit)
  (two-sided true)

  (parameter scalar BodyRadius 50000.0)
  (parameter scalar OuterRadius 102500.0)
  (parameter scalar CloudAltitude 0.018)
  (parameter scalar AtmosphereThickness 0.075)
  (parameter color LocalAxisX 1.0 0.0 0.0 0.0)
  (parameter color LocalAxisY 0.0 1.0 0.0 0.0)
  (parameter color LocalAxisZ 0.0 0.0 1.0 0.0)
  (parameter color RingAxisX 1.0 0.0 0.0 0.0)
  (parameter color RingAxisY 0.0 1.0 0.0 0.0)
  (parameter color RingNormalWS 0.0 0.0 1.0 0.0)
  (parameter color SunDirection 0.35 -0.45 0.82 0.0)

  (parameter color PrimaryDayColour 0.025 0.12 0.28 1.0)
  (parameter color SecondaryDayColour 0.07 0.30 0.12 1.0)
  (parameter color NightColour 0.002 0.006 0.018 1.0)
  (parameter color EmissionColour 0.1 0.55 1.0 1.0)
  (parameter scalar BodyStyle 0.0)
  (parameter scalar TerminatorSoftness 0.16)
  (parameter scalar NightBrightness 0.22)
  (parameter scalar DetailScale 4.5)
  (parameter scalar DetailStrength 1.0)
  (parameter scalar NoiseBreakup 0.45)
  (parameter scalar StylisationSteps 0.0)
  (parameter scalar PatternSeed 173.0)
  (parameter scalar BandCount 12.0)
  (parameter scalar BandStrength 0.8)
  (parameter scalar BandWarp 0.18)
  (parameter scalar EmissionIntensity 0.0)
  (parameter scalar EmissionThreshold 0.72)
  (parameter scalar EmissionPattern 0.0)
  (parameter scalar EmissionScale 9.0)

  (parameter scalar PolarCapsEnabled 0.0)
  (parameter color PolarCapColour 0.65 0.82 1.0 1.0)
  (parameter scalar PolarCapSize 0.22)
  (parameter scalar PolarCapSoftness 0.08)
  (parameter scalar StormEnabled 0.0)
  (parameter color StormColour 0.75 0.14 0.035 1.0)
  (parameter scalar StormLatitudeDegrees -22.0)
  (parameter scalar StormLongitudeDegrees 28.0)
  (parameter scalar StormSize 0.18)
  (parameter scalar StormIntensity 0.85)

  (parameter scalar CloudsEnabled 1.0)
  (parameter color CloudColour 0.82 0.90 1.0 1.0)
  (parameter color CloudNightColour 0.025 0.05 0.10 1.0)
  (parameter scalar CloudAmount 0.42)
  (parameter scalar CloudOpacity 0.62)
  (parameter scalar CloudDetailScale 7.0)
  (parameter scalar CloudBreakup 0.35)
  (parameter scalar CloudRotationPhaseDegrees 0.0)
  (parameter scalar CloudRotationSpeedDegrees 0.45)

  (parameter scalar AtmosphereEnabled 1.0)
  (parameter color AtmosphereColour 0.03 0.36 1.0 1.0)
  (parameter scalar AtmosphereDensity 1.55)
  (parameter scalar LimbIntensity 7.0)
  (parameter scalar LimbFalloff 3.2)

  (parameter scalar RingsEnabled 0.0)
  (parameter color InnerRingColour 0.10 0.025 0.004 1.0)
  (parameter color OuterRingColour 0.95 0.35 0.035 1.0)
  (parameter scalar InnerRadiusFraction 0.585)
  (parameter scalar RingOuterRadiusRatio 2.05)
  (parameter scalar RingBandCount 34.0)
  (parameter scalar RingBandStrength 0.72)
  (parameter scalar RingBreakup 0.24)
  (parameter scalar RingEdgeSoftness 0.025)
  (parameter scalar RingEmissionIntensity 1.0)
  (parameter scalar RingShadowEnabled 1.0)
  (parameter scalar RingShadowDarkness 0.42)
  (parameter scalar RingShadowWidth 0.10)
  (parameter scalar RingShadowSoftness 0.035)

  (parameter scalar CloseApproachEnabled 1.0)
  (parameter scalar CloseGuardRatio 1.5)

  (let celestial
    (shader-call float4 "/Plugin/SandboxShaders/Private/CelestialBackdrop/CelestialBackdrop.ush"
      sbx_celestial_analytic
      ((pixel_world_position float3 (world-position))
       (object_world_position float3 (object-position))
       (camera_world_position float3 (camera-position))
       (local_axis_x float3 (swizzle LocalAxisX rgb))
       (local_axis_y float3 (swizzle LocalAxisY rgb))
       (local_axis_z float3 (swizzle LocalAxisZ rgb))
       (ring_axis_x float3 (swizzle RingAxisX rgb))
       (ring_axis_y float3 (swizzle RingAxisY rgb))
       (ring_normal_ws float3 (swizzle RingNormalWS rgb))
       (body_radius float BodyRadius)
       (outer_radius float OuterRadius)
       (cloud_altitude float CloudAltitude)
       (atmosphere_thickness float AtmosphereThickness)
       (sun_direction float3 (swizzle SunDirection rgb))
       (primary_day_colour float3 (swizzle PrimaryDayColour rgb))
       (secondary_day_colour float3 (swizzle SecondaryDayColour rgb))
       (night_colour float3 (swizzle NightColour rgb))
       (emission_colour float3 (swizzle EmissionColour rgb))
       (body_style float BodyStyle)
       (terminator_softness float TerminatorSoftness)
       (night_brightness float NightBrightness)
       (detail_scale float DetailScale)
       (detail_strength float DetailStrength)
       (noise_breakup float NoiseBreakup)
       (stylisation_steps float StylisationSteps)
       (pattern_seed float PatternSeed)
       (band_count float BandCount)
       (band_strength float BandStrength)
       (band_warp float BandWarp)
       (emission_intensity float EmissionIntensity)
       (emission_threshold float EmissionThreshold)
       (emission_pattern float EmissionPattern)
       (emission_scale float EmissionScale)
       (polar_caps_enabled float PolarCapsEnabled)
       (polar_cap_colour float3 (swizzle PolarCapColour rgb))
       (polar_cap_size float PolarCapSize)
       (polar_cap_softness float PolarCapSoftness)
       (storm_enabled float StormEnabled)
       (storm_colour float3 (swizzle StormColour rgb))
       (storm_latitude_degrees float StormLatitudeDegrees)
       (storm_longitude_degrees float StormLongitudeDegrees)
       (storm_size float StormSize)
       (storm_intensity float StormIntensity)
       (clouds_enabled float CloudsEnabled)
       (cloud_colour float3 (swizzle CloudColour rgb))
       (cloud_night_colour float3 (swizzle CloudNightColour rgb))
       (cloud_amount float CloudAmount)
       (cloud_opacity float CloudOpacity)
       (cloud_detail_scale float CloudDetailScale)
       (cloud_breakup float CloudBreakup)
       (cloud_rotation_phase_degrees float CloudRotationPhaseDegrees)
       (cloud_rotation_speed_degrees float CloudRotationSpeedDegrees)
       (atmosphere_enabled float AtmosphereEnabled)
       (atmosphere_colour float3 (swizzle AtmosphereColour rgb))
       (atmosphere_density float AtmosphereDensity)
       (limb_intensity float LimbIntensity)
       (limb_falloff float LimbFalloff)
       (rings_enabled float RingsEnabled)
       (inner_ring_colour float3 (swizzle InnerRingColour rgb))
       (outer_ring_colour float3 (swizzle OuterRingColour rgb))
       (ring_inner_radius_fraction float InnerRadiusFraction)
       (ring_outer_radius_ratio float RingOuterRadiusRatio)
       (ring_band_count float RingBandCount)
       (ring_band_strength float RingBandStrength)
       (ring_breakup float RingBreakup)
       (ring_edge_softness float RingEdgeSoftness)
       (ring_emission_intensity float RingEmissionIntensity)
       (ring_shadow_enabled float RingShadowEnabled)
       (ring_shadow_darkness float RingShadowDarkness)
       (ring_shadow_width float RingShadowWidth)
       (ring_shadow_softness float RingShadowSoftness)
       (close_approach_enabled float CloseApproachEnabled)
       (minimum_camera_distance_ratio float CloseGuardRatio)
       (animation_time float (time)))))

  (emissive (swizzle celestial rgb))
  (opacity (swizzle celestial a))
  (world-position-offset
    (shader-call float3 "/Plugin/SandboxShaders/Private/CelestialBackdrop/CelestialBackdrop.ush"
      sbx_celestial_close_approach_wpo
      ((vertex_world_position float3 (world-position))
       (object_world_position float3 (object-position))
       (camera_world_position float3 (camera-position))
       (enabled float CloseApproachEnabled)
       (outer_radius float OuterRadius)
       (minimum_distance_ratio float CloseGuardRatio)))))
