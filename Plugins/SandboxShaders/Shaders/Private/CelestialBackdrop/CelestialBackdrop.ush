#ifndef SANDBOX_SHADERS_CELESTIAL_BACKDROP
#define SANDBOX_SHADERS_CELESTIAL_BACKDROP

#include "/Plugin/SandboxShaders/Common/ProceduralNoise.ush"

float3 sbx_celestial_seed_offset(float const seed) {
    return float3(sbx_hash21(float2(seed, seed + 17.0)),
                  sbx_hash21(float2(seed + 41.0, seed + 73.0)),
                  sbx_hash21(float2(seed + 101.0, seed + 149.0))) *
           97.0;
}

float sbx_celestial_terminator(float3 const normal_ws,
                               float3 const sun_direction,
                               float const softness) {
    float const sun_facing = dot(normalize(normal_ws), normalize(sun_direction));
    float const width = max(softness, 0.001);
    return smoothstep(-width, width, sun_facing);
}

float sbx_celestial_stylise(float value, float const steps) {
    if (steps < 2.0) {
        return saturate(value);
    }

    float const intervals = max(round(steps) - 1.0, 1.0);
    return floor(saturate(value) * intervals + 0.5) / intervals;
}

float3 sbx_celestial_soft_limit(float3 const colour, float const knee) {
    float const peak = max(colour.r, max(colour.g, colour.b));
    return colour / (1.0 + max(peak, 0.0) * max(knee, 0.0));
}

float sbx_celestial_hive_edges(float3 const direction, float const scale) {
    float3 const weights = pow(abs(direction), 6.0);
    float2 coordinates;
    if (weights.x >= weights.y && weights.x >= weights.z) {
        coordinates = direction.yz;
    } else if (weights.y >= weights.z) {
        coordinates = direction.xz;
    } else {
        coordinates = direction.xy;
    }

    coordinates *= max(scale, 0.5);
    coordinates.x *= 0.57735027;
    coordinates.y += frac(floor(coordinates.x) * 0.5) * 0.5;
    float2 const cell = abs(frac(coordinates) - 0.5);
    float const edge_distance = max(cell.x * 1.55 + cell.y * 0.72, cell.y * 1.75);
    return smoothstep(0.60, 0.82, edge_distance);
}

float sbx_celestial_storm(float3 const direction,
                          float const latitude_degrees,
                          float const longitude_degrees,
                          float const size,
                          float const breakup) {
    float const latitude = radians(clamp(latitude_degrees, -89.9, 89.9));
    float const longitude = radians(longitude_degrees);
    float const latitude_cosine = cos(latitude);
    float3 const centre =
        float3(latitude_cosine * cos(longitude), latitude_cosine * sin(longitude), sin(latitude));
    float3 const east = float3(-sin(longitude), cos(longitude), 0.0);
    float3 const north =
        float3(-sin(latitude) * cos(longitude), -sin(latitude) * sin(longitude), latitude_cosine);
    float2 storm_coordinates = float2(dot(direction, east) / max(size * 1.9, 0.001),
                                      dot(direction, north) / max(size, 0.001));
    float const swirl = sin(atan2(storm_coordinates.y, storm_coordinates.x) * 3.0 + breakup * 8.0);
    storm_coordinates.x += swirl * 0.09;
    float const storm_distance = length(storm_coordinates);
    float const facing = smoothstep(-0.02, 0.08, dot(direction, centre));
    return (1.0 - smoothstep(0.62, 1.0, storm_distance)) * facing;
}

float sbx_celestial_emission_pattern(float3 const direction,
                                     float const detail_noise,
                                     float const surface_pattern,
                                     float const pattern,
                                     float const scale) {
    if (pattern >= 1.5) {
        float const cracks = 1.0 - abs(detail_noise * 2.0 - 1.0);
        float const fine_cracks =
            1.0 - abs(sbx_value_noise3(direction * max(scale, 0.5) * 1.73 + 37.1) * 2.0 - 1.0);
        return saturate(max(cracks, fine_cracks) * 1.16 - 0.22);
    }
    if (pattern >= 0.5) {
        return sbx_celestial_hive_edges(direction, scale);
    }
    return detail_noise * 0.65 + (1.0 - surface_pattern) * 0.35;
}

float3 sbx_celestial_surface(float3 normal_local,
                             float3 normal_ws,
                             float3 sun_direction,
                             float3 primary_day_colour,
                             float3 secondary_day_colour,
                             float3 night_colour,
                             float3 emission_colour,
                             float body_style,
                             float terminator_softness,
                             float night_brightness,
                             float detail_scale,
                             float detail_strength,
                             float noise_breakup,
                             float stylisation_steps,
                             float pattern_seed,
                             float band_count,
                             float band_strength,
                             float band_warp,
                             float emission_intensity,
                             float emission_threshold,
                             float emission_pattern,
                             float emission_scale,
                             float polar_caps_enabled,
                             float3 polar_cap_colour,
                             float polar_cap_size,
                             float polar_cap_softness,
                             float storm_enabled,
                             float3 storm_colour,
                             float storm_latitude_degrees,
                             float storm_longitude_degrees,
                             float storm_size,
                             float storm_intensity,
                             float3 ring_normal_ws,
                             float ring_shadow_enabled,
                             float ring_shadow_darkness,
                             float ring_shadow_width,
                             float ring_shadow_softness) {
    normal_local = normalize(normal_local);
    float3 const seed_offset = sbx_celestial_seed_offset(pattern_seed);
    float const broad_noise = sbx_fbm3(normal_local * max(detail_scale, 0.1) + seed_offset);
    float const detail_noise =
        sbx_value_noise3(normal_local * max(detail_scale, 0.1) * 3.17 + seed_offset.yzx + 11.7);
    float const broken_noise =
        lerp(broad_noise, broad_noise * 0.68 + detail_noise * 0.42, saturate(noise_breakup));

    float pattern = broken_noise;
    if (body_style >= 0.5) {
        float const warped_latitude =
            normal_local.z + (broad_noise - 0.5) * saturate(band_warp) * 0.35;
        float const bands = 0.5 + 0.5 * sin(warped_latitude * max(band_count, 1.0) * 6.2831853);
        pattern = lerp(broken_noise, bands * 0.82 + detail_noise * 0.18, saturate(band_strength));
    }

    pattern = lerp(0.5, pattern, max(detail_strength, 0.0));
    pattern = sbx_celestial_stylise(pattern, stylisation_steps);

    float const daylight = sbx_celestial_terminator(normal_ws, sun_direction, terminator_softness);
    float3 const day_colour = lerp(primary_day_colour, secondary_day_colour, pattern);
    float3 const dark_colour =
        night_colour * max(night_brightness, 0.0) * lerp(0.72, 1.18, pattern);
    float3 colour = lerp(dark_colour, day_colour, daylight);

    float const polar_threshold = 1.0 - saturate(polar_cap_size);
    float const polar_mask = smoothstep(polar_threshold - max(polar_cap_softness, 0.001),
                                        polar_threshold + max(polar_cap_softness, 0.001),
                                        abs(normal_local.z)) *
                             saturate(polar_caps_enabled);
    colour = lerp(colour, polar_cap_colour * lerp(0.42, 1.0, daylight), polar_mask);

    float storm_mask = 0.0;
    if (storm_enabled >= 0.5) {
        storm_mask = sbx_celestial_storm(normal_local,
                                         storm_latitude_degrees,
                                         storm_longitude_degrees,
                                         max(storm_size, 0.02),
                                         broad_noise) *
                     saturate(storm_intensity);
    }
    colour = lerp(colour, storm_colour * lerp(0.34, 1.1, daylight), storm_mask);

    float const ring_plane_distance = abs(dot(normalize(normal_ws), normalize(ring_normal_ws)));
    float const ring_shadow =
        (1.0 - smoothstep(max(ring_shadow_width, 0.005),
                          max(ring_shadow_width + ring_shadow_softness, 0.006),
                          ring_plane_distance)) *
        saturate(ring_shadow_enabled) * saturate(ring_shadow_darkness) * daylight;
    colour *= 1.0 - ring_shadow;

    float const emission_source = sbx_celestial_emission_pattern(
        normal_local, detail_noise, pattern, emission_pattern, emission_scale);
    float const emission_mask = smoothstep(
        saturate(emission_threshold), saturate(emission_threshold + 0.12), emission_source);
    float3 const emission = emission_colour * emission_mask * max(emission_intensity, 0.0) *
                            (1.0 - daylight * 0.88);
    colour += sbx_celestial_soft_limit(emission, 0.12);
    return colour;
}

float4 sbx_celestial_rings(float2 const uv,
                           float3 const inner_colour,
                           float3 const outer_colour,
                           float inner_radius_fraction,
                           float band_count,
                           float band_strength,
                           float breakup,
                           float edge_softness,
                           float emission_intensity,
                           float pattern_seed) {
    float2 const centred = (uv - 0.5) * 2.0;
    float const radius = length(centred);
    float const inner_radius = clamp(inner_radius_fraction, 0.05, 0.98);
    float const ring_width = max(1.0 - inner_radius, 0.001);
    float const radial_position = saturate((radius - inner_radius) / ring_width);
    float const radial_footprint = max(fwidth(radius), 0.00001);
    float const softness = max(max(edge_softness, 0.001), radial_footprint * 1.5);
    float const annulus = smoothstep(inner_radius, inner_radius + softness, radius) *
                          (1.0 - smoothstep(1.0 - softness, 1.0, radius));

    float const broad_noise = sbx_value_noise(centred * 3.7 + pattern_seed * 0.013);
    float const fine_noise = sbx_value_noise(centred * 17.3 + pattern_seed * 0.031 + 8.4);
    float const band_phase = radial_position * max(band_count, 1.0) * 6.2831853 +
                             (broad_noise - 0.5) * 4.0;
    float const band_footprint = fwidth(band_phase);
    float const band_amplitude = saturate(1.0 - band_footprint / 3.14159265);
    float const bands = 0.5 + 0.5 * sin(band_phase) * band_amplitude;
    float const band_mask = lerp(1.0, smoothstep(0.18, 0.82, bands), saturate(band_strength));
    float const breakup_mask = lerp(1.0, smoothstep(0.22, 0.78, fine_noise), saturate(breakup));
    float const mask = annulus * band_mask * breakup_mask;
    float3 const colour = lerp(inner_colour, outer_colour, radial_position) *
                          (0.48 + bands * 0.52) * max(emission_intensity, 0.0);
    return float4(colour, mask);
}

float4 sbx_celestial_clouds(float3 normal_local,
                            float3 normal_ws,
                            float3 sun_direction,
                            float3 cloud_colour,
                            float3 cloud_night_colour,
                            float terminator_softness,
                            float cloud_amount,
                            float cloud_opacity,
                            float cloud_detail_scale,
                            float cloud_breakup,
                            float pattern_seed,
                            float rotation_phase_degrees,
                            float rotation_speed_degrees,
                            float animation_time) {
    float const angle = radians(rotation_phase_degrees + rotation_speed_degrees * animation_time);
    float const angle_sine = sin(angle);
    float const angle_cosine = cos(angle);
    float3 rotated_normal = normalize(normal_local);
    rotated_normal.xy = float2(rotated_normal.x * angle_cosine - rotated_normal.y * angle_sine,
                               rotated_normal.x * angle_sine + rotated_normal.y * angle_cosine);

    float3 const seed_offset = sbx_celestial_seed_offset(pattern_seed + 317.0);
    float const broad_noise = sbx_fbm3(rotated_normal * max(cloud_detail_scale, 0.1) + seed_offset);
    float const detail_noise =
        sbx_value_noise3(rotated_normal * max(cloud_detail_scale, 0.1) * 3.83 + seed_offset.zxy);
    float const cloud_noise =
        lerp(broad_noise, broad_noise * 0.72 + detail_noise * 0.36, saturate(cloud_breakup));
    float const threshold = lerp(0.93, 0.24, saturate(cloud_amount));
    float const mask = smoothstep(threshold, min(threshold + 0.16, 1.0), cloud_noise);
    float const daylight = sbx_celestial_terminator(normal_ws, sun_direction, terminator_softness);
    float3 const colour =
        lerp(cloud_night_colour, cloud_colour, daylight) * (0.45 + daylight * 0.75);
    return float4(colour, mask * saturate(cloud_opacity));
}

float4 sbx_celestial_atmosphere(float3 normal_ws,
                                float3 camera_vector_ws,
                                float3 sun_direction,
                                float3 atmosphere_colour,
                                float terminator_softness,
                                float atmosphere_density,
                                float limb_intensity,
                                float limb_falloff) {
    float3 const normal = normalize(normal_ws);
    float3 const view_direction = normalize(camera_vector_ws);
    float const view_cosine = saturate(dot(normal, view_direction));
    float const limb = pow(1.0 - view_cosine, max(limb_falloff, 0.5));
    float const density = max(atmosphere_density, 0.0);
    float const optical_depth = 1.0 - exp(-density / max(view_cosine * 4.0, 0.18));
    float const daylight =
        sbx_celestial_terminator(normal, sun_direction, max(terminator_softness * 1.8, 0.02));
    float const horizon_daylight = lerp(0.09, 1.0, daylight);
    float const forward_scatter =
        pow(saturate(dot(view_direction, normalize(sun_direction))), 8.0) * daylight;
    float const energy =
        saturate(optical_depth * (0.18 + limb * 1.55) * horizon_daylight + forward_scatter * 0.16);
    return float4(atmosphere_colour * energy * max(limb_intensity, 0.0), saturate(energy * 0.82));
}

float3 sbx_celestial_close_approach_wpo(float3 const vertex_world_position,
                                        float3 const object_world_position,
                                        float3 const camera_world_position,
                                        float const enabled,
                                        float const outer_radius,
                                        float const minimum_distance_ratio) {
    if (enabled < 0.5) {
        return 0.0;
    }

    float const camera_distance = distance(camera_world_position, object_world_position);
    float const guard_distance = max(outer_radius, 0.001) * max(minimum_distance_ratio, 1.001);
    float const scale = saturate(camera_distance / guard_distance);
    return (vertex_world_position - object_world_position) * (scale - 1.0);
}

bool sbx_celestial_ray_sphere(float3 const ray_origin,
                              float3 const ray_direction,
                              float3 const centre,
                              float const radius,
                              out float distance_to_hit,
                              out float3 normal_ws) {
    float3 const offset = ray_origin - centre;
    float const projected = dot(offset, ray_direction);
    float const discriminant = projected * projected - dot(offset, offset) + radius * radius;
    if (discriminant < 0.0) {
        distance_to_hit = 0.0;
        normal_ws = 0.0;
        return false;
    }

    float const root = sqrt(discriminant);
    float const near_distance = -projected - root;
    float const far_distance = -projected + root;
    distance_to_hit = near_distance > 0.0 ? near_distance : far_distance;
    if (distance_to_hit <= 0.0) {
        normal_ws = 0.0;
        return false;
    }

    normal_ws = normalize(ray_origin + ray_direction * distance_to_hit - centre);
    return true;
}

float4 sbx_celestial_alpha_over(float4 const foreground, float4 const background) {
    return float4(foreground.rgb + background.rgb * (1.0 - foreground.a),
                  foreground.a + background.a * (1.0 - foreground.a));
}

float4 sbx_celestial_analytic(float3 const pixel_world_position,
                              float3 const object_world_position,
                              float3 const camera_world_position,
                              float3 const local_axis_x,
                              float3 const local_axis_y,
                              float3 const local_axis_z,
                              float3 const ring_axis_x,
                              float3 const ring_axis_y,
                              float3 const ring_normal_ws,
                              float const body_radius,
                              float const outer_radius,
                              float const cloud_altitude,
                              float const atmosphere_thickness,
                              float3 const sun_direction,
                              float3 const primary_day_colour,
                              float3 const secondary_day_colour,
                              float3 const night_colour,
                              float3 const emission_colour,
                              float const body_style,
                              float const terminator_softness,
                              float const night_brightness,
                              float const detail_scale,
                              float const detail_strength,
                              float const noise_breakup,
                              float const stylisation_steps,
                              float const pattern_seed,
                              float const band_count,
                              float const band_strength,
                              float const band_warp,
                              float const emission_intensity,
                              float const emission_threshold,
                              float const emission_pattern,
                              float const emission_scale,
                              float const polar_caps_enabled,
                              float3 const polar_cap_colour,
                              float const polar_cap_size,
                              float const polar_cap_softness,
                              float const storm_enabled,
                              float3 const storm_colour,
                              float const storm_latitude_degrees,
                              float const storm_longitude_degrees,
                              float const storm_size,
                              float const storm_intensity,
                              float const clouds_enabled,
                              float3 const cloud_colour,
                              float3 const cloud_night_colour,
                              float const cloud_amount,
                              float const cloud_opacity,
                              float const cloud_detail_scale,
                              float const cloud_breakup,
                              float const cloud_rotation_phase_degrees,
                              float const cloud_rotation_speed_degrees,
                              float const atmosphere_enabled,
                              float3 const atmosphere_colour,
                              float const atmosphere_density,
                              float const limb_intensity,
                              float const limb_falloff,
                              float const rings_enabled,
                              float3 const inner_ring_colour,
                              float3 const outer_ring_colour,
                              float const ring_inner_radius_fraction,
                              float const ring_outer_radius_ratio,
                              float const ring_band_count,
                              float const ring_band_strength,
                              float const ring_breakup,
                              float const ring_edge_softness,
                              float const ring_emission_intensity,
                              float const ring_shadow_enabled,
                              float const ring_shadow_darkness,
                              float const ring_shadow_width,
                              float const ring_shadow_softness,
                              float const close_approach_enabled,
                              float const minimum_camera_distance_ratio,
                              float const animation_time) {
    float const camera_distance = distance(camera_world_position, object_world_position);
    float const guard_distance =
        max(outer_radius, 0.001) * max(minimum_camera_distance_ratio, 1.001);
    float const close_scale =
        close_approach_enabled >= 0.5 ? saturate(camera_distance / guard_distance) : 1.0;
    float const effective_body_radius = max(body_radius * close_scale, 0.001);
    float const cloud_radius = effective_body_radius * (1.0 + max(cloud_altitude, 0.0));
    float const atmosphere_radius = effective_body_radius * (1.0 + max(atmosphere_thickness, 0.0));
    float const ring_outer_radius = effective_body_radius * max(ring_outer_radius_ratio, 1.001);
    float3 const ray_direction = normalize(pixel_world_position - camera_world_position);

    float body_distance;
    float3 body_normal_ws;
    bool const body_hit = sbx_celestial_ray_sphere(camera_world_position,
                                                   ray_direction,
                                                   object_world_position,
                                                   effective_body_radius,
                                                   body_distance,
                                                   body_normal_ws);

    float4 body_layer = 0.0;
    if (body_hit) {
        float3 const body_normal_local = float3(dot(body_normal_ws, normalize(local_axis_x)),
                                                dot(body_normal_ws, normalize(local_axis_y)),
                                                dot(body_normal_ws, normalize(local_axis_z)));
        body_layer = float4(sbx_celestial_surface(body_normal_local,
                                                  body_normal_ws,
                                                  sun_direction,
                                                  primary_day_colour,
                                                  secondary_day_colour,
                                                  night_colour,
                                                  emission_colour,
                                                  body_style,
                                                  terminator_softness,
                                                  night_brightness,
                                                  detail_scale,
                                                  detail_strength,
                                                  noise_breakup,
                                                  stylisation_steps,
                                                  pattern_seed,
                                                  band_count,
                                                  band_strength,
                                                  band_warp,
                                                  emission_intensity,
                                                  emission_threshold,
                                                  emission_pattern,
                                                  emission_scale,
                                                  polar_caps_enabled,
                                                  polar_cap_colour,
                                                  polar_cap_size,
                                                  polar_cap_softness,
                                                  storm_enabled,
                                                  storm_colour,
                                                  storm_latitude_degrees,
                                                  storm_longitude_degrees,
                                                  storm_size,
                                                  storm_intensity,
                                                  ring_normal_ws,
                                                  ring_shadow_enabled * rings_enabled,
                                                  ring_shadow_darkness,
                                                  ring_shadow_width,
                                                  ring_shadow_softness),
                            1.0);
    }

    float cloud_distance;
    float3 cloud_normal_ws;
    bool const cloud_hit = clouds_enabled >= 0.5 && sbx_celestial_ray_sphere(camera_world_position,
                                                                             ray_direction,
                                                                             object_world_position,
                                                                             cloud_radius,
                                                                             cloud_distance,
                                                                             cloud_normal_ws);
    float4 cloud_layer = 0.0;
    if (cloud_hit) {
        float3 const cloud_normal_local = float3(dot(cloud_normal_ws, normalize(local_axis_x)),
                                                 dot(cloud_normal_ws, normalize(local_axis_y)),
                                                 dot(cloud_normal_ws, normalize(local_axis_z)));
        float4 const cloud = sbx_celestial_clouds(cloud_normal_local,
                                                  cloud_normal_ws,
                                                  sun_direction,
                                                  cloud_colour,
                                                  cloud_night_colour,
                                                  terminator_softness,
                                                  cloud_amount,
                                                  cloud_opacity,
                                                  cloud_detail_scale,
                                                  cloud_breakup,
                                                  pattern_seed,
                                                  cloud_rotation_phase_degrees,
                                                  cloud_rotation_speed_degrees,
                                                  animation_time);
        cloud_layer = float4(cloud.rgb * cloud.a, cloud.a);
    }

    float ring_distance = 0.0;
    float4 ring_layer = 0.0;
    bool ring_hit = false;
    float const ring_denominator = dot(ray_direction, normalize(ring_normal_ws));
    if (rings_enabled >= 0.5 && abs(ring_denominator) > 0.00001) {
        ring_distance =
            dot(object_world_position - camera_world_position, normalize(ring_normal_ws)) /
            ring_denominator;
        float3 const ring_offset =
            camera_world_position + ray_direction * ring_distance - object_world_position;
        float2 const ring_coordinates = float2(dot(ring_offset, normalize(ring_axis_x)),
                                               dot(ring_offset, normalize(ring_axis_y))) /
                                        max(ring_outer_radius, 0.001);
        float4 const ring = sbx_celestial_rings(ring_coordinates * 0.5 + 0.5,
                                                inner_ring_colour,
                                                outer_ring_colour,
                                                ring_inner_radius_fraction,
                                                ring_band_count,
                                                ring_band_strength,
                                                ring_breakup,
                                                ring_edge_softness,
                                                ring_emission_intensity,
                                                pattern_seed);
        ring_hit = ring_distance > 0.0 && ring.a > 0.0;
        ring_layer = float4(ring.rgb * ring.a, ring.a);
    }

    float4 result = body_layer;
    if (ring_hit && (!body_hit || ring_distance < body_distance)) {
        if (cloud_hit && cloud_distance < ring_distance) {
            result = sbx_celestial_alpha_over(cloud_layer,
                                              sbx_celestial_alpha_over(ring_layer, body_layer));
        } else {
            result = sbx_celestial_alpha_over(ring_layer,
                                              sbx_celestial_alpha_over(cloud_layer, body_layer));
        }
    } else {
        result = sbx_celestial_alpha_over(cloud_layer, body_layer);
    }

    float atmosphere_distance;
    float3 atmosphere_normal_ws;
    bool const atmosphere_hit =
        atmosphere_enabled >= 0.5 && sbx_celestial_ray_sphere(camera_world_position,
                                                              ray_direction,
                                                              object_world_position,
                                                              atmosphere_radius,
                                                              atmosphere_distance,
                                                              atmosphere_normal_ws);
    if (atmosphere_hit) {
        float4 const atmosphere = sbx_celestial_atmosphere(atmosphere_normal_ws,
                                                           -ray_direction,
                                                           sun_direction,
                                                           atmosphere_colour,
                                                           terminator_softness,
                                                           atmosphere_density,
                                                           limb_intensity,
                                                           limb_falloff);
        result.rgb += atmosphere.rgb;
    }

    return result;
}

#endif
