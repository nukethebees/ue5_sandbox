#ifndef SANDBOX_SHADERS_SHIELD_IMPACT
#define SANDBOX_SHADERS_SHIELD_IMPACT

#include "/Plugin/SandboxShaders/Common/ProceduralNoise.ush"

float sbx_hex_edges(float2 value)
{
    float2 const skewed = float2(value.x * 1.1547, value.y + value.x * 0.57735);
    float2 const cell = abs(frac(skewed) - 0.5);
    float const edge_distance = max(cell.x, max(cell.y, abs(cell.x - cell.y)));
    return smoothstep(0.39, 0.48, edge_distance);
}

float2 sbx_evaluate_impact(float3 surface_direction,
                           float4 impact_data,
                           float4 impact_state,
                           float duration,
                           float expansion_speed,
                           float pulse_width)
{
    if (impact_state.w < 0.5 || impact_state.y <= 0.0)
    {
        return 0.0;
    }

    float3 const impact_direction = normalize(impact_data.xyz);
    float const normalized_age = saturate(impact_state.x / max(duration, 0.001));
    float const arc_distance = acos(clamp(dot(surface_direction, impact_direction), -1.0, 1.0)) /
                               3.14159265;
    float const ring_radius = impact_data.w + impact_state.x * expansion_speed;
    float const ring_distance = abs(arc_distance - ring_radius);
    float const ring = 1.0 - smoothstep(pulse_width, pulse_width * 2.2, ring_distance);
    float const flash = exp(-arc_distance * 16.0) * exp(-impact_state.x * 7.0);
    float const fade = (1.0 - normalized_age) * impact_state.y;
    return float2(ring * fade, flash * impact_state.y);
}

// Four explicit parameter pairs keep the CPU-to-material data path inspectable in the editor.
float4 sbx_shield_impact(float3 local_position,
                         float3 normal_ws,
                         float3 camera_vector_ws,
                         float4 impact_data_0,
                         float4 impact_state_0,
                         float4 impact_data_1,
                         float4 impact_state_1,
                         float4 impact_data_2,
                         float4 impact_state_2,
                         float4 impact_data_3,
                         float4 impact_state_3,
                         float impact_duration,
                         float expansion_speed,
                         float pulse_width,
                         float fresnel_power,
                         float noise_breakup,
                         float impact_intensity,
                         float shield_opacity,
                         float3 base_colour,
                         float3 impact_colour)
{
    float3 const surface_direction = normalize(local_position);
    float2 response = sbx_evaluate_impact(surface_direction, impact_data_0, impact_state_0, impact_duration, expansion_speed, pulse_width);
    response += sbx_evaluate_impact(surface_direction, impact_data_1, impact_state_1, impact_duration, expansion_speed, pulse_width);
    response += sbx_evaluate_impact(surface_direction, impact_data_2, impact_state_2, impact_duration, expansion_speed, pulse_width);
    response += sbx_evaluate_impact(surface_direction, impact_data_3, impact_state_3, impact_duration, expansion_speed, pulse_width);

    float const noise = sbx_fbm(surface_direction.xy * 7.0 + surface_direction.z * 3.1);
    float const breakup = lerp(1.0, smoothstep(0.2, 0.8, noise), noise_breakup);
    float const hexes = sbx_hex_edges(surface_direction.xy * 12.0 + surface_direction.z * 4.0);
    float const fresnel = pow(1.0 - saturate(dot(normalize(normal_ws), normalize(camera_vector_ws))), fresnel_power);
    float const ripple = response.x * breakup;
    float const local_activation = saturate(ripple * (0.55 + hexes * 0.8) + response.y);
    float const energy = fresnel * 0.55 + ripple + local_activation;
    float3 const colour = lerp(base_colour, impact_colour, saturate(local_activation));
    float3 const emissive = colour * energy * impact_intensity;
    float const alpha = saturate((0.05 + fresnel * 0.5 + ripple * 0.85 + response.y) * shield_opacity);
    return float4(emissive, alpha);
}

#endif
