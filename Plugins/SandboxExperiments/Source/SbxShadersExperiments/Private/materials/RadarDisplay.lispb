(material M_RadarDisplay
  (asset "/SandboxShaders/Experiments/RadarDisplay/M_RadarDisplay")
  (adopt-existing true)
  (domain surface)
  (blend opaque)
  (shading unlit)
  (two-sided true)

  (parameter color BackgroundColour 0.001 0.018 0.012 1.0)
  (parameter color GridColour 0.0 0.28 0.12 1.0)
  (parameter color SweepColour 0.05 1.0 0.32 1.0)
  (parameter color ContactColour 1.0 0.55 0.05 1.0)
  (parameter scalar RingCount 5.0)
  (parameter scalar SweepSpeed 0.18)
  (parameter scalar SweepWidth 0.18)
  (parameter scalar Interference 0.22)
  (parameter scalar EmissiveIntensity 6.0)
  (parameter color ContactA -0.45 0.2 0.04 1.0)
  (parameter color ContactB 0.28 0.5 0.03 0.8)
  (parameter color ContactC 0.52 -0.22 0.05 1.2)
  (parameter color ContactD -0.12 -0.58 0.025 0.7)

  (emissive
    (shader-call float3 "/Plugin/SandboxShaders/Private/RadarDisplay/RadarDisplay.ush"
      sbx_radar_display
      ((uv float2 (texcoord 0))
       (time_seconds float (time))
       (background_colour float3 (swizzle BackgroundColour rgb))
       (grid_colour float3 (swizzle GridColour rgb))
       (sweep_colour float3 (swizzle SweepColour rgb))
       (contact_colour float3 (swizzle ContactColour rgb))
       (ring_count float RingCount)
       (sweep_speed float SweepSpeed)
       (sweep_width float SweepWidth)
       (interference float Interference)
       (emissive_intensity float EmissiveIntensity)
       (contact_a float4 ContactA)
       (contact_b float4 ContactB)
       (contact_c float4 ContactC)
       (contact_d float4 ContactD)))))
