(material M_UiGlowComposite
  (asset "/SandboxUI/Generated/Materials/M_UiGlowComposite")
  (domain ui)
  (blend additive)

  (parameter texture GlowEnergy "/SandboxUI/Materials/T_UiGlowBlack")
  (parameter texture CoreTexture "/SandboxUI/Materials/T_UiGlowBlack")
  (parameter color GlowColor 0.84 0.65 0.23 1.0)
  (parameter scalar PreserveCorePixels 0.0)

  (let uv (texcoord 0))
  (let core_alpha (swizzle (sample CoreTexture uv) a))
  (let energy (swizzle (sample GlowEnergy uv) r))
  (let preserve_mask
    (custom float
      ((Preserve float PreserveCorePixels)
       (CoreAlpha float core_alpha))
      :description "Strict core-pixel preservation mask"
      "return Preserve > 0.5 && CoreAlpha > 0.0 ? 0.0 : 1.0;"))

  (emissive (* energy (swizzle GlowColor rgb) preserve_mask)))
