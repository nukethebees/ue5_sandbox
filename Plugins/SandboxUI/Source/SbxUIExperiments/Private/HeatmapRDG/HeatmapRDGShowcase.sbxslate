(widget-class UHeatmapRDGShowcase
  (function RebuildWidget
    (SExperimentPanel
      :Title (loc "HeatmapRDG" "Title" "RDG GPU Heatmap Showcase")
      :Description (loc "HeatmapRDG" "Description" "Each update uploads one dense scalar grid and draws one Slate image.")
      (slot Controls
        (vbox
          (auto :padding (0 0 0 6)
            (SLabeledRow
              :Label (loc "HeatmapRDG" "InputResolution" "Input grid resolution:")
              (hbox
                (auto :padding (0 0 4 0) (existing size_32_button))
                (auto :padding (0 0 4 0) (existing size_64_button))
                (auto :padding (0 0 4 0) (existing size_128_button))
                (auto :padding (0 0 4 0) (existing size_256_button))
                (auto (existing size_512_button)))))
          (auto :padding (0 0 0 10)
            (SLabeledRow
              :Label (loc "HeatmapRDG" "Pattern" "Pattern:")
              (hbox
                (auto :padding (0 0 4 0)
                  (SButton
                    :Text (loc "HeatmapRDG" "Hotspots" "Hotspots")
                    :OnClicked (uobject show_hotspots)))
                (auto
                  (SButton
                    :Text (loc "HeatmapRDG" "Gradient" "Gradient + checker")
                    :OnClicked (uobject show_gradient))))))
          (auto
            (SExperimentBenchmark
              :ButtonText (loc "HeatmapRDG" "RunBenchmark" "Benchmark RDG vs Slate custom vertices")
              :ToolTipText (loc "HeatmapRDG" "RunBenchmarkTooltip" "Runs a short CPU benchmark at 32x32 through 512x512.")
              :OnClicked (uobject run_benchmark)
              :OutputHeight 180.0f
              (slot Output
                (assign benchmark_output_ SMultiLineEditableTextBox
                  :IsReadOnly true
                  :Text (loc "HeatmapRDG" "BenchmarkInstructions" "Results appear here. The CLI writes the same stages to CSV.")))))))
      (slot Preview
        (SBox
          :MinDesiredWidth 512.0f
          :MinDesiredHeight 512.0f
          (existing heatmap_preview))))))
