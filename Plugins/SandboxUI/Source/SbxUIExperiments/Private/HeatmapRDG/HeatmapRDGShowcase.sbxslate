(include "Experiments/Patterns.sbxslate")

(widget-class UHeatmapRDGShowcase
  (function BuildSizeButton
    (params
      (value label)
      (value on_clicked))
    (SButton
      :Text label
      :OnClicked on_clicked))
  (function RebuildWidget
    (params
      (existing size_32_button)
      (existing size_64_button)
      (existing size_128_button)
      (existing size_256_button)
      (existing size_512_button)
      (existing heatmap_preview))
    (let ((controls_padding (0 0 0 6))
          (section_padding (0 0 0 10))
          (button_padding (0 0 4 0))
          (preview_size 512.0f))
      (SExperimentPanel
      :Title (loc "HeatmapRDG" "Title" "RDG GPU Heatmap Showcase")
      :Description (loc "HeatmapRDG" "Description" "Each update uploads one dense scalar grid and draws one Slate image.")
      (slot Controls
        (vbox
          (auto :padding controls_padding
            (SLabeledRow
              :Label (loc "HeatmapRDG" "InputResolution" "Input grid resolution:")
              (hbox
                (auto :padding button_padding (existing size_32_button))
                (auto :padding button_padding (existing size_64_button))
                (auto :padding button_padding (existing size_128_button))
                (auto :padding button_padding (existing size_256_button))
                (auto (existing size_512_button)))))
          (auto :padding section_padding
            (SLabeledRow
              :Label (loc "HeatmapRDG" "Pattern" "Pattern:")
              (hbox
                (auto :padding button_padding
                  (SButton
                    :Text (loc "HeatmapRDG" "Hotspots" "Hotspots")
                    :OnClicked (uobject show_hotspots)))
                (auto
                  (SButton
                    :Text (loc "HeatmapRDG" "Gradient" "Gradient + checker")
                    :OnClicked (uobject show_gradient))))))
          (auto
            (SExperimentBenchmark
              :ButtonText (loc "HeatmapRDG" "RunBenchmark" "Benchmark RDG vs Slate custom vertices")
              :ToolTipText (loc "HeatmapRDG" "RunBenchmarkTooltip" "Runs a short CPU benchmark at 32x32 through 512x512.")
              :OnClicked (uobject run_benchmark)
              :OutputHeight 180.0f
              (benchmark-output benchmark_output_ "HeatmapRDG")))))
      (slot Preview
        (SBox
          :MinDesiredWidth preview_size
          :MinDesiredHeight preview_size
          (existing heatmap_preview)))))))

(widget-class UHeatmapRDGWidget
  (image-builder image_))
