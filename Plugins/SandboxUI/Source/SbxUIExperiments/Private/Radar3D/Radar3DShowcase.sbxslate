(include "Experiments/Patterns.sbxslate")

(widget-class URadar3DShowcase
  (function BuildRadarWidget
    (params)
    (SRadar3DWidget))
  (function RebuildWidget
    (params
      (callback on_value_changed)
      (existing radar_widget))
    (SExperimentPanel
      :Title (loc "Radar3D" "Title" "RDG 3D Radar Experiment")
      :Description (loc "Radar3D" "Description" "Synthetic CPU contacts are rendered by RDG into one offscreen texture and displayed by Slate.")
      (slot Controls
        (vbox
          (auto :padding (0 0 0 10)
            (SLabeledRow
              :Label (loc "Radar3D" "ContactCount" "Contacts")
              :ContentHAlign HAlign_Left
              (SSpinBox<int32>
                :MinValue 1
                :MaxValue 256
                :MinSliderValue 1
                :MaxSliderValue 256
                :Delta 1
                :MinDesiredWidth 120.0f
                :Value 5
                :OnValueChanged (callback on_value_changed))))
          (auto
            (SExperimentBenchmark
              :ButtonText (loc "Radar3D" "RunBenchmark" "Benchmark RDG contact scaling")
              :ToolTipText (loc "Radar3D" "RunBenchmarkTooltip" "Runs a short 512x512 benchmark from 1 to 256 contacts.")
              :OnClicked (uobject run_benchmark)
              (benchmark-output benchmark_output_ "Radar3D")))))
      (square-preview radar_widget 512.0f))))

(widget-class SRadar3DWidget
  (image-builder image_))
