(defmacro image-builder (member)
  (function BuildImage
    (params (value brush))
    (assign $member SImage :Image brush)))

(defmacro square-preview (widget size)
  (slot Preview
    (SBox
      :WidthOverride $size
      :HeightOverride $size
      (existing $widget))))

(defmacro benchmark-output (member context)
  (slot Output
    (assign $member SMultiLineEditableTextBox
      :IsReadOnly true
      :Text (loc $context "BenchmarkInstructions" "Results appear here. The CLI writes the same stages to CSV."))))
