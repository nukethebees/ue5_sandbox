#include "/Engine/Public/Platform.ush"

struct ScatterSample {
    float3 position;
    float size;
    float4 color;
};

StructuredBuffer<ScatterSample> Samples;
int2 OutputSize;

struct ProjectedPosition {
    float2 pixel;
    float depth;
};

ProjectedPosition project_position(const float3 world_position) {
    float3 const camera_position = float3(3.4, -4.2, 3.1);
    float3 const camera_forward = normalize(-camera_position);
    float3 const camera_right = normalize(cross(camera_forward, float3(0.0, 0.0, 1.0)));
    float3 const camera_up = cross(camera_right, camera_forward);
    float3 const camera_delta = world_position - camera_position;
    float const view_depth = max(dot(camera_delta, camera_forward), 0.001);
    float const tan_half_fov = 0.62;
    float2 const ndc = float2(dot(camera_delta, camera_right), dot(camera_delta, camera_up)) /
                       (view_depth * tan_half_fov);

    ProjectedPosition result;
    result.pixel = float2(0.5 + ndc.x * 0.5, 0.5 - ndc.y * 0.5) * float2(OutputSize);
    result.depth = 1.0 - saturate((view_depth - 2.0) / 7.0);
    return result;
}

float2 quad_corner(const uint vertex_id) {
    float2 corner = 0.0;
    corner.x = vertex_id == 1 || vertex_id == 2 || vertex_id == 4 ? 1.0 : 0.0;
    corner.y = vertex_id == 2 || vertex_id == 4 || vertex_id == 5 ? 1.0 : 0.0;
    return corner;
}

float4 pixel_to_clip(const float2 pixel_position, const float depth) {
    float2 const clip_position =
        pixel_position / float2(OutputSize) * float2(2.0, -2.0) + float2(-1.0, 1.0);
    return float4(clip_position, depth, 1.0);
}

void scatter_background_vs(const uint vertex_id : SV_VertexID,
                           out float4 position : SV_Position) {
    position = pixel_to_clip(quad_corner(vertex_id) * float2(OutputSize), 1.0);
}

float4 scatter_background_ps(const float4 position : SV_Position) : SV_Target0 {
    float2 const normalized_pixel = position.xy / float2(OutputSize);
    float const vignette = saturate(1.0 - length(normalized_pixel - 0.5) * 0.7);
    return float4(float3(0.006, 0.010, 0.019) * vignette, 1.0);
}

void frame_segment(const uint instance_id,
                   out float3 world_start,
                   out float3 world_end,
                   out float4 color,
                   out float thickness) {
    world_start = 0.0;
    world_end = 0.0;
    color = float4(0.24, 0.31, 0.40, 0.72);
    thickness = 0.75;

    if (instance_id < 12) {
        uint const edge = instance_id % 4;
        float const layer = instance_id < 4 ? -1.0 : 1.0;
        if (instance_id < 8) {
            float2 const corners[4] = {
                float2(-1.0, -1.0), float2(1.0, -1.0),
                float2(1.0, 1.0), float2(-1.0, 1.0),
            };
            world_start = float3(corners[edge], layer);
            world_end = float3(corners[(edge + 1) % 4], layer);
        } else {
            float2 const corners[4] = {
                float2(-1.0, -1.0), float2(1.0, -1.0),
                float2(1.0, 1.0), float2(-1.0, 1.0),
            };
            world_start = float3(corners[edge], -1.0);
            world_end = float3(corners[edge], 1.0);
        }
        return;
    }

    if (instance_id < 30) {
        uint const grid_index = instance_id - 12;
        float const offset = -0.8 + float(grid_index % 9) * 0.2;
        if (grid_index < 9) {
            world_start = float3(-1.0, offset, -1.0);
            world_end = float3(1.0, offset, -1.0);
        } else {
            world_start = float3(offset, -1.0, -1.0);
            world_end = float3(offset, 1.0, -1.0);
        }
        color = float4(0.15, 0.22, 0.30, 0.50);
        thickness = 0.55;
        return;
    }

    world_start = float3(0.0, 0.0, 0.0);
    thickness = 1.35;
    if (instance_id == 30) {
        world_end = float3(1.15, 0.0, 0.0);
        color = float4(1.0, 0.20, 0.16, 0.95);
    } else if (instance_id == 31) {
        world_end = float3(0.0, 1.15, 0.0);
        color = float4(0.22, 1.0, 0.32, 0.95);
    } else {
        world_end = float3(0.0, 0.0, 1.15);
        color = float4(0.22, 0.52, 1.0, 0.95);
    }
}

struct LineVertexOutput {
    float4 position : SV_Position;
    nointerpolation float2 line_start : SCATTER_LINE_START;
    nointerpolation float2 line_end : SCATTER_LINE_END;
    nointerpolation float4 color : SCATTER_LINE_COLOR;
    nointerpolation float thickness : SCATTER_LINE_THICKNESS;
};

LineVertexOutput scatter_frame_vs(const uint vertex_id : SV_VertexID,
                                  const uint instance_id : SV_InstanceID) {
    float3 world_start;
    float3 world_end;
    float4 color;
    float thickness;
    frame_segment(instance_id, world_start, world_end, color, thickness);

    ProjectedPosition const projected_start = project_position(world_start);
    ProjectedPosition const projected_end = project_position(world_end);
    float2 const segment = projected_end.pixel - projected_start.pixel;
    float2 const direction = segment / max(length(segment), 0.0001);
    float2 const normal = float2(-direction.y, direction.x);
    float2 const corner = quad_corner(vertex_id);
    float const extent = thickness + 1.0;
    float2 const pixel_position = lerp(projected_start.pixel, projected_end.pixel, corner.x) +
                                  direction * ((corner.x * 2.0 - 1.0) * extent) +
                                  normal * ((corner.y * 2.0 - 1.0) * extent);

    LineVertexOutput output;
    output.position = pixel_to_clip(pixel_position,
                                    lerp(projected_start.depth, projected_end.depth, corner.x));
    output.line_start = projected_start.pixel;
    output.line_end = projected_end.pixel;
    output.color = color;
    output.thickness = thickness;
    return output;
}

float distance_to_segment(const float2 sample_position, const float2 start, const float2 end) {
    float2 const segment = end - start;
    float const segment_length_squared = max(dot(segment, segment), 0.0001);
    float const t = saturate(dot(sample_position - start, segment) / segment_length_squared);
    return length(sample_position - (start + t * segment));
}

float4 scatter_frame_ps(LineVertexOutput input) : SV_Target0 {
    float const distance = distance_to_segment(input.position.xy, input.line_start, input.line_end);
    float const coverage = 1.0 - smoothstep(input.thickness, input.thickness + 1.0, distance);
    float const alpha = coverage * input.color.a;
    clip(alpha - 0.0001);
    return float4(input.color.rgb, alpha);
}

struct SampleVertexOutput {
    float4 position : SV_Position;
    float2 local_position : SCATTER_SAMPLE_LOCAL_POSITION;
    nointerpolation float size : SCATTER_SAMPLE_SIZE;
    nointerpolation float4 color : SCATTER_SAMPLE_COLOR;
};

SampleVertexOutput scatter_sample_vs(const uint vertex_id : SV_VertexID,
                                     const uint instance_id : SV_InstanceID) {
    ScatterSample const scatter_sample = Samples[instance_id];
    ProjectedPosition const projected = project_position(scatter_sample.position);
    float2 const corner = quad_corner(vertex_id);
    float const extent = scatter_sample.size + 1.25;

    SampleVertexOutput output;
    output.local_position = (corner * 2.0 - 1.0) * extent;
    output.position = pixel_to_clip(projected.pixel + output.local_position, projected.depth);
    output.size = scatter_sample.size;
    output.color = scatter_sample.color;
    return output;
}

float4 scatter_sample_ps(SampleVertexOutput input) : SV_Target0 {
    float const sample_distance = length(input.local_position);
    float const coverage = 1.0 - smoothstep(input.size, input.size + 1.0, sample_distance);
    float const core = 1.0 - smoothstep(max(input.size - 0.8, 0.0), input.size, sample_distance);
    float const alpha = coverage * input.color.a;
    clip(alpha - 0.0001);
    float3 const color = lerp(input.color.rgb, float3(1.0, 1.0, 1.0), core * 0.18);
    return float4(color, alpha);
}
