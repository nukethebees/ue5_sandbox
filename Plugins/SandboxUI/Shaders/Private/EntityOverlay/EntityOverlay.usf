#include "/Engine/Public/Platform.ush"

struct EntityOverlayInstance {
    float3 world_position;
    float health;
    float world_radius;
    uint display_data;
};

StructuredBuffer<EntityOverlayInstance> Instances;
float4x4 ViewProjection;
float3 CameraOrigin;
int2 OutputSize;
int4 ViewRect;
float2 BarSizePixels;
float2 ScreenOffsetPixels;
float MinimumWorldRadius;
float MaximumWorldRadius;
float MinimumBarScale;
float MaximumBarScale;
float ObjectiveBarHeightScale;
float InsetPixels;
float MaximumInsetHeightRatio;
float ObjectiveFramePixels;
float ScreenEdgePaddingPixels;
float SoftTargetRadiusPixels;
float SoftTargetOuterBracketGapPixels;
float SoftTargetInnerBracketGapPixels;
float SoftTargetRangeProgress;
float SoftTargetPulse;
float SoftTargetNeutralOpacity;
float SoftTargetApproachingOpacity;
float SoftTargetInRangeOpacity;
float SoftTargetGlowOpacity;
float SoftTargetPulseOpacityBoost;
float TimeSeconds;
float4 BackgroundColor;
float4 FillColor;
float4 DefendObjectiveColor;
float4 DestroyObjectiveColor;
float4 SoftTargetNeutralColor;
float4 SoftTargetInRangeColor;

static uint const ObjectiveRoleMask = 0x3;
static uint const HasFillColorMask = 1 << 2;
static uint const SoftTargetMask = 1 << 3;
static uint const FillColorRedShift = 8;
static uint const FillColorGreenShift = 16;
static uint const FillColorBlueShift = 24;
static uint const ObjectiveRoleNone = 0;
static uint const ObjectiveRoleDefend = 1;
static uint const ObjectiveRoleDestroy = 2;
static uint const EdgeNone = 0;
static uint const EdgeLeft = 1;
static uint const EdgeRight = 2;
static uint const EdgeTop = 3;
static uint const EdgeBottom = 4;

static uint const GlyphSpace = 0;
static uint const GlyphA = 1;
static uint const GlyphC = 2;
static uint const GlyphD = 3;
static uint const GlyphE = 4;
static uint const GlyphF = 5;
static uint const GlyphG = 6;
static uint const GlyphK = 7;
static uint const GlyphN = 8;
static uint const GlyphR = 9;
static uint const GlyphT = 10;

float2 quad_corner(uint const vertex_id) {
    float2 corner = 0.0;
    corner.x = vertex_id == 1 || vertex_id == 2 || vertex_id == 4 ? 1.0 : 0.0;
    corner.y = vertex_id == 2 || vertex_id == 4 || vertex_id == 5 ? 1.0 : 0.0;
    return corner;
}

float4 pixel_to_clip(float2 const pixel_position, float const depth) {
    float2 const clip_position =
        pixel_position / float2(OutputSize) * float2(2.0, -2.0) + float2(-1.0, 1.0);
    return float4(clip_position, depth, 1.0);
}

bool inside_chamfered_box(float2 const position, float2 const half_size, float const chamfer) {
    float2 const absolute_position = abs(position);
    return all(absolute_position <= half_size) && absolute_position.x + absolute_position.y <=
                                                      half_size.x + half_size.y - max(chamfer, 0.0);
}

bool inside_hex(float2 const position, float2 const half_size) {
    float2 const absolute_position = abs(position);
    float const safe_height = max(half_size.y, 0.001);
    float const horizontal_limit = half_size.x * (1.0 - 0.35 * absolute_position.y / safe_height);
    return absolute_position.y <= half_size.y && absolute_position.x <= horizontal_limit;
}

float objective_badge_size(float2 const bar_size, float const frame_pixels) {
    float const framed_bar_height = bar_size.y + frame_pixels * 2.0;
    return max(framed_bar_height * 1.5, 24.0);
}

float objective_end_cap_size(float2 const bar_size, float const frame_pixels) {
    return objective_badge_size(bar_size, frame_pixels) * 0.5;
}

void objective_layout(float2 const bar_size,
                      float const frame_pixels,
                      float2 const label_size,
                      out float2 content_min,
                      out float2 content_max,
                      out float2 icon_center,
                      out float2 end_cap_center,
                      out float2 label_center) {
    float2 const bar_half_size = bar_size * 0.5;
    float const icon_size = objective_badge_size(bar_size, frame_pixels);
    float const end_cap_size = objective_end_cap_size(bar_size, frame_pixels);
    icon_center = float2(-bar_half_size.x - icon_size * 0.5 + frame_pixels * 1.25, 0.0);
    end_cap_center =
        float2(bar_half_size.x + frame_pixels + end_cap_size * 0.5 - frame_pixels * 0.5, 0.0);
    float const label_gap = max(frame_pixels * 0.4, 0.5);
    float const label_left = -bar_half_size.x + frame_pixels;
    label_center = float2(label_left + label_size.x * 0.5,
                          -bar_half_size.y - frame_pixels - label_gap - label_size.y * 0.5);

    float const plaque_left_accent = max(frame_pixels * 4.0, 8.0);
    float const plaque_right_accent = max(frame_pixels * 2.0, 4.0);
    content_min = float2(min(icon_center.x - icon_size * 0.5,
                             label_center.x - label_size.x * 0.5 - plaque_left_accent),
                         min(label_center.y - label_size.y * 0.5, icon_center.y - icon_size * 0.5));
    content_max = float2(max(end_cap_center.x + end_cap_size * 0.5,
                             label_center.x + label_size.x * 0.5 + plaque_right_accent),
                         max(bar_half_size.y + frame_pixels, icon_center.y + icon_size * 0.5));
}

struct EntityOverlayVertexOutput {
    float4 position                                  : SV_Position;
    float2 local_uv                                  : ENTITY_OVERLAY_UV;
    nointerpolation float health                     : ENTITY_OVERLAY_HEALTH;
    nointerpolation float visible                    : ENTITY_OVERLAY_VISIBLE;
    nointerpolation float2 bar_size_pixels           : ENTITY_OVERLAY_BAR_SIZE;
    nointerpolation float2 draw_size_pixels          : ENTITY_OVERLAY_DRAW_SIZE;
    nointerpolation float2 draw_min_pixels           : ENTITY_OVERLAY_DRAW_MIN;
    nointerpolation float2 label_size_pixels         : ENTITY_OVERLAY_LABEL_SIZE;
    nointerpolation uint display_data                : ENTITY_OVERLAY_DISPLAY_DATA;
    nointerpolation uint edge                        : ENTITY_OVERLAY_EDGE;
    nointerpolation float2 soft_target_center_pixels : ENTITY_OVERLAY_TARGET_CENTER;
    nointerpolation float soft_target_range_progress : ENTITY_OVERLAY_TARGET_RANGE;
    nointerpolation float soft_target_radius_pixels  : ENTITY_OVERLAY_TARGET_RADIUS;
    nointerpolation float soft_target_pulse          : ENTITY_OVERLAY_TARGET_PULSE;
};

EntityOverlayVertexOutput entity_overlay_vs(uint const vertex_id : SV_VertexID,
                                            uint const instance_id : SV_InstanceID) {
    EntityOverlayInstance const instance = Instances[instance_id];
    float4 const projected =
        mul(float4(instance.world_position - CameraOrigin, 1.0), ViewProjection);
    float2 const ndc = projected.xy / max(abs(projected.w), 0.000001);
    bool const on_screen = projected.w > 0.000001 && all(ndc >= -1.0) && all(ndc <= 1.0);
    uint const objective_role = instance.display_data & ObjectiveRoleMask;
    bool const is_objective = objective_role != ObjectiveRoleNone;
    bool const is_soft_target = (instance.display_data & SoftTargetMask) != 0;
    bool const visible = on_screen || is_objective;

    float2 const view_min = float2(ViewRect.xy);
    float2 const view_size = float2(ViewRect.zw - ViewRect.xy);
    float2 const projected_pixel =
        view_min + float2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5) * view_size;
    float2 const corner = quad_corner(vertex_id);
    float const radius_range = max(MaximumWorldRadius - MinimumWorldRadius, 0.001);
    float const radius_alpha =
        saturate((instance.world_radius - MinimumWorldRadius) / radius_range);
    float const bar_scale = lerp(MinimumBarScale, MaximumBarScale, radius_alpha);
    float2 const normal_bar_size = BarSizePixels * bar_scale;
    float2 const instance_bar_size =
        normal_bar_size * float2(1.0, is_objective ? ObjectiveBarHeightScale : 1.0);
    float const frame_pixels = is_objective ? max(ObjectiveFramePixels, 0.0) : 0.0;
    float2 const label_size = is_objective
                                ? float2(clamp(instance_bar_size.x * 0.82, 104.0, 220.0),
                                         clamp(instance_bar_size.y * 0.95 + 6.0, 15.0, 28.0))
                                : 0.0;
    float2 content_min = -instance_bar_size * 0.5;
    float2 content_max = instance_bar_size * 0.5;
    float2 unused_icon_center;
    float2 unused_end_cap_center;
    float2 unused_label_center;
    if (is_objective) {
        objective_layout(instance_bar_size,
                         frame_pixels,
                         label_size,
                         content_min,
                         content_max,
                         unused_icon_center,
                         unused_end_cap_center,
                         unused_label_center);
    }

    bool const edge_marker = is_objective && !on_screen;
    float const cue_pixels = edge_marker ? max(instance_bar_size.y, 1.0) : 0.0;
    float2 draw_min = content_min - cue_pixels;
    float2 draw_max = content_max + cue_pixels;
    float2 const soft_target_center = -ScreenOffsetPixels + float2(0.0, 0.5 * normal_bar_size.y);
    if (is_soft_target) {
        float const soft_target_extent =
            SoftTargetRadiusPixels + SoftTargetOuterBracketGapPixels + 18.0;
        draw_min = min(draw_min, soft_target_center - soft_target_extent);
        draw_max = max(draw_max, soft_target_center + soft_target_extent);
    }
    float2 const draw_size = draw_max - draw_min;
    float2 marker_center =
        projected_pixel + ScreenOffsetPixels + float2(0.0, -0.5 * normal_bar_size.y);
    uint edge = EdgeNone;

    if (edge_marker) {
        float2 screen_direction = float2(ndc.x * view_size.x, -ndc.y * view_size.y);
        if (dot(screen_direction, screen_direction) < 0.000001) {
            screen_direction = float2(0.0, 1.0);
        }

        float2 const view_center = view_min + view_size * 0.5;
        float2 const lower_marker_limit = view_min + ScreenEdgePaddingPixels - draw_min;
        float2 const upper_marker_limit = view_min + view_size - ScreenEdgePaddingPixels - draw_max;
        float2 const negative_available = max(view_center - lower_marker_limit, 0.0);
        float2 const positive_available = max(upper_marker_limit - view_center, 0.0);
        float2 const available =
            float2(screen_direction.x < 0.0 ? negative_available.x : positive_available.x,
                   screen_direction.y < 0.0 ? negative_available.y : positive_available.y);
        float2 const absolute_direction = max(abs(screen_direction), 0.000001);
        float2 const edge_scales = available / absolute_direction;
        float const edge_scale = min(edge_scales.x, edge_scales.y);
        marker_center = view_center + screen_direction * edge_scale;

        if (edge_scales.x < edge_scales.y) {
            edge = screen_direction.x < 0.0 ? EdgeLeft : EdgeRight;
        } else {
            edge = screen_direction.y < 0.0 ? EdgeTop : EdgeBottom;
        }
    }

    float2 pixel_position = marker_center + draw_min + corner * draw_size;
    if (!visible) {
        pixel_position = float2(-draw_size.x * 2.0, -draw_size.y * 2.0);
    }

    EntityOverlayVertexOutput output;
    output.position =
        pixel_to_clip(pixel_position, saturate(projected.z / max(projected.w, 0.000001)));
    output.local_uv = corner;
    output.health = saturate(instance.health);
    output.visible = visible ? 1.0 : 0.0;
    output.bar_size_pixels = instance_bar_size;
    output.draw_size_pixels = draw_size;
    output.draw_min_pixels = draw_min;
    output.label_size_pixels = label_size;
    output.display_data = instance.display_data;
    output.edge = edge;
    output.soft_target_center_pixels = soft_target_center;
    output.soft_target_range_progress = SoftTargetRangeProgress;
    output.soft_target_radius_pixels = SoftTargetRadiusPixels;
    output.soft_target_pulse = SoftTargetPulse;
    return output;
}

float4 instance_fill_color(uint const display_data) {
    if ((display_data & HasFillColorMask) == 0) {
        return FillColor;
    }

    float3 const color = float3((display_data >> FillColorRedShift) & 0xff,
                                (display_data >> FillColorGreenShift) & 0xff,
                                (display_data >> FillColorBlueShift) & 0xff) /
                         255.0;
    return float4(color, 1.0);
}

float4 metallic_gold(float2 const position, float2 const bounds_min, float2 const bounds_max) {
    float2 const size = max(bounds_max - bounds_min, 1.0);
    float2 const uv = saturate((position - bounds_min) / size);
    float3 const gold = DefendObjectiveColor.rgb;
    float const vertical_gloss = lerp(1.08, 0.62, uv.y);
    float const highlight_band = smoothstep(0.16, 0.0, abs(uv.y - 0.18));
    float const lower_reflection = smoothstep(0.12, 0.0, abs(uv.y - 0.78));
    float const sweep_position = frac(TimeSeconds * 0.18) * 1.6 - 0.3;
    float const sweep_distance = abs((uv.x + uv.y * 0.18) - sweep_position);
    float const sweep = 0.08 * smoothstep(0.10, 0.0, sweep_distance);
    float3 color = gold * vertical_gloss;
    color = lerp(color, float3(1.0, 0.91, 0.52), 0.34 * highlight_band);
    color = lerp(color, float3(0.86, 0.52, 0.08), 0.18 * lower_reflection);
    color = lerp(color, 1.0, sweep);
    return float4(color, DefendObjectiveColor.a);
}

bool inside_edge_cue(float2 const local_position,
                     float2 const content_min,
                     float2 const content_max,
                     float const cue_length,
                     uint const edge) {
    if (edge == EdgeNone) {
        return false;
    }

    float2 outward = 0.0;
    float edge_position = 0.0;
    float half_width = 0.0;
    if (edge == EdgeLeft) {
        outward = float2(-1.0, 0.0);
        edge_position = -content_min.x;
        half_width = max((content_max.y - content_min.y) * 0.12, 2.0);
    } else if (edge == EdgeRight) {
        outward = float2(1.0, 0.0);
        edge_position = content_max.x;
        half_width = max((content_max.y - content_min.y) * 0.12, 2.0);
    } else if (edge == EdgeTop) {
        outward = float2(0.0, -1.0);
        edge_position = -content_min.y;
        half_width = max((content_max.x - content_min.x) * 0.06, 2.0);
    } else {
        outward = float2(0.0, 1.0);
        edge_position = content_max.y;
        half_width = max((content_max.x - content_min.x) * 0.06, 2.0);
    }

    float2 const tangent = float2(-outward.y, outward.x);
    float const along = dot(local_position, outward) - edge_position;
    float const across = abs(dot(local_position, tangent));
    return along >= 0.0 && along <= cue_length &&
           across <= half_width * (1.0 - along / max(cue_length, 0.001));
}

uint label_glyph(uint const role, uint const index) {
    if (role == ObjectiveRoleDefend) {
        if (index == 0 || index == 5) return GlyphD;
        if (index == 1 || index == 3 || index == 11) return GlyphE;
        if (index == 2) return GlyphF;
        if (index == 4) return GlyphN;
        if (index == 6) return GlyphSpace;
        if (index == 7 || index == 12) return GlyphT;
        if (index == 8) return GlyphA;
        if (index == 9) return GlyphR;
        return GlyphG;
    }

    if (index == 0 || index == 3 || index == 8) return GlyphA;
    if (index == 1 || index == 2 || index == 7 || index == 12) return GlyphT;
    if (index == 4) return GlyphC;
    if (index == 5) return GlyphK;
    if (index == 6) return GlyphSpace;
    if (index == 9) return GlyphR;
    if (index == 10) return GlyphG;
    return GlyphE;
}

float distance_to_segment(float2 const position, float2 const start, float2 const end) {
    float2 const offset = position - start;
    float2 const segment = end - start;
    float const alpha = saturate(dot(offset, segment) / max(dot(segment, segment), 0.0001));
    return length(offset - segment * alpha);
}

float ellipse_distance(float2 const position, float2 const radii) {
    return (length(position / max(radii, 0.001)) - 1.0) * min(radii.x, radii.y);
}

float rotated_ellipse_distance(float2 const position,
                               float2 const center,
                               float2 const radii,
                               float const radians) {
    float sine;
    float cosine;
    sincos(radians, sine, cosine);
    float2 const offset = position - center;
    float2 const rotated =
        float2(cosine * offset.x - sine * offset.y, sine * offset.x + cosine * offset.y);
    return ellipse_distance(rotated, radii);
}

float shape_coverage(float const signed_distance) {
    float const antialias_width = max(fwidth(signed_distance), 0.012);
    return 1.0 - smoothstep(-antialias_width, antialias_width, signed_distance);
}

float bee_distance(float2 const position) {
    float distance = ellipse_distance(position - float2(0.0, -0.32), float2(0.14, 0.14));
    distance = min(distance, ellipse_distance(position - float2(0.0, -0.07), float2(0.17, 0.22)));
    distance = min(distance, ellipse_distance(position - float2(0.0, 0.24), float2(0.18, 0.30)));

    float const left_wing =
        abs(rotated_ellipse_distance(position, float2(-0.29, -0.05), float2(0.26, 0.13), -0.48)) -
        0.035;
    float const right_wing =
        abs(rotated_ellipse_distance(position, float2(0.29, -0.05), float2(0.26, 0.13), 0.48)) -
        0.035;
    distance = min(distance, min(left_wing, right_wing));

    distance =
        min(distance,
            distance_to_segment(position, float2(-0.07, -0.43), float2(-0.23, -0.65)) - 0.025);
    distance = min(distance,
                   distance_to_segment(position, float2(0.07, -0.43), float2(0.23, -0.65)) - 0.025);
    distance = min(
        distance, distance_to_segment(position, float2(-0.13, -0.02), float2(-0.37, 0.11)) - 0.022);
    distance = min(distance,
                   distance_to_segment(position, float2(0.13, -0.02), float2(0.37, 0.11)) - 0.022);
    distance = min(distance,
                   distance_to_segment(position, float2(-0.13, 0.16), float2(-0.34, 0.34)) - 0.022);
    distance = min(distance,
                   distance_to_segment(position, float2(0.13, 0.16), float2(0.34, 0.34)) - 0.022);
    distance =
        min(distance, distance_to_segment(position, float2(0.0, 0.49), float2(0.0, 0.66)) - 0.03);
    return distance;
}

float bee_stripe_coverage(float2 const position) {
    float const abdomen = ellipse_distance(position - float2(0.0, 0.24), float2(0.18, 0.30));
    float const stripes = min(abs(position.y - 0.16), abs(position.y - 0.32)) - 0.035;
    return shape_coverage(max(abdomen, stripes));
}

float defend_bee_cue_distance(float2 const position) {
    float distance =
        distance_to_segment(position, float2(-0.53, -0.50), float2(0.53, -0.50)) - 0.018;
    distance = min(distance,
                   distance_to_segment(position, float2(0.53, -0.50), float2(0.47, 0.24)) - 0.018);
    distance =
        min(distance, distance_to_segment(position, float2(0.47, 0.24), float2(0.0, 0.72)) - 0.018);
    distance = min(distance,
                   distance_to_segment(position, float2(0.0, 0.72), float2(-0.47, 0.24)) - 0.018);
    distance = min(
        distance, distance_to_segment(position, float2(-0.47, 0.24), float2(-0.53, -0.50)) - 0.018);
    return distance;
}

float attack_bee_cue_distance(float2 const position) {
    float distance = distance_to_segment(position, float2(-0.72, 0.0), float2(-0.56, 0.0)) - 0.026;
    distance =
        min(distance, distance_to_segment(position, float2(0.56, 0.0), float2(0.72, 0.0)) - 0.026);
    distance = min(distance,
                   distance_to_segment(position, float2(0.0, -0.72), float2(0.0, -0.56)) - 0.026);
    distance =
        min(distance, distance_to_segment(position, float2(0.0, 0.56), float2(0.0, 0.78)) - 0.026);
    return distance;
}

bool inside_plaque_accents(float2 const position,
                           float2 const plaque_center,
                           float2 const plaque_half_size,
                           float const frame_pixels) {
    float const left = plaque_center.x - plaque_half_size.x;
    float const right = plaque_center.x + plaque_half_size.x;
    float const half_line = max(frame_pixels * 0.22, 0.55);
    bool const left_upper =
        position.x >= left - frame_pixels * 2.6 && position.x <= left - frame_pixels * 0.5 &&
        abs(position.y - (plaque_center.y - plaque_half_size.y * 0.36)) <= half_line;
    bool const left_middle = position.x >= left - frame_pixels * 4.0 &&
                             position.x <= left - frame_pixels * 0.5 &&
                             abs(position.y - plaque_center.y) <= half_line;
    bool const left_lower =
        position.x >= left - frame_pixels * 2.0 && position.x <= left - frame_pixels * 0.5 &&
        abs(position.y - (plaque_center.y + plaque_half_size.y * 0.36)) <= half_line;
    bool const right_upper =
        position.x >= right + frame_pixels * 0.5 && position.x <= right + frame_pixels * 1.8 &&
        abs(position.y - (plaque_center.y - plaque_half_size.y * 0.24)) <= half_line;
    bool const right_lower =
        position.x >= right + frame_pixels * 0.5 && position.x <= right + frame_pixels * 1.2 &&
        abs(position.y - (plaque_center.y + plaque_half_size.y * 0.28)) <= half_line;
    return left_upper || left_middle || left_lower || right_upper || right_lower;
}

float glyph_distance(uint const glyph, float2 const position) {
    float distance = 100.0;
    if (glyph == GlyphA) {
        distance =
            min(distance, distance_to_segment(position, float2(0.06, 0.92), float2(0.29, 0.08)));
        distance =
            min(distance, distance_to_segment(position, float2(0.29, 0.08), float2(0.52, 0.92)));
        distance =
            min(distance, distance_to_segment(position, float2(0.16, 0.58), float2(0.42, 0.58)));
    } else if (glyph == GlyphC) {
        distance =
            min(distance, distance_to_segment(position, float2(0.50, 0.12), float2(0.18, 0.12)));
        distance =
            min(distance, distance_to_segment(position, float2(0.18, 0.12), float2(0.07, 0.26)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.26), float2(0.07, 0.74)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.74), float2(0.18, 0.88)));
        distance =
            min(distance, distance_to_segment(position, float2(0.18, 0.88), float2(0.50, 0.88)));
    } else if (glyph == GlyphD) {
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.07, 0.90)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.36, 0.10)));
        distance =
            min(distance, distance_to_segment(position, float2(0.36, 0.10), float2(0.51, 0.27)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.27), float2(0.51, 0.73)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.73), float2(0.36, 0.90)));
        distance =
            min(distance, distance_to_segment(position, float2(0.36, 0.90), float2(0.07, 0.90)));
    } else if (glyph == GlyphE || glyph == GlyphF) {
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.07, 0.90)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.52, 0.10)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.50), float2(0.44, 0.50)));
        if (glyph == GlyphE) {
            distance = min(distance,
                           distance_to_segment(position, float2(0.07, 0.90), float2(0.52, 0.90)));
        }
    } else if (glyph == GlyphG) {
        distance =
            min(distance, distance_to_segment(position, float2(0.50, 0.12), float2(0.18, 0.12)));
        distance =
            min(distance, distance_to_segment(position, float2(0.18, 0.12), float2(0.07, 0.26)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.26), float2(0.07, 0.74)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.74), float2(0.18, 0.88)));
        distance =
            min(distance, distance_to_segment(position, float2(0.18, 0.88), float2(0.51, 0.88)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.88), float2(0.51, 0.54)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.54), float2(0.32, 0.54)));
    } else if (glyph == GlyphK) {
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.07, 0.90)));
        distance =
            min(distance, distance_to_segment(position, float2(0.50, 0.10), float2(0.07, 0.53)));
        distance =
            min(distance, distance_to_segment(position, float2(0.23, 0.39), float2(0.52, 0.90)));
    } else if (glyph == GlyphN) {
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.90), float2(0.07, 0.10)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.51, 0.90)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.90), float2(0.51, 0.10)));
    } else if (glyph == GlyphR) {
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.07, 0.90)));
        distance =
            min(distance, distance_to_segment(position, float2(0.07, 0.10), float2(0.38, 0.10)));
        distance =
            min(distance, distance_to_segment(position, float2(0.38, 0.10), float2(0.51, 0.23)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.23), float2(0.51, 0.39)));
        distance =
            min(distance, distance_to_segment(position, float2(0.51, 0.39), float2(0.38, 0.51)));
        distance =
            min(distance, distance_to_segment(position, float2(0.38, 0.51), float2(0.07, 0.51)));
        distance =
            min(distance, distance_to_segment(position, float2(0.31, 0.51), float2(0.53, 0.90)));
    } else if (glyph == GlyphT) {
        distance =
            min(distance, distance_to_segment(position, float2(0.04, 0.10), float2(0.54, 0.10)));
        distance =
            min(distance, distance_to_segment(position, float2(0.29, 0.10), float2(0.29, 0.90)));
    }
    return distance;
}

float label_text_coverage(float2 const position,
                          float2 const label_center,
                          float2 const label_size,
                          uint const role) {
    float const font_height = min(label_size.y * 0.68, label_size.x / 9.0);
    float const advance = font_height * 0.68;
    float const text_width = font_height * 8.72;
    float2 const text_min = label_center + float2(-text_width * 0.5, -font_height * 0.5);
    float2 const text_position = position - text_min;
    if (any(text_position < 0.0) || text_position.x >= text_width ||
        text_position.y >= font_height) {
        return 0.0;
    }

    uint const character_index = min((uint)floor(text_position.x / advance), 12);
    float const character_x = text_position.x - character_index * advance;
    if (character_x > font_height * 0.58) {
        return 0.0;
    }

    float2 const glyph_position = float2(character_x, text_position.y) / font_height;
    float const distance_pixels =
        glyph_distance(label_glyph(role, character_index), glyph_position) * font_height;
    float const stroke_radius = max(font_height * 0.075, 0.8);
    float const antialias_width = max(fwidth(distance_pixels), 0.65);
    return 1.0 - smoothstep(stroke_radius - antialias_width,
                            stroke_radius + antialias_width,
                            distance_pixels);
}

bool soft_target_pixel(EntityOverlayVertexOutput input,
                       float2 const local_position,
                       out float4 output_color) {
    if ((input.display_data & SoftTargetMask) == 0) {
        output_color = 0.0;
        return false;
    }

    float2 const target_position = local_position - input.soft_target_center_pixels;
    float const range_progress = saturate(input.soft_target_range_progress);
    bool const in_range = range_progress >= 0.9999;
    float const radius = max(input.soft_target_radius_pixels, 1.0);
    float const gap =
        lerp(SoftTargetOuterBracketGapPixels, SoftTargetInnerBracketGapPixels, range_progress);
    float const bracket_corner = radius + gap;
    float const bracket_length = clamp(radius * 0.24, 8.0, 14.0);
    float const thickness = in_range ? 1.5 : lerp(0.9, 1.2, range_progress);

    float const ring_distance = abs(length(target_position) - radius) - thickness * 0.5;
    float2 const quadrant_position = abs(target_position);
    float const horizontal_bracket_distance =
        distance_to_segment(quadrant_position,
                            float2(bracket_corner - bracket_length, bracket_corner),
                            float2(bracket_corner, bracket_corner)) -
        thickness * 0.5;
    float const vertical_bracket_distance =
        distance_to_segment(quadrant_position,
                            float2(bracket_corner, bracket_corner - bracket_length),
                            float2(bracket_corner, bracket_corner)) -
        thickness * 0.5;
    float const shape_distance =
        min(ring_distance, min(horizontal_bracket_distance, vertical_bracket_distance));
    float const antialias_width = max(fwidth(shape_distance), 0.7);
    float const core_coverage = 1.0 - smoothstep(-antialias_width, antialias_width, shape_distance);

    float halo_coverage = 0.0;
    if (in_range) {
        float const halo_width = 2.0 + saturate(input.soft_target_pulse) * 1.5;
        halo_coverage =
            (1.0 - smoothstep(0.0, halo_width, max(shape_distance, 0.0))) * (1.0 - core_coverage);
    }

    float4 const base_color = in_range ? SoftTargetInRangeColor : SoftTargetNeutralColor;
    float const base_alpha =
        in_range ? SoftTargetInRangeOpacity
                 : lerp(SoftTargetNeutralOpacity, SoftTargetApproachingOpacity, range_progress);
    float const pulse_boost =
        in_range ? saturate(input.soft_target_pulse) * SoftTargetPulseOpacityBoost : 0.0;
    float const alpha = saturate(core_coverage * (base_alpha + pulse_boost) +
                                 halo_coverage * (SoftTargetGlowOpacity + pulse_boost * 0.3));
    output_color = float4(base_color.rgb, base_color.a * alpha);
    return alpha > 0.001;
}

float4 entity_overlay_ps(EntityOverlayVertexOutput input)
    : SV_Target0 {
    clip(input.visible - 0.5);

    float2 const local_position = input.draw_min_pixels + input.local_uv * input.draw_size_pixels;
    float2 const bar_half_size = input.bar_size_pixels * 0.5;
    uint const objective_role = input.display_data & ObjectiveRoleMask;
    bool const is_objective = objective_role != ObjectiveRoleNone;
    float const frame_pixels = is_objective ? max(ObjectiveFramePixels, 0.0) : 0.0;
    float4 const fill_color = instance_fill_color(input.display_data);

    if (!is_objective) {
        if (!all(abs(local_position) <= bar_half_size)) {
            float4 soft_target_color;
            if (soft_target_pixel(input, local_position, soft_target_color)) {
                return soft_target_color;
            }
            discard;
            return 0.0;
        }

        float const inset_height_ratio = InsetPixels * 2.0 / max(input.bar_size_pixels.y, 1.0);
        float const effective_inset =
            inset_height_ratio >= MaximumInsetHeightRatio ? 0.0 : InsetPixels;
        float2 const inset_uv = effective_inset / max(input.bar_size_pixels, 1.0);
        float2 const bar_uv = local_position / input.bar_size_pixels + 0.5;
        bool const inside = all(bar_uv >= inset_uv) && all(bar_uv <= 1.0 - inset_uv);
        bool const filled = inside && bar_uv.x <= lerp(inset_uv.x, 1.0 - inset_uv.x, input.health);
        return filled ? fill_color : BackgroundColor;
    }

    float2 content_min;
    float2 content_max;
    float2 icon_center;
    float2 end_cap_center;
    float2 label_center;
    objective_layout(input.bar_size_pixels,
                     frame_pixels,
                     input.label_size_pixels,
                     content_min,
                     content_max,
                     icon_center,
                     end_cap_center,
                     label_center);
    float const cue_length = max(input.bar_size_pixels.y, 1.0);
    if (inside_edge_cue(local_position, content_min, content_max, cue_length, input.edge)) {
        return metallic_gold(local_position, content_min - cue_length, content_max + cue_length);
    }

    float2 const label_half_size = input.label_size_pixels * 0.5;
    float const label_chamfer = max(frame_pixels * 1.4, 2.0);
    if (inside_plaque_accents(
            local_position, label_center, label_half_size, max(frame_pixels, 1.0))) {
        return metallic_gold(
            local_position, label_center - label_half_size, label_center + label_half_size);
    }

    if (inside_chamfered_box(local_position - label_center, label_half_size, label_chamfer)) {
        float2 const label_inner_half = max(label_half_size - max(frame_pixels * 0.7, 1.5), 0.0);
        bool const label_inner = inside_chamfered_box(
            local_position - label_center, label_inner_half, label_chamfer * 0.65);
        if (!label_inner) {
            return metallic_gold(
                local_position, label_center - label_half_size, label_center + label_half_size);
        }

        float4 const plaque_background =
            float4(lerp(BackgroundColor.rgb * 0.42, DefendObjectiveColor.rgb * 0.12, 0.18),
                   max(BackgroundColor.a, 0.94));
        float4 const label_gold = metallic_gold(
            local_position, label_center - label_half_size, label_center + label_half_size);
        float4 const text_color =
            float4(lerp(label_gold.rgb, float3(1.0, 0.94, 0.68), 0.62), label_gold.a);
        float const text_coverage = label_text_coverage(
            local_position, label_center, input.label_size_pixels, objective_role);
        return lerp(plaque_background, text_color, text_coverage);
    }

    float const icon_size = objective_badge_size(input.bar_size_pixels, frame_pixels);
    float2 const icon_half_size = icon_size * 0.5;
    float2 const icon_position = local_position - icon_center;
    if (inside_hex(icon_position, icon_half_size)) {
        float2 const icon_inner_half = max(icon_half_size - frame_pixels, 0.5);
        if (!inside_hex(icon_position, icon_inner_half)) {
            return metallic_gold(local_position, content_min, content_max);
        }

        float2 const normalized_icon_position = icon_position / max(icon_inner_half * 0.82, 0.5);
        float4 const badge_gold = metallic_gold(
            local_position, icon_center - icon_half_size, icon_center + icon_half_size);
        float const vertical_badge_alpha =
            saturate(icon_position.y / max(icon_inner_half.y, 0.001) * 0.5 + 0.5);
        float4 const badge_background = float4(lerp(BackgroundColor.rgb * 0.34,
                                                    DefendObjectiveColor.rgb * 0.11,
                                                    0.22 * (1.0 - vertical_badge_alpha)),
                                               max(BackgroundColor.a, 0.95));

        float const cue_distance = objective_role == ObjectiveRoleDefend
                                     ? defend_bee_cue_distance(normalized_icon_position)
                                     : attack_bee_cue_distance(normalized_icon_position);
        float const cue_coverage = shape_coverage(cue_distance) * 0.52;
        float const bee_coverage = shape_coverage(bee_distance(normalized_icon_position));
        float const stripe_coverage = bee_stripe_coverage(normalized_icon_position) * bee_coverage;
        float4 const cue_color = float4(badge_gold.rgb * 0.72, badge_gold.a);
        float4 const bee_color =
            float4(lerp(badge_gold.rgb, float3(1.0, 0.93, 0.58), 0.46), badge_gold.a);
        float4 emblem = lerp(badge_background, cue_color, cue_coverage);
        emblem = lerp(emblem, bee_color, bee_coverage);
        emblem = lerp(emblem, badge_background * float4(0.7, 0.7, 0.7, 1.0), stripe_coverage);
        return emblem;
    }

    float const end_cap_size = objective_end_cap_size(input.bar_size_pixels, frame_pixels);
    float2 const end_cap_half_size = end_cap_size * 0.5;
    float2 const end_cap_position = local_position - end_cap_center;
    if (inside_hex(end_cap_position, end_cap_half_size)) {
        float2 const end_cap_inner_half = max(end_cap_half_size - frame_pixels, 0.5);
        if (!inside_hex(end_cap_position, end_cap_inner_half)) {
            return metallic_gold(local_position, content_min, content_max);
        }

        float2 const detail_outer_half = end_cap_inner_half * 0.56;
        float2 const detail_inner_half =
            max(detail_outer_half - max(frame_pixels * 0.45, 0.75), 0.25);
        bool const detail = inside_hex(end_cap_position, detail_outer_half) &&
                            !inside_hex(end_cap_position, detail_inner_half);
        return detail ? metallic_gold(local_position, content_min, content_max)
                      : float4(BackgroundColor.rgb * 0.5, max(BackgroundColor.a, 0.9));
    }

    float2 const track_outer_half = bar_half_size + frame_pixels;
    float const track_chamfer = max(frame_pixels * 1.2, 1.0);
    if (inside_chamfered_box(local_position, track_outer_half, track_chamfer)) {
        if (!all(abs(local_position) <= bar_half_size)) {
            float4 gold = metallic_gold(local_position, -track_outer_half, track_outer_half);
            float const edge_band =
                abs(abs(local_position.y) - (bar_half_size.y + frame_pixels * 0.5));
            float const honey_detail =
                0.14 * smoothstep(1.0, 0.0, edge_band) *
                smoothstep(0.24, 0.48, abs(frac(local_position.x / 9.0) - 0.5));
            gold.rgb = lerp(gold.rgb, 1.0, honey_detail);
            return gold;
        }

        float const inner_keyline =
            min(max(frame_pixels * 0.32, 0.8), max(bar_half_size.y * 0.25, 0.0));
        float2 const content_half_size = max(bar_half_size - inner_keyline, 0.5);
        if (!all(abs(local_position) <= content_half_size)) {
            float4 const bevel_gold =
                metallic_gold(local_position, -track_outer_half, track_outer_half);
            return float4(bevel_gold.rgb * 0.42, max(bevel_gold.a, 0.94));
        }

        float2 const content_size = content_half_size * 2.0;
        float const inset_height_ratio = InsetPixels * 2.0 / max(content_size.y, 1.0);
        float const effective_inset =
            inset_height_ratio >= MaximumInsetHeightRatio ? 0.0 : InsetPixels;
        float2 const inset_uv = effective_inset / max(content_size, 1.0);
        float2 const bar_uv = local_position / content_size + 0.5;
        bool const inside = all(bar_uv >= inset_uv) && all(bar_uv <= 1.0 - inset_uv);
        bool const filled = inside && bar_uv.x <= lerp(inset_uv.x, 1.0 - inset_uv.x, input.health);
        return filled ? fill_color : BackgroundColor;
    }

    float4 soft_target_color;
    if (soft_target_pixel(input, local_position, soft_target_color)) {
        return soft_target_color;
    }
    discard;
    return 0.0;
}
