(widget-class ml::ioj::SGameOptionsView
  (function BuildPanel
    (params
      (value background)
      (value page_margin)
      (value window_width)
      (value window_height)
      (value chrome_style)
      (existing header)
      (existing body)
      (existing footer))
    (SBorder
      :BorderImage background
      :Padding page_margin
      :HAlign HAlign_Center
      :VAlign VAlign_Center
      (::ml::ioj::SHiveFrame
        :Style chrome_style
        :WidthOverride window_width
        :HeightOverride window_height
        (vbox
          (auto (existing header))
          (fill (existing body))
          (auto (existing footer)))))))
