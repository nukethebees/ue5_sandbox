(material M_SoftTargetWorld
  (asset "/SpaceGame/Generated/Materials/M_SoftTargetWorld")
  (domain surface)
  (blend translucent)
  (shading unlit)
  (two-sided true)
  (disable-depth-test true)
  (usage instanced-static-meshes)

  (parameter texture EnergyFilaments
    "/SpaceGame/UI/InGame/WorldMarkers/soft_target_filaments"
    :sampler linear-grayscale)
  (parameter texture EnergyFlow
    "/SpaceGame/UI/InGame/WorldMarkers/soft_target_flow"
    :sampler linear-color)
  (parameter scalar FarEmissive 0.03)
  (parameter scalar NearEmissive 0.65)
  (parameter scalar LockedEmissive 2.0)
  (parameter scalar FilamentEmissive 10.0)
  (parameter scalar PacketEmissive 48.0)
  (parameter scalar FlashEmissive 45.0)
  (parameter scalar FarOpacityScale 0.035)
  (parameter scalar NearOpacityScale 0.16)
  (parameter scalar LockedOpacityScale 0.38)
  (parameter scalar FilamentSpeed 0.22)
  (parameter scalar HotspotSpeed 0.32)
  (parameter scalar FlowSpeed 0.035)
  (parameter scalar FlowStrength 0.06)
  (parameter scalar SegmentGap 0.125)

  (let red (per-instance-custom-data 0))
  (let green (per-instance-custom-data 1))
  (let blue (per-instance-custom-data 2))
  (let opacity (per-instance-custom-data 3))
  (let pulse (per-instance-custom-data 4))
  (let range_alpha (per-instance-custom-data 5))
  (let uv (texcoord 0))
  (let game_time (time))

  (let range (saturate range_alpha))
  (let smooth_range (* (* range range) (- 3.0 (* 2.0 range))))
  (let buildup (* smooth_range smooth_range))
  (let locked
    (custom float
      ((Range float range))
      :description "Soft-target weapon-range lock"
      "return step(0.999, Range);\n"))
  (let base_energy (lerp FarEmissive NearEmissive buildup))
  (let body_energy (lerp base_energy LockedEmissive locked))
  (let filament_energy (* FilamentEmissive locked))
  (let packet_energy (* PacketEmissive locked))
  (let flash_alpha (* (saturate pulse) locked))
  (let flash_energy (* FlashEmissive flash_alpha))
  (let prelock_opacity_scale (lerp FarOpacityScale NearOpacityScale buildup))
  (let opacity_scale (lerp prelock_opacity_scale LockedOpacityScale locked))

  (emissive
    (custom float3
      ((Filaments texture EnergyFilaments)
       (Flow texture EnergyFlow)
       (UV float2 uv)
       (GameTime float game_time)
       (Red float red)
       (Green float green)
       (Blue float blue)
       (Locked float locked)
       (BodyEnergy float body_energy)
       (FilamentEnergy float filament_energy)
       (PacketEnergy float packet_energy)
       (FlashEnergy float flash_energy)
       (FilamentSpeed float FilamentSpeed)
       (HotspotSpeed float HotspotSpeed)
       (FlowSpeed float FlowSpeed)
       (FlowStrength float FlowStrength)
       (Gap float SegmentGap))
      :description "Segmented soft-target flowed-filament emissive"
      "float side_u = frac(UV.x * 6.0);\n"
      "float corner_distance = min(side_u, 1.0 - side_u);\n"
      "float segment = smoothstep(Gap * 0.5, Gap, corner_distance);\n"
      "float front_surface = step(0.099, UV.y) * step(UV.y, 0.901);\n"
      "float front_v = saturate((UV.y - 0.1) / 0.8);\n"
      "float ribbon_edge = min(front_v, 1.0 - front_v);\n"
      "float body = smoothstep(0.0, 0.12, ribbon_edge);\n"
      "float core = 1.0 - smoothstep(0.04, 0.30, abs(front_v - 0.5));\n"
      "float side_surface = 1.0 - front_surface;\n"
      "float surface_profile = front_surface * (0.35 * body + 0.65 * core);\n"
      "surface_profile += side_surface * 0.18;\n"
      "float2 flow_uv = float2(frac(UV.x * 1.5 + GameTime * FlowSpeed),\n"
      "                        frac(UV.y * 1.25 - GameTime * FlowSpeed * 0.6));\n"
      "float2 flow = Texture2DSample(Flow, FlowSampler, flow_uv).rg * 2.0 - 1.0;\n"
      "float2 filament_uv_a = float2(frac(UV.x * 3.0 + GameTime * FilamentSpeed),\n"
      "                                frac(UV.y * 1.5 + GameTime * FilamentSpeed * 0.12));\n"
      "filament_uv_a += flow * FlowStrength;\n"
      "float2 filament_uv_b = float2(frac(-UV.x * 2.0 + GameTime * FilamentSpeed * 0.55 + 0.37),\n"
      "                                frac(UV.y * 2.25 - GameTime * FilamentSpeed * 0.08 + 0.19));\n"
      "filament_uv_b -= flow * FlowStrength * 0.65;\n"
      "float filament_a = Texture2DSample(Filaments, FilamentsSampler, filament_uv_a).r;\n"
      "float filament_b = Texture2DSample(Filaments, FilamentsSampler, filament_uv_b).r;\n"
      "float ridge_a = 1.0 - smoothstep(0.08, 0.38, abs(filament_a - 0.5));\n"
      "float ridge_b = 1.0 - smoothstep(0.08, 0.38, abs(filament_b - 0.5));\n"
      "float filament = saturate(max(ridge_a, ridge_b * 0.85));\n"
      "float packet_distance_a = abs(frac(UV.x - GameTime * HotspotSpeed) - 0.5);\n"
      "float packet_distance_b = abs(frac(UV.x + GameTime * HotspotSpeed * 0.72 + 0.31) - 0.5);\n"
      "float packet_core_a = 1.0 - smoothstep(0.018, 0.055, packet_distance_a);\n"
      "float packet_halo_a = 1.0 - smoothstep(0.045, 0.115, packet_distance_a);\n"
      "float packet_core_b = 1.0 - smoothstep(0.014, 0.042, packet_distance_b);\n"
      "float packet_halo_b = 1.0 - smoothstep(0.035, 0.085, packet_distance_b);\n"
      "float packet_a = packet_core_a + packet_halo_a * 0.22;\n"
      "float packet_b = (packet_core_b + packet_halo_b * 0.18) * 0.72;\n"
      "float packet = max(packet_a, packet_b);\n"
      "float vein = filament * (0.38 + 0.62 * saturate(packet_halo_a + packet_halo_b));\n"
      "float3 instance_colour = max(float3(Red, Green, Blue), 0.0);\n"
      "float3 body_colour = lerp(instance_colour, float3(1.0, 0.42, 0.035), Locked);\n"
      "float heat = saturate(vein * 0.65 + packet);\n"
      "float3 filament_colour = lerp(float3(1.0, 0.20, 0.01),\n"
      "                               float3(1.0, 0.92, 0.55), heat);\n"
      "float3 body_signal = body_colour * BodyEnergy * surface_profile;\n"
      "float3 filament_signal = filament_colour * FilamentEnergy * vein * surface_profile;\n"
      "float3 packet_signal = filament_colour * PacketEnergy * packet * surface_profile;\n"
      "float3 flash_signal = filament_colour * FlashEnergy * surface_profile;\n"
      "return segment * (body_signal + filament_signal + packet_signal + flash_signal);\n"))
  (opacity
    (custom float
      ((UV float2 uv)
       (GameTime float game_time)
       (Locked float locked)
       (Opacity float opacity)
       (OpacityScale float opacity_scale)
       (PacketSpeed float HotspotSpeed)
       (Gap float SegmentGap))
      :description "Segmented soft-target range opacity"
      "float side_u = frac(UV.x * 6.0);\n"
      "float corner_distance = min(side_u, 1.0 - side_u);\n"
      "float segment = smoothstep(Gap * 0.5, Gap, corner_distance);\n"
      "float front_surface = step(0.099, UV.y) * step(UV.y, 0.901);\n"
      "float front_v = saturate((UV.y - 0.1) / 0.8);\n"
      "float ribbon_edge = min(front_v, 1.0 - front_v);\n"
      "float body = smoothstep(0.0, 0.12, ribbon_edge);\n"
      "float surface_profile = front_surface * body + (1.0 - front_surface) * 0.35;\n"
      "float packet_distance_a = abs(frac(UV.x - GameTime * PacketSpeed) - 0.5);\n"
      "float packet_distance_b = abs(frac(UV.x + GameTime * PacketSpeed * 0.72 + 0.31) - 0.5);\n"
      "float packet_a = 1.0 - smoothstep(0.045, 0.115, packet_distance_a);\n"
      "float packet_b = 1.0 - smoothstep(0.035, 0.085, packet_distance_b);\n"
      "float packet_opacity = Locked * max(packet_a, packet_b * 0.72) * 0.58;\n"
      "float animated_scale = OpacityScale + packet_opacity;\n"
      "return saturate(Opacity * animated_scale * segment * surface_profile);\n")))
