#include "/Engine/Public/Platform.ush"

struct FGpuSparkBurst {
    float4 LocationSpawnTime;
    float4 DirectionConeCosine;
    float4 ColourIntensity;
    float4 SpeedLifetimeRanges;
    float4 SizeStreakReserved;
    uint4 Allocation;
};

struct FSparkParticleRecord {
    float4 InitialPositionSpawnTime;
    float4 InitialVelocityLifetime;
    float4 EmissiveColourSize;
    float4 StreakTimeReserved;
};

StructuredBuffer<FGpuSparkBurst> SparkBursts;
StructuredBuffer<uint> SparkSelectionIndices;
RWStructuredBuffer<FSparkParticleRecord> SparkParticles;
uint SparkBurstCount;
uint SparkBurstGroupsX;
uint SparkParticleCapacity;

uint spark_hash(uint value) {
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

float spark_random(inout uint state) {
    state = spark_hash(state + 0x9e3779b9u);
    return float(state >> 8) * (1.0 / 16777216.0);
}

float spark_random_range(inout uint state, float2 range) {
    return lerp(min(range.x, range.y), max(range.x, range.y), spark_random(state));
}

float3 spark_sample_cone(float3 direction, float cone_cosine, inout uint state) {
    float const cosine = lerp(1.0, cone_cosine, spark_random(state));
    float const sine = sqrt(max(0.0, 1.0 - cosine * cosine));
    float const azimuth = 6.283185307179586 * spark_random(state);
    float sine_azimuth;
    float cosine_azimuth;
    sincos(azimuth, sine_azimuth, cosine_azimuth);
    float3 const helper = abs(direction.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);
    float3 const tangent = normalize(cross(helper, direction));
    float3 const bitangent = cross(direction, tangent);
    return direction * cosine + tangent * (sine * cosine_azimuth) +
           bitangent * (sine * sine_azimuth);
}

[numthreads(64, 1, 1)] void expand_spark_bursts_cs(uint3 group_id : SV_GroupID,
                                                   uint group_thread_id : SV_GroupThreadID) {
    uint const burst_index = group_id.x + group_id.y * SparkBurstGroupsX;
    if (burst_index >= SparkBurstCount || SparkParticleCapacity == 0) {
        return;
    }

    FGpuSparkBurst const burst = SparkBursts[burst_index];
    uint const seed = burst.Allocation.x;
    uint const first_particle = burst.Allocation.y;
    uint const particle_count = burst.Allocation.z;
    uint const selection_first = burst.Allocation.w;
    for (uint particle_index = group_thread_id; particle_index < particle_count;
         particle_index += 64) {
        uint const original_particle_index =
            selection_first == 0xffffffff ? particle_index
                                          : SparkSelectionIndices[selection_first + particle_index];
        uint state = spark_hash(seed ^ original_particle_index);
        float3 const direction =
            spark_sample_cone(burst.DirectionConeCosine.xyz, burst.DirectionConeCosine.w, state);
        float const speed = max(0.0, spark_random_range(state, burst.SpeedLifetimeRanges.xy));
        float const lifetime = max(0.0, spark_random_range(state, burst.SpeedLifetimeRanges.zw));
        float const size = max(0.0, spark_random_range(state, burst.SizeStreakReserved.xy));
        float const brightness_variation = lerp(0.85, 1.15, spark_random(state));
        float const intensity = max(0.0, burst.ColourIntensity.w) * brightness_variation;

        FSparkParticleRecord particle;
        particle.InitialPositionSpawnTime = burst.LocationSpawnTime;
        particle.InitialVelocityLifetime = float4(direction * speed, lifetime);
        particle.EmissiveColourSize = float4(burst.ColourIntensity.xyz * intensity, size);
        particle.StreakTimeReserved = float4(max(0.0, burst.SizeStreakReserved.z), 0.0, 0.0, 0.0);
        SparkParticles[(first_particle + particle_index) % SparkParticleCapacity] = particle;
    }
}
