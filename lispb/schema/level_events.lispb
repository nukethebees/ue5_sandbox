(module level_entity_ref
  :header "native/simulation/include/ioj/sim/levels/level_entity_ref.h"
  :namespace ioj::sim
  (record LevelEntityRef :layout packed :bits 32 :invalid-value 0xffffffff
    (member index std::uint32_t :bits 32)
    (projections (cpp :storage std::uint32_t))))

(module level_events_level_event_count
  :header "native/simulation/include/ioj/sim/levels/level_event_count.h"
  :namespace ioj::sim
  (integer-scalar LevelEventCount
    :signed false
    :minimum 0
    :maximum 255
    :bit-width 8
    (projections (cpp :storage std::uint8_t))))
(module level_event_kind
  :header "native/simulation/include/ioj/sim/levels/event_kind.h"
  :namespace ioj::sim
  (enum EventKind std::uint8_t
    :bit-width 3
    :native-api true
    :helpers (traits)
    :ordering (tick_end preparation)
    (value Win :groups (tick_end))
    (value StopRun :groups (tick_end))
    (value Pause :groups (tick_end))
    (value StartTimer :groups (tick_end))
    (value Spawn :groups (preparation))
    (projections (cpp))))

(module level_event_handle
  :header "native/simulation/include/ioj/sim/levels/event_handle.h"
  :namespace ioj::sim
  (integer-scalar EventIndex :signed false :bit-width 29)
  (record EventHandle :layout packed :bits 32
    (member index @EventIndex)
    (member kind @level_event_kind)
    (projections (cpp :storage std::uint32_t))))
