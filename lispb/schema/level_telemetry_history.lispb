(soa-module level_telemetry_history
  :header "native/simulation/include/ioj/sim/telemetry/level_telemetry_history.h"
  :backend standard-library
  :namespace ioj::sim::telemetry
  :include-order ("SpaceGameSimulation/" "SandboxCore/")
  (struct HistoryRows
    :operations (all)
      :field-mask-name HistoryFieldMask
    :field-enum-name HistoryField
    (member completed_ticks array @native_sim_tick)
    (member validity_masks array HistoryFieldMask)
    (member active_entities array int32
      :mask-field true)
    (member active_entities_by_type array @level_telemetry_entity_type_counts
      :mask-field true
      :mask-dimensions ((entity_type_index "entity_type_count")))
    (member active_entities_by_team_and_type array @level_telemetry_entity_counts
      :mask-field true
      :mask-dimensions (
        (team_index "team_count")
        (entity_type_index "entity_type_count")))
    (member spawned_entities array int32
      :mask-field true)
    (member destroyed_entities array int32
      :mask-field true)
    (member kills array int32
      :mask-field true)
    (member active_lasers array int32
      :mask-field true)
    (member lasers_fired array int32
      :mask-field true)
    (single-allocation SingleAllocationHistoryRows)))
