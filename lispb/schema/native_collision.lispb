(soa-module native_entity_overlaps
  :header "native/simulation/include/ioj/sim/entity_overlaps.h"
  :backend standard-library
  :namespace ioj::sim::collision
  (struct EntityEntityOverlaps
    :operations (all)
    (member first_entities array @native_registry_handle)
    (member second_entities array @native_registry_handle))
  (struct EntityStaticOverlaps
    :operations (all)
    (member entities array @native_registry_handle)
    (member static_geometry_indices array int32)))
