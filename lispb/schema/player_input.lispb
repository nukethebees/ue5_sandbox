(module game_input_actions
  :header "native/levels/lib/include/ioj/input/actions.h"
  :header-include "ioj/input/actions.h"
  :namespace ioj
  (enum DigitalAction @native_uint8 :native-api true :helpers (traits)
    (value Pause)
    (value Boost)
    (value Brake)
    (value EmergencyBrake)
    (value Fire)
    (value HoldToSteer)
    (value ObserverRight)
    (value ObserverLeft)
    (value ObserverForward)
    (value ObserverBackward)
    (value ObserverUp)
    (value ObserverDown)
    (value ObserverFast)
    (value ObserverToggleLook)
    (value MenuUp :groups (repeatable_navigation))
    (value MenuDown :groups (repeatable_navigation))
    (value MenuLeft :groups (repeatable_navigation))
    (value MenuRight :groups (repeatable_navigation))
    (value MenuNext)
    (value MenuPrevious)
    (value MenuAccept)
    (value MenuBack)
    (value BenchmarkNext)
    (value BenchmarkActivate)
    (value BenchmarkToggle)
    (value BenchmarkEnd)
    (projections (cpp)))
