  :namespace ioj
  (enum FlightMapping @native_uint8
    :enum-array true
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value GeneralPauseKeyboardMouse :serialized-name "General.Pause.KeyboardMouse")
    (value GeneralPauseGamepad :serialized-name "General.Pause.Gamepad" :groups (gamepad_mapping))
    (value FlightPitchKeyboardMouse :serialized-name "Flight.Pitch.KeyboardMouse")
    (value FlightPitchGamepad :serialized-name "Flight.Pitch.Gamepad" :groups (gamepad_mapping))
    (value FlightYawKeyboardMouse :serialized-name "Flight.Yaw.KeyboardMouse")
    (value FlightYawGamepad :serialized-name "Flight.Yaw.Gamepad" :groups (gamepad_mapping))
    (value FlightSteerKeyboardMouse :serialized-name "Flight.Steer.KeyboardMouse")
    (value FlightAccelerateKeyboardMouse :serialized-name "Flight.Accelerate.KeyboardMouse")
    (value FlightAccelerateGamepad :serialized-name "Flight.Accelerate.Gamepad" :groups (gamepad_mapping))
    (value FlightBrakeKeyboardMouse :serialized-name "Flight.Brake.KeyboardMouse")
    (value FlightBrakeGamepad :serialized-name "Flight.Brake.Gamepad" :groups (gamepad_mapping))
    (value FlightBoostKeyboardMouse :serialized-name "Flight.Boost.KeyboardMouse")
    (value FlightBoostGamepad :serialized-name "Flight.Boost.Gamepad" :groups (gamepad_mapping))
