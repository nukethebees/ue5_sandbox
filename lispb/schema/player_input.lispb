    (projections (cpp)))
  (enum WindowFocus @native_uint8 :native-api true :helpers (traits)
    (value Lost)
    (value Gained)
    (projections (cpp)))
  (record DigitalActions :layout packed :bits 32
    (member pause bool :bits 1 :enum-accessor (@DigitalAction Pause))
    (member boost bool :bits 1 :enum-accessor (@DigitalAction Boost))
    (member brake bool :bits 1 :enum-accessor (@DigitalAction Brake))
    (member emergency_brake bool :bits 1 :enum-accessor (@DigitalAction EmergencyBrake))
    (member fire bool :bits 1 :enum-accessor (@DigitalAction Fire))
    (member hold_to_steer bool :bits 1 :enum-accessor (@DigitalAction HoldToSteer))
    (member observer_right bool :bits 1 :enum-accessor (@DigitalAction ObserverRight))
    (member observer_left bool :bits 1 :enum-accessor (@DigitalAction ObserverLeft))
    (member observer_forward bool :bits 1 :enum-accessor (@DigitalAction ObserverForward))
    (member observer_backward bool :bits 1 :enum-accessor (@DigitalAction ObserverBackward))
    (member observer_up bool :bits 1 :enum-accessor (@DigitalAction ObserverUp))
    (member observer_down bool :bits 1 :enum-accessor (@DigitalAction ObserverDown))
    (member observer_fast bool :bits 1 :enum-accessor (@DigitalAction ObserverFast))
    (member observer_toggle_look bool :bits 1 :enum-accessor (@DigitalAction ObserverToggleLook))
    (member menu_up bool :bits 1 :enum-accessor (@DigitalAction MenuUp))
    (member menu_down bool :bits 1 :enum-accessor (@DigitalAction MenuDown))
    (member menu_left bool :bits 1 :enum-accessor (@DigitalAction MenuLeft))
    (member menu_right bool :bits 1 :enum-accessor (@DigitalAction MenuRight))
    (member menu_next bool :bits 1 :enum-accessor (@DigitalAction MenuNext))
    (member menu_previous bool :bits 1 :enum-accessor (@DigitalAction MenuPrevious))
    (member menu_accept bool :bits 1 :enum-accessor (@DigitalAction MenuAccept))
    (member menu_back bool :bits 1 :enum-accessor (@DigitalAction MenuBack))
    (member benchmark_next bool :bits 1 :enum-accessor (@DigitalAction BenchmarkNext))
    (member benchmark_activate bool :bits 1 :enum-accessor (@DigitalAction BenchmarkActivate))
    (member benchmark_toggle bool :bits 1 :enum-accessor (@DigitalAction BenchmarkToggle))
    (member benchmark_end bool :bits 1 :enum-accessor (@DigitalAction BenchmarkEnd))
    (projections (cpp :storage std::uint32_t))))

