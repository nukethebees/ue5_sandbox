    (value Fastest)
    (projections (cpp)))
  (enum InputContext @native_uint8 :native-api true :helpers (traits)
    (value Menu)
    (value Gameplay)
    (value Observer)
    (value Benchmark)
    (projections (cpp)))
  (enum ObserverLookMode @native_uint8
    (value Pointer)
    (value Camera)
    (projections (cpp)))
  (enum MenuCommand @native_uint8 :native-api true :helpers (traits)
    (value Up)
