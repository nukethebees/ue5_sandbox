(module flight_mapping
  :header "native/levels/lib/include/ioj/input/flight_mapping.h"
  :header-include "ioj/input/flight_mapping.h"
  :namespace ioj
  (enum FlightMapping @native_uint8
    :native-api true
    :helpers (traits to-serialized-string)
    (value GeneralPauseKeyboardMouse :serialized-name "General.Pause.KeyboardMouse")
    (value GeneralPauseGamepad :serialized-name "General.Pause.Gamepad" :groups (gamepad_mapping))
    (value StarfoxPitchKeyboardMouse :serialized-name "Starfox.Pitch.KeyboardMouse")
    (value StarfoxPitchGamepad :serialized-name "Starfox.Pitch.Gamepad" :groups (gamepad_mapping))
    (value StarfoxYawKeyboardMouse :serialized-name "Starfox.Yaw.KeyboardMouse")
    (value StarfoxYawGamepad :serialized-name "Starfox.Yaw.Gamepad" :groups (gamepad_mapping))
    (value StarfoxSteerKeyboardMouse :serialized-name "Starfox.Steer.KeyboardMouse")
    (value StarfoxAccelerateKeyboardMouse :serialized-name "Starfox.Accelerate.KeyboardMouse")
    (value StarfoxAccelerateGamepad :serialized-name "Starfox.Accelerate.Gamepad" :groups (gamepad_mapping))
    (value StarfoxBrakeKeyboardMouse :serialized-name "Starfox.Brake.KeyboardMouse")
    (value StarfoxBrakeGamepad :serialized-name "Starfox.Brake.Gamepad" :groups (gamepad_mapping))
    (value StarfoxBoostKeyboardMouse :serialized-name "Starfox.Boost.KeyboardMouse")
