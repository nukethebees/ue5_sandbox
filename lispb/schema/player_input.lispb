    (value StarfoxFirePrimaryKeyboardMouse :serialized-name "Starfox.FirePrimary.KeyboardMouse")
    (value StarfoxFirePrimaryGamepad :serialized-name "Starfox.FirePrimary.Gamepad" :groups (gamepad_mapping))
    (projections (cpp))))
