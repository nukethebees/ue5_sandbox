    (value Accelerate)
    (projections (cpp)))
  (enum Axis2DAction @native_uint8 :enum-array true :native-api true :helpers (traits)
    (value FlightTurn)
    (value ObserverLookDelta)
    (projections (cpp)))
  (enum PauseMenuView @native_uint8 :native-api true
    (value Closed)
    (value Sidebar)
    (value Options)
    (value Leaving)
    (projections (cpp)))
  (enum MenuInputMode @native_uint8 :native-api true :helpers (traits)
    (value Navigation)
