(module physical_button_state
  :header "native/levels/lib/include/ioj/input/physical/button_state.h"
  :header-include "ioj/input/physical/button_state.h"
  :namespace ioj
  (enum ButtonState @native_uint8 :native-api true :helpers (traits)
    (value Released)
    (value Pressed)
    (projections (cpp)))
  (enum WindowFocus @native_uint8 :native-api true :helpers (traits)
    (value Lost)
    (value Gained)
    (projections (cpp))))

(module game_input_actions
  :header "native/levels/lib/include/ioj/input/logical/actions.h"
  :header-include "ioj/input/logical/actions.h"
  :namespace ioj
  (enum DigitalAction @native_uint8 :native-api true :helpers (traits)
    (value Pause)
    (value Boost)
    (value Brake)
    (value EmergencyBrake)
    (value Fire)
    (value HoldToSteer)
    (value ObserverRight)
    (value ObserverLeft)
    (value ObserverForward)
    (value ObserverBackward)
    (value ObserverUp)
    (value ObserverDown)
    (value ObserverFast)
    (value ObserverToggleLook)
    (value MenuUp :groups (repeatable_navigation))
    (value MenuDown :groups (repeatable_navigation))
    (value MenuLeft :groups (repeatable_navigation))
    (value MenuRight :groups (repeatable_navigation))
    (value MenuNext)
    (value MenuPrevious)
    (value MenuAccept)
    (value MenuBack)
    (value BenchmarkNext)
    (value BenchmarkActivate)
    (value BenchmarkToggle)
    (value BenchmarkEnd)
    (projections (cpp)))
  (enum Axis1DAction @native_uint8 :enum-array true :native-api true :helpers (traits)
    (value Accelerate)
    (projections (cpp)))
  (enum Axis2DAction @native_uint8 :enum-array true :native-api true :helpers (traits)
    (value FlightTurn)
    (value ObserverLookDelta)
    (projections (cpp)))
  (enum MenuInputMode @native_uint8 :native-api true :helpers (traits)
    (value Navigation)
    (value BindingCapture)
    (value TextEntry)
    (projections (cpp)))
  (enum ObserverSpeedPreset @native_uint8 :enum-array true :native-api true :helpers (traits)
    (value Slowest)
    (value Slow)
    (value Normal)
    (value Fast)
    (value Fastest)
    (projections (cpp)))
  (enum InputContext @native_uint8 :native-api true :helpers (traits)
    (value Menu)
    (value Gameplay)
    (value Observer)
    (value Benchmark)
    (projections (cpp)))
  (enum ObserverLookMode @native_uint8
    (value Pointer)
    (value Camera)
    (projections (cpp)))
  (enum MenuCommand @native_uint8 :native-api true :helpers (traits)
    (value Up)
    (value Down)
    (value Left)
    (value Right)
    (value Next)
    (value Previous)
    (value Accept)
    (value Back)
    (projections (cpp)))
  (enum MainMenuItem @native_uint8 :native-api true :helpers (traits cycle-next cycle-previous)
    (value SelectLevel)
    (value DataArchive)
    (value Video)
    (value Gameplay)
    (value Audio)
    (value Controls)
    (value Accessibility)
    (value System)
    (value Quit)
    (projections (cpp)))
  (enum BindingGroup @native_uint8 :native-api true :helpers (traits to-string)
    (value Flight)
    (value Combat)
    (value Utility)
    (projections (cpp)))
  (enum InputResponse @native_uint8 :native-api true :helpers (traits)
    (value TurnPointerDelta)
    (value GamepadTurn)
    (projections (cpp)))
  (enum FlightAxis @native_uint8 :native-api true :helpers (traits)
    (value None)
    (value Pitch)
    (value Yaw)
    (projections (cpp)))

  (record DigitalActions :layout packed :bits 32
    (member pause bool :bits 1 :enum-accessor (@DigitalAction Pause))
    (member boost bool :bits 1 :enum-accessor (@DigitalAction Boost))
    (member brake bool :bits 1 :enum-accessor (@DigitalAction Brake))
    (member emergency_brake bool :bits 1 :enum-accessor (@DigitalAction EmergencyBrake))
    (member fire bool :bits 1 :enum-accessor (@DigitalAction Fire))
    (member hold_to_steer bool :bits 1 :enum-accessor (@DigitalAction HoldToSteer))
    (member observer_right bool :bits 1 :enum-accessor (@DigitalAction ObserverRight))
    (member observer_left bool :bits 1 :enum-accessor (@DigitalAction ObserverLeft))
    (member observer_forward bool :bits 1 :enum-accessor (@DigitalAction ObserverForward))
    (member observer_backward bool :bits 1 :enum-accessor (@DigitalAction ObserverBackward))
    (member observer_up bool :bits 1 :enum-accessor (@DigitalAction ObserverUp))
    (member observer_down bool :bits 1 :enum-accessor (@DigitalAction ObserverDown))
    (member observer_fast bool :bits 1 :enum-accessor (@DigitalAction ObserverFast))
    (member observer_toggle_look bool :bits 1 :enum-accessor (@DigitalAction ObserverToggleLook))
    (member menu_up bool :bits 1 :enum-accessor (@DigitalAction MenuUp))
    (member menu_down bool :bits 1 :enum-accessor (@DigitalAction MenuDown))
    (member menu_left bool :bits 1 :enum-accessor (@DigitalAction MenuLeft))
    (member menu_right bool :bits 1 :enum-accessor (@DigitalAction MenuRight))
    (member menu_next bool :bits 1 :enum-accessor (@DigitalAction MenuNext))
    (member menu_previous bool :bits 1 :enum-accessor (@DigitalAction MenuPrevious))
    (member menu_accept bool :bits 1 :enum-accessor (@DigitalAction MenuAccept))
    (member menu_back bool :bits 1 :enum-accessor (@DigitalAction MenuBack))
    (member benchmark_next bool :bits 1 :enum-accessor (@DigitalAction BenchmarkNext))
    (member benchmark_activate bool :bits 1 :enum-accessor (@DigitalAction BenchmarkActivate))
    (member benchmark_toggle bool :bits 1 :enum-accessor (@DigitalAction BenchmarkToggle))
    (member benchmark_end bool :bits 1 :enum-accessor (@DigitalAction BenchmarkEnd))
    (projections (cpp :storage std::uint32_t))))

; Keyboard values are USB HID Keyboard/Keypad usages (page 0x07), matching SDL scancodes.
; Unbound is zero. Mouse (0x0200+) and gamepad (0x0300+) codes are project-assigned.
