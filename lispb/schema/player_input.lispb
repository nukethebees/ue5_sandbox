    (value FlightEmergencyBrakeGamepad :serialized-name "Flight.EmergencyBrake.Gamepad" :groups (gamepad_mapping))
    (value FlightFirePrimaryKeyboardMouse :serialized-name "Flight.FirePrimary.KeyboardMouse")
    (value FlightFirePrimaryGamepad :serialized-name "Flight.FirePrimary.Gamepad" :groups (gamepad_mapping))
    (projections (cpp))))

(module input_modifiers
  :header "native/levels/lib/include/ioj/input/physical/modifiers.h"
  :namespace ioj::host
  (record Modifiers :layout packed :bits 16
    (member left_shift bool :bits 1)
    (member right_shift bool :bits 1)
    (member left_control bool :bits 1)
    (member right_control bool :bits 1)
    (member left_alt bool :bits 1)
    (member right_alt bool :bits 1)
    (member left_command bool :bits 1)
    (member right_command bool :bits 1)
    (member caps_lock bool :bits 1)
    (projections (cpp :storage std::uint16_t))))

(module player_host_actions
  :header "native/levels/lib/include/ioj/input/dispatch/input_actions.h"
  :namespace ioj::host
  (enum PlayerAction @native_uint8 :native-api true :helpers (traits)
