(enum-module native_entity_life_state
  :header "native/simulation/include/ioj/sim/entity_life_state.h"
  :namespace ioj::sim
  (enum LifeState @native_uint8
    (value Alive)
    (value Unknown)
    (value Combat))
  (enum DeathReason @native_uint8
    (value Unknown :value 1)
    (value Combat :value 2)))
