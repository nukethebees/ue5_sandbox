(module entity_instance_handle
  :header "native/simulation/include/ioj/sim/entities/entity_instance_handle.h"
  :header-include "ioj/sim/entities/entity_instance_handle.h"
  :namespace ioj::sim
  (integer-scalar EntityFrameIndex
    :signed false :minimum 0 :maximum 262143 :bit-width 18
    (projections (cpp :storage std::uint32_t)))
  (integer-scalar QuantisedHealth
    :signed false :minimum 0 :maximum 3 :bit-width 2
    (projections (cpp :storage std::uint8_t)))
  (record EntityInstanceHandle
    :layout packed :bits 32 :invalid-value 0xffffffff
    (member index @EntityFrameIndex)
    (member team @native_team :bits 3)
    (member health_state @QuantisedHealth)
    (reserved future :bits 9)
    (projections (cpp :storage std::uint32_t))))
