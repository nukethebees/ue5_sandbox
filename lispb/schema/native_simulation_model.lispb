(module native_level_state
  :header "native/simulation/include/ioj/sim/levels/level_state.h"
  :header-include "ioj/sim/levels/level_state.h"
  :namespace ioj::sim
  (enum LevelState std::uint8_t
    (value Uninitialised)
    (value StableSetup)
    (value Paused)
    (value Running)
    (value Stopped)
    (projections (cpp))))

(module native_simulation_phase
  :header "native/simulation/include/ioj/sim/simulation_phase.h"
  :header-include "ioj/sim/simulation_phase.h"
  :namespace ioj::sim
  (enum SimulationPhase @native_uint8
    :native-api true :helpers (cycle-next)
    (value Preparation)
    (value Thinking)
    (value Action)
    (value Resolution)
    (value ResolutionCommit)
    (value BetweenTicks)
    (projections (cpp))))

