    :comparison equality
    (member positive_target_speed float :initializer "")
    (member negative_target_speed float :initializer "")
    (member positive_speed_limit float :initializer "effectively_unlimited_speed")
    (member negative_speed_limit float :initializer "effectively_unlimited_speed")
    (member positive_acceleration float :initializer "")
    (member negative_acceleration float :initializer ""))
  (record TranslationAxisConfig
    :comparison equality
    (member manual ioj::sim::player::TranslationChannelConfig :initializer "")
    (member automatic ioj::sim::player::TranslationChannelConfig :initializer "")
    (member normal ioj::sim::player::TranslationDriveConfig :initializer "")
    (member boosted ioj::sim::player::TranslationDriveConfig :initializer "")
    (member passive_drag float :initializer "")
    (member passive_drag_reference_frame ioj::sim::player::ReferenceFrame :initializer "ReferenceFrame::Ship")
    (member active_stabilization_rate float :initializer "")
    (member active_stabilization_reference_frame ioj::sim::player::ReferenceFrame :initializer "ReferenceFrame::Ship"))
  (record TranslationAxesConfig
    :comparison equality
    (member forward ioj::sim::player::TranslationAxisConfig :initializer "")
    (member right ioj::sim::player::TranslationAxisConfig :initializer "")
    (member up ioj::sim::player::TranslationAxisConfig :initializer ""))
  (record RotationStabilizationConfig
    :comparison equality
    (member enabled bool :initializer "")
    (member target_angle float :initializer "")
    (member delay float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record RotationAxisConfig
    :comparison equality
    (member manual_semantic ioj::sim::player::RotationSemantic :initializer "RotationSemantic::Disabled")
    (member maximum_rate float :initializer "")
    (member acceleration float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer "")
    (member stabilization ioj::sim::player::RotationStabilizationConfig :initializer ""))
  (record RotationAxesConfig
    :comparison equality
    (member pitch ioj::sim::player::RotationAxisConfig :initializer "")
    (member yaw ioj::sim::player::RotationAxisConfig :initializer "")
    (member roll ioj::sim::player::RotationAxisConfig :initializer ""))
  (record FacingVelocityConfig
    :comparison equality
    (member mode ioj::sim::player::FacingVelocityCoupling :initializer "FacingVelocityCoupling::Independent")
    (member alignment_rate float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record BoostConfig
    :comparison equality
    (member available bool :initializer "")
    (member accelerator_activates_boost bool :initializer "")
    (member energy_drain_per_second float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record BrakeConfig
    :comparison equality
    (member available bool :initializer "")
    (member target_speed float :initializer "")
    (member deceleration float :initializer "")
    (member energy_drain_per_second float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record FlightModelConfig
    :comparison equality
    (member translation ioj::sim::player::TranslationAxesConfig :initializer "")
    (member rotation ioj::sim::player::RotationAxesConfig :initializer "")
    (member facing_velocity ioj::sim::player::FacingVelocityConfig :initializer "")
    (member boost ioj::sim::player::BoostConfig :initializer "")
    (member brake ioj::sim::player::BrakeConfig :initializer "")
    (member emergency_brake ioj::sim::player::BrakeConfig :initializer "")
    (member energy_recharge_per_second float :initializer "")
    (member maximum_resultant_speed float :initializer "effectively_unlimited_speed")
    (member boosted_maximum_resultant_speed float :initializer "effectively_unlimited_speed"))
  (record FlightModelProfile
    :comparison equality
    (member base_preset ioj::sim::player::FlightModelPreset :initializer "FlightModelPreset::Starfox")
    (member customized bool :initializer "")
    (member config ioj::sim::player::FlightModelConfig :initializer ""))
  (record FlightModelLoadout
    :comparison equality
    (member up ioj::sim::player::FlightModelProfile :initializer "")
    (member right ioj::sim::player::FlightModelProfile :initializer "")
    (member down ioj::sim::player::FlightModelProfile :initializer "")
    (member left ioj::sim::player::FlightModelProfile :initializer "")
    (member initial_slot ioj::sim::player::FlightModelSlot :initializer "FlightModelSlot::Up")))

