    :generate-visitor true
    :generate-s7-reader true :generate-s7-writer true :s7-tag "laser-projectiles"
    (member n_preallocated_instances @settings_nonnegative_int :initializer "5000")
    (projections (cpp))))

(module native_base_sim_config_overlap_response_config
  :header "native/levels/lib/include/ioj/sim/collision/overlap_response_config.h"
  :header-include "ioj/sim/collision/overlap_response_config.h"
  :namespace ioj::sim
  (record OverlapResponseConfig :comparison equality
    :generate-visitor true
    :generate-s7-reader true :generate-s7-writer true :s7-tag "collision-grid"
    (member damage_per_overlap_detection @settings_positive_int :initializer 50)
    (member level_size @native_vector_3f :initializer "2000000.f, 2000000.f, 100000.f" :finite true)
    (member cell_size @native_vector_3f :initializer "5000.f, 5000.f, 20000.f" :finite true)
    (projections (cpp))))

(module native_base_sim_config_fighter_sim_config
  :header "native/levels/lib/include/ioj/sim/fighters/fighter_sim_config.h"
  :header-include "ioj/sim/fighters/fighter_sim_config.h"
  :namespace ioj::sim
  (record FighterSimConfig :comparison equality
    :generate-visitor true
    :generate-s7-reader true :generate-s7-writer true :s7-tag "fighters"
    (member max_live_auto_spawned_fighters @settings_nonnegative_int :initializer "2000")
    (member fire_point_distance float :initializer "" :s7-exclude true)
    (member fire_dot_product_threshold @settings_dot_product :initializer "0.95f")
    (member attack_distance_band ioj::settings::AttackDistanceBand :initializer "")
    (member speed float :initializer "2000.f" :finite true)
    (member turn_speed_unitless float :initializer "1.f" :finite true)
    (member avoidance_clear_update_frequency @settings_positive_float :initializer "2.f")
    (member avoidance_update_frequency @settings_positive_float :initializer "5.f")
    (member avoidance_active_update_frequency @settings_positive_float :initializer "12.f")
    (member avoidance_immediate_update_frequency @settings_positive_float :initializer "30.f")
    (member avoidance_lookahead_time @settings_nonnegative_float :initializer "1.f")
    (member avoidance_clearance_buffer @settings_nonnegative_float :initializer "100.f")
    (member separation_radius @settings_positive_float :initializer "2000.f")
    (member separation_strength @settings_nonnegative_float :initializer "1.f")
    (member steering_memory_duration @settings_nonnegative_float :initializer "0.75f")
    (member dense_traffic_neighbour_threshold @settings_neighbour_threshold :initializer "4")
    (member laser ioj::sim::LaserWeaponSimConfig :initializer "")
    (member health @settings_positive_health :initializer "Health{50}")
    (member attack_retry_cooldown @settings_nonnegative_float :initializer "0.15f")
    (member los_check_buffer float :initializer "100.f" :finite true)
    (projections (cpp))))

