(module attack_distance_band
  :header "native/levels/lib/include/ioj/settings/attack_distance_band.h"
  :header-include "ioj/settings/attack_distance_band.h"
  :namespace ioj::settings
  :prelude ("#include <ioj/settings/attack_distance_band_policy.h>")
  (record AttackDistanceBand
    :constraint-policy ioj::settings::attack_distance_band_policy
    :comparison equality
    :generate-s7-reader true :s7-tag "attack-distance-band"
    (member minimum float :initializer 0.4f :s7-name "minimum-ratio" :required true)
    (member desired float :initializer 0.5f :s7-name "desired-ratio" :required true)
    (member maximum float :initializer 0.6f :s7-name "maximum-ratio" :required true)))

(module native_base_sim_config_laser_weapon_sim_config
  :header "native/levels/lib/include/ioj/sim/lasers/laser_weapon_sim_config.h"
  :header-include "ioj/sim/lasers/laser_weapon_sim_config.h"
  :namespace ioj::sim
  (record LaserWeaponSimConfig
    :generate-settings true :generate-overrides true
    :generate-s7-reader true :s7-tag "laser"
    (member damage std::int32_t :initializer "5")
    (member projectile_speed float :initializer "10000.f" :finite true)
    (member max_distance float :initializer "10000.f" :finite true)
    (member fire_cooldown float :initializer "0.33f" :finite true)))

(module native_base_sim_config_laser_sim_config
  :header "native/levels/lib/include/ioj/sim/lasers/laser_sim_config.h"
  :header-include "ioj/sim/lasers/laser_sim_config.h"
  :namespace ioj::sim
  (record LaserSimConfig
    :generate-settings true :generate-overrides true
    :generate-s7-reader true :s7-tag "laser-projectiles"
    (member n_preallocated_instances std::int32_t :initializer "5000")))

(module native_base_sim_config_overlap_response_config
  :header "native/levels/lib/include/ioj/sim/collision/overlap_response_config.h"
  :header-include "ioj/sim/collision/overlap_response_config.h"
  :namespace ioj::sim
  (record OverlapResponseConfig
    :generate-settings true :generate-overrides true
    :generate-s7-reader true :s7-tag "collision-grid"
    (member damage_per_overlap_detection std::int32_t :initializer 50)
    (member level_size @native_vector_3f :initializer "2000000.f, 2000000.f, 100000.f" :finite true)
    (member cell_size @native_vector_3f :initializer "5000.f, 5000.f, 20000.f" :finite true)))

(module native_base_sim_config_fighter_sim_config
  :header "native/levels/lib/include/ioj/sim/fighters/fighter_sim_config.h"
  :header-include "ioj/sim/fighters/fighter_sim_config.h"
  :namespace ioj::sim
  (record FighterSimConfig
    :generate-settings true :generate-overrides true
    :generate-s7-reader true :s7-tag "fighters"
    (member max_live_fighters std::int32_t :initializer "2000")
    (member fire_point_distance float :initializer "" :settings-exclude true)
    (member fire_dot_product_threshold float :initializer "0.95f" :finite true)
    (member speed float :initializer "2000.f" :finite true)
    (member turn_speed_unitless float :initializer "1.f" :finite true)
    (member avoidance_clear_update_frequency float :initializer "2.f" :finite true)
    (member avoidance_update_frequency float :initializer "5.f" :finite true)
    (member avoidance_active_update_frequency float :initializer "12.f" :finite true)
    (member avoidance_immediate_update_frequency float :initializer "30.f" :finite true)
    (member avoidance_lookahead_time float :initializer "1.f" :finite true)
    (member avoidance_clearance_buffer float :initializer "100.f" :finite true)
    (member separation_radius float :initializer "2000.f" :finite true)
    (member separation_strength float :initializer "1.f" :finite true)
    (member steering_memory_duration float :initializer "0.75f" :finite true)
    (member dense_traffic_neighbour_threshold std::int32_t :initializer "4")
    (member laser ioj::sim::LaserWeaponSimConfig :initializer "")
    (member health @native_health :initializer "50")
    (member attack_retry_cooldown float :initializer "0.15f" :finite true)
    (member attack_engagement_threshold float :initializer "5000.f" :finite true)
    (member attack_reposition_frequency float :initializer "10.f" :finite true)
    (member attack_distance_band ioj::settings::AttackDistanceBand :initializer "")
    (member arrival_distance float :initializer "500.f" :finite true)
    (member los_check_buffer float :initializer "100.f" :finite true)
    (member awareness_radius float :initializer "10000.f" :finite true)
    (member awareness_scan_frequency float :initializer "6.f" :finite true)
    (member minimum_opportunistic_intercept_deviation_dot_product float :initializer "0.5f" :finite true)))

(module native_player_flight_model_data
  :header "native/simulation/include/ioj/sim/player/flight_model_data.h"
  :header-include "ioj/sim/player/flight_model_data.h"
  :namespace ioj::sim::player
  :prelude ("#include <ioj/sim/player/flight_model_constants.h>")
  (record RateLimitedResponseConfig
    :comparison equality
    (member increasing_rate float :initializer "")
    (member decreasing_rate float :initializer ""))
  (record SecondOrderResponseConfig
    :comparison equality
    (member settling_time float :initializer "3.f")
    (member damping_ratio float :initializer "0.5f"))
  (record ResponseConfig
    :comparison equality
    (member mode ioj::sim::player::ResponseMode :initializer "ResponseMode::Direct")
    (member rate_limited ioj::sim::player::RateLimitedResponseConfig :initializer "")
    (member second_order ioj::sim::player::SecondOrderResponseConfig :initializer ""))
  (record TranslationChannelConfig
    :comparison equality
    (member semantic ioj::sim::player::TranslationSemantic :initializer "TranslationSemantic::Disabled")
    (member reference_frame ioj::sim::player::ReferenceFrame :initializer "ReferenceFrame::Ship")
    (member input_source ioj::sim::player::TranslationInputSource :initializer "TranslationInputSource::Axis")
    (member automatic_value float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record TranslationDriveConfig
    :comparison equality
    (member positive_target_speed float :initializer "")
    (member negative_target_speed float :initializer "")
    (member positive_speed_limit float :initializer "effectively_unlimited_speed")
    (member negative_speed_limit float :initializer "effectively_unlimited_speed")
    (member positive_acceleration float :initializer "")
    (member negative_acceleration float :initializer ""))
  (record TranslationAxisConfig
    :comparison equality
    (member manual ioj::sim::player::TranslationChannelConfig :initializer "")
    (member automatic ioj::sim::player::TranslationChannelConfig :initializer "")
    (member normal ioj::sim::player::TranslationDriveConfig :initializer "")
    (member boosted ioj::sim::player::TranslationDriveConfig :initializer "")
    (member passive_drag float :initializer "")
    (member passive_drag_reference_frame ioj::sim::player::ReferenceFrame :initializer "ReferenceFrame::Ship")
    (member active_stabilization_rate float :initializer "")
    (member active_stabilization_reference_frame ioj::sim::player::ReferenceFrame :initializer "ReferenceFrame::Ship"))
  (record TranslationAxesConfig
    :comparison equality
    (member forward ioj::sim::player::TranslationAxisConfig :initializer "")
    (member right ioj::sim::player::TranslationAxisConfig :initializer "")
    (member up ioj::sim::player::TranslationAxisConfig :initializer ""))
  (record RotationStabilizationConfig
    :comparison equality
    (member enabled bool :initializer "")
    (member target_angle float :initializer "")
    (member delay float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record RotationAxisConfig
    :comparison equality
    (member manual_semantic ioj::sim::player::RotationSemantic :initializer "RotationSemantic::Disabled")
    (member maximum_rate float :initializer "")
    (member acceleration float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer "")
    (member stabilization ioj::sim::player::RotationStabilizationConfig :initializer ""))
  (record RotationAxesConfig
    :comparison equality
    (member pitch ioj::sim::player::RotationAxisConfig :initializer "")
    (member yaw ioj::sim::player::RotationAxisConfig :initializer "")
    (member roll ioj::sim::player::RotationAxisConfig :initializer ""))
  (record FacingVelocityConfig
    :comparison equality
    (member mode ioj::sim::player::FacingVelocityCoupling :initializer "FacingVelocityCoupling::Independent")
    (member alignment_rate float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record BoostConfig
    :comparison equality
    (member available bool :initializer "")
    (member accelerator_activates_boost bool :initializer "")
    (member energy_drain_per_second float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record BrakeConfig
    :comparison equality
    (member available bool :initializer "")
    (member target_speed float :initializer "")
    (member deceleration float :initializer "")
    (member energy_drain_per_second float :initializer "")
    (member response ioj::sim::player::ResponseConfig :initializer ""))
  (record FlightModelConfig
    :comparison equality
    (member translation ioj::sim::player::TranslationAxesConfig :initializer "")
    (member rotation ioj::sim::player::RotationAxesConfig :initializer "")
    (member facing_velocity ioj::sim::player::FacingVelocityConfig :initializer "")
    (member boost ioj::sim::player::BoostConfig :initializer "")
    (member brake ioj::sim::player::BrakeConfig :initializer "")
    (member emergency_brake ioj::sim::player::BrakeConfig :initializer "")
    (member energy_recharge_per_second float :initializer "")
    (member maximum_resultant_speed float :initializer "effectively_unlimited_speed")
    (member boosted_maximum_resultant_speed float :initializer "effectively_unlimited_speed"))
  (record FlightModelProfile
    :comparison equality
    (member base_preset ioj::sim::player::FlightModelPreset :initializer "FlightModelPreset::Starfox")
    (member customized bool :initializer "")
    (member config ioj::sim::player::FlightModelConfig :initializer ""))
  (record FlightModelLoadout
    :comparison equality
    (member profiles ioj::sim::player::FlightModelProfile :count 4 :initializer "")
    (member initial_slot ioj::sim::player::FlightModelSlot :initializer "FlightModelSlot::First")))

