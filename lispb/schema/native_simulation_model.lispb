(module native_index_span
  :header "native/simulation/include/ioj/sim/index_span.h"
  :header-include "ioj/sim/index_span.h"
  :namespace ioj::sim
  (record IndexSpan
    :comparison three-way
    :comparison-noexcept true
    (member offset std::uint32_t :initializer "0")
    (member count std::uint32_t :initializer "0")
    (function is_empty bool :const true :noexcept true :constexpr true :nodiscard true :body ("return count == 0;"))
    (function start std::uint32_t :const true :noexcept true :constexpr true :nodiscard true :body ("return offset;"))
    (function end std::uint32_t :const true :noexcept true :constexpr true :nodiscard true :body ("return offset + count;"))))



