(module native_sim_state
  :header "native/simulation/include/ioj/sim/sim_state.h"
  :header-include "ioj/sim/sim_state.h"
  :namespace ioj::sim
  (enum OrchestratorState std::uint8_t
    (value Uninitialised)
    (value Paused)
    (value Running)
    (value Stopped)))

(module native_simulation_phase
  :header "native/simulation/include/ioj/sim/simulation_phase.h"
  :header-include "ioj/sim/simulation_phase.h"
  :namespace ioj::sim
  (enum SimulationPhase @native_uint8
    ; Keep lookup-valid phases before Initialisation, the exclusive lookup boundary.
    (value StableSetup)
    (value Thinking)
    (value Action)
    (value Resolution)
    (value Initialisation)
    (value Preparation)
    (value ResolutionCommit)
    (value BetweenTicks)))

(module native_collision_trace_entity_filter
  :header "native/simulation/include/ioj/sim/collision/trace_entity_filter.h"
  :header-include "ioj/sim/collision/trace_entity_filter.h"
  :namespace ioj::sim::collision
  (enum TraceEntityFilter std::uint8_t
    (value None)
    (value ExcludeFighters)))

(module native_player_flight_model_enums
  :header "native/simulation/include/ioj/sim/player/flight_model_enums.h"
  :header-include "ioj/sim/player/flight_model_enums.h"
  :namespace ioj::sim::player
  (enum FlightModelPreset std::uint8_t
    (value Starfox)
    (value Fighter)
    (value Skater)
    (value Gunship))
  (enum FlightModelSlot std::uint8_t
    (value First)
    (value Second)
    (value Third)
    (value Fourth))
  (enum TranslationSemantic std::uint8_t
    (value Disabled)
    (value TargetSpeed)
    (value TargetVelocity)
    (value Acceleration))
  (enum RotationSemantic std::uint8_t
    (value Disabled)
    (value TargetAngularVelocity)
    (value AngularAcceleration))
  (enum ReferenceFrame std::uint8_t
    (value Ship)
    (value World))
  (enum TranslationInputSource std::uint8_t
    (value Axis)
    (value Accelerator))
  (enum ResponseMode std::uint8_t
    (value Direct)
    (value RateLimited)
    (value SecondOrder))
  (enum FacingVelocityCoupling std::uint8_t
    (value Independent)
    (value AlignToFacing)
    (value LockedToFacing))
  (enum FlightModelConfigError std::uint8_t
    (value InvalidEnumValue)
    (value NonFiniteValue)
    (value NegativeValue)
    (value InputValueOutOfRange)
    (value InvalidManualChannel)
    (value InvalidAutomaticChannel)
    (value AmbiguousTargetChannels)
    (value InvalidSecondOrderSettlingTime)
    (value InvalidSecondOrderDampingRatio)))

(module native_fighters_navigation_records
  :header "native/simulation/include/ioj/sim/fighters/navigation_records.h"
  :header-include "ioj/sim/fighters/navigation_records.h"
  :namespace ioj::sim::fighters
  (record AvoidanceFrame
    (member preferred_direction @native_vector_3f)
    (member first_lateral @native_vector_3f)
    (member second_lateral @native_vector_3f)
    (member roll_sin float)
    (member roll_cos float))
  (record NavigationRiskUpdate
    (member tier ioj::sim::fighters::NavigationRiskTier)
    (member lower_risk_scan_count std::uint8_t))
  (record SeparationObservationParameters
    (member separation_radius float)
    (member immediate_distance_squared float)
    (member close_distance_squared float)
    (member memory_retention float)
    (member separation_strength float)
    (member dense_traffic_neighbour_threshold std::int32_t)
    (member integral_bias std::uint32_t)
    (member float_bias float))
  (record SeparationObservation
    (member steering_memory @native_vector_3f)
    (member risk_tier ioj::sim::fighters::NavigationRiskTier)
    (member dense_direction_selected bool))
  (record SeparationNeighbour
    (member id @native_unique_id)
    (member location @native_vector_3f)))

