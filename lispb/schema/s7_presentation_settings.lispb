(module presentation_player
  :header "native/levels/lib/include/ioj/settings/player_presentation.h"
  :header-include "ioj/settings/player_presentation.h"
  :namespace ioj::settings
  (record PlayerPresentation
    :generate-visitor true
    :generate-s7-reader true :s7-tag "player-ship"
    (member boost_effect_colour_intensity float :initializer 75.f :finite true)))

(module presentation_lasers
  :header "native/levels/lib/include/ioj/settings/laser_presentation.h"
  :header-include "ioj/settings/laser_presentation.h"
  :namespace ioj::settings
  (record LaserPresentation
    :generate-visitor true
    :generate-s7-reader true :s7-tag "laser-projectiles"
    (member min_cull_distance float :initializer 0.f :finite true)
    (member max_cull_distance float :initializer 50000.f :finite true)))

(module presentation_capitals
  :header "native/levels/lib/include/ioj/settings/capital_presentation.h"
  :header-include "ioj/settings/capital_presentation.h"
  :namespace ioj::settings
  (record CapitalPresentation
    :generate-visitor true
    :generate-s7-reader true :s7-tag "capital-ships"
    (member n_small_explosions std::int32_t :initializer 6)
    (member time_between_explosions float :initializer 0.1f :finite true)
    (member min_small_explosion_range @native_vector_3f :initializer "" :finite true)
    (member max_small_explosion_range @native_vector_3f :initializer "1.f, 1.f, 1.f" :finite true)
    (member large_explosion_delay float :initializer 0.f :finite true)
    (member proxy_arrow_size float :initializer 5.f :finite true)))

(module presentation_turrets
  :header "native/levels/lib/include/ioj/settings/turret_presentation.h"
  :header-include "ioj/settings/turret_presentation.h"
  :namespace ioj::settings
  (record TurretPresentation
    :generate-visitor true
    :generate-s7-reader true :s7-tag "turrets"
    (member death_effect_scale float :initializer 1.f :finite true)))

(module presentation_soft_target
  :header "native/levels/lib/include/ioj/settings/soft_target.h"
  :header-include "ioj/settings/soft_target.h"
  :namespace ioj::settings
  (record SoftTarget
    :generate-visitor true
    :generate-s7-reader true :s7-tag "soft-target"
    (member acquisition_radius_pixels float :initializer 72.f :finite true)
    (member retention_radius_pixels float :initializer 96.f :finite true)
    (member centre_tie_radius_pixels float :initializer 4.f :finite true)
    (member switch_improvement_ratio float :initializer 0.75f :finite true)
    (member range_transition_start_multiplier float :initializer 4.f :finite true)
    (member minimum_radius_pixels float :initializer 28.f :finite true)
    (member maximum_radius_pixels float :initializer 96.f :finite true)
    (member bounds_padding_pixels float :initializer 10.f :finite true)
    (member bracket_start_radius_multiplier float :initializer 2.5f :finite true)
    (member opacity float :initializer 0.70f :finite true)
    (member pulse_opacity_boost float :initializer 0.08f :finite true)
    (member pulse_duration float :initializer 0.15f :finite true)
    (member fade_out_duration float :initializer 0.15f :finite true)))

(module presentation_entity_overlay
  :header "native/levels/lib/include/ioj/settings/entity_overlay.h"
  :header-include "ioj/settings/entity_overlay.h"
  :namespace ioj::settings
  (record EntityOverlay
    :generate-visitor true
    :generate-s7-reader true :s7-tag "entity-overlay"
    (member enabled bool :initializer true)
    (member maximum_range float :initializer 1000000.f :finite true)
    (member bar_size_pixels @settings_vector2d :initializer "64.0, 8.0" :finite true)
    (member screen_offset_pixels @settings_vector2d :initializer "0.0, -24.0" :finite true)
    (member minimum_bar_scale float :initializer 0.5f :finite true)
    (member maximum_bar_scale float :initializer 2.f :finite true)
    (member inset_pixels float :initializer 1.f :finite true)
    (member maximum_inset_height_ratio float :initializer 0.4f :finite true)
    (member objective_frame_pixels float :initializer 3.f :finite true)
    (member objective_bar_height_scale float :initializer 1.4f :finite true)
    (member screen_edge_padding_pixels float :initializer 12.f :finite true)
    (member soft_target ioj::settings::SoftTarget :initializer "")))

(module presentation_radar
  :header "native/levels/lib/include/ioj/settings/radar.h"
  :header-include "ioj/settings/radar.h"
  :namespace ioj::settings
  (record Radar
    :generate-visitor true
    :generate-s7-reader true :s7-tag "radar"
    (member enabled bool :initializer true)
    (member combat_range float :initializer 100000.f :finite true)
    (member tactical_range float :initializer 400000.f :finite true)
    (member maximum_range float :initializer 2000000.f :finite true)
    (member combat_display_radius float :initializer 0.45f :finite true)
    (member grid_opacity float :initializer 0.55f :finite true)
    (member core_cell_radius float :initializer 0.18f :finite true)
    (member combat_cell_radius float :initializer 0.075f :finite true)
    (member tactical_cell_radius float :initializer 0.045f :finite true)
    (member strategic_cell_radius float :initializer 0.025f :finite true)
    (member glyph_size_scale float :initializer 1.f :finite true)
    (member objective_size_multiplier float :initializer 1.2f :finite true)
    (member objective_ring_padding_pixels float :initializer 3.f :finite true)
    (member objective_ring_thickness_pixels float :initializer 1.25f :finite true)))

(module presentation_settings
  :header "native/levels/lib/include/ioj/settings/presentation.h"
  :header-include "ioj/settings/presentation.h"
  :namespace ioj::settings
  (record Presentation
    :generate-visitor true
    :generate-s7-reader true :s7-tag "presentation"
    (member player_ship ioj::settings::PlayerPresentation :initializer "")
    (member laser_projectiles ioj::settings::LaserPresentation :initializer "")
    (member capital_ships ioj::settings::CapitalPresentation :initializer "")
    (member turrets ioj::settings::TurretPresentation :initializer "")
    (member entity_overlay ioj::settings::EntityOverlay :initializer "")
    (member radar ioj::settings::Radar :initializer "")))
