(module level_definition_soa
  :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/levels/LevelDefinitionSoA.h"
  :source "Plugins/SpaceGame/Source/SpaceGameSimulation/Private/levels/LevelDefinitionSoA.cpp"
  :header-include "SpaceGameSimulation/levels/LevelDefinitionSoA.h"
  :namespace ml
  :include-order ("SpaceGame/" "SandboxCore/")
  (struct FLevelEntityTable
    :operations (all)
    :export-specifier SPACEGAMESIMULATION_API
    (member ids array @level_entity_id)
    (member archetypes array @entity_archetype_id)
    (member teams array @native_team)
    (member positions nested @vectors_3d)
    (member rotations nested @rotators_d)
    (member spawn_times_seconds array double)))

(module level_runtime_events_level_spawn_groups
  :header "native/simulation/include/ioj/sim/levels/level_spawn_groups.h"
  :backend standard-library
  :namespace ioj::sim
  (struct Vectors3f
    :layout-only true
    :vector-components (xs ys zs)
    (member xs array float)
    (member ys array float)
    (member zs array float))
  (struct Rotators3f
    :layout-only true
    :vector-components (pitches yaws rolls)
    (member pitches array float)
    (member yaws array float)
    (member rolls array float))
  (struct LevelSpawnGroups
    :operations (all)
    (member types array @native_entity_type)
    (member offsets array int32)
    (member counts array @native_level_event_count)
    (single-allocation LevelSpawnGroups)))

(module level_runtime_events_level_capital_spawn_events
