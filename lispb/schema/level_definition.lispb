(module level_runtime_events_change_points_events
  :header "native/simulation/include/ioj/sim/levels/change_points_events.h"
  :namespace ioj::sim
  (struct ChangePointsEvents
    (member deltas array @points_change)
    (member teams array @native_team)
))

(module level_spawn_tables
  :header "native/simulation/include/ioj/sim/levels/level_spawn_tables.h"
  :namespace ioj::sim
  (struct LevelSpawnGroups
    (member types array @native_entity_type)
    (member offsets array int32)
    (member counts array @native_level_event_count)
)

  (struct LevelCapitalSpawnEvents
    (member entity_indices array ioj::sim::LevelEntityRef)
    (member locations nested @native_vectors_3f)
    (member rotations nested @native_rotators_3f)
    (member teams array @native_team)
    (member healths array @native_health)
    (member initial_fighter_spawn_delays array @settings_nonnegative_float)
    (member fighter_spawn_cooldowns array @settings_nonnegative_float)
)

  (struct LevelTurretSpawnEvents
    (member entity_indices array ioj::sim::LevelEntityRef)
    (member locations nested @native_vectors_3f)
    (member rotations nested @native_rotators_3f)
    (member teams array @native_team)
    (member healths array @native_health)
    (member laser_damages array @settings_nonnegative_int)
)

  (struct LevelSpinnerSpawnEvents
    (member entity_indices array ioj::sim::LevelEntityRef)
    (member locations nested @native_vectors_3f)
    (member yaws array float)
    (member initial_fire_point_indices array @settings_nonnegative_int)
))
