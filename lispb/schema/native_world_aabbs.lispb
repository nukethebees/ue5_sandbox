(soa-module native_world_aabbs
  :header "native/simulation/include/ioj/sim/world_aabbs.h"
  :backend standard-library
  :namespace ioj::sim::collision
  (struct WorldAABBsColumns
    :operations (all)
    (member min_xs array float)
    (member min_ys array float)
    (member min_zs array float)
    (member max_xs array float)
    (member max_ys array float)
    (member max_zs array float)
    (single-allocation WorldAABBs)))
