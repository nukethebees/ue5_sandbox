(module fighter_navigation_types
  :header "native/simulation/include/ioj/sim/fighters/fighter_navigation_types.h"
  :header-include "ioj/sim/fighters/fighter_navigation_types.h"
  :namespace ioj::sim::fighters
  (enum NavigationRiskTier @native_uint8
    :enum-array true
    (value Clear :value "0")
    (value Nearby :value "1")
    (value Active :value "2")
    (value Immediate :value "3")
    (projections (cpp)))
  ; Store the four navigation risk levels in two bits.
  (integer-scalar NavigationRiskCode
    :signed false :minimum 0 :maximum 3 :bit-width 2
    (projections (cpp :storage std::uint8_t)))
  ; Update counters deliberately retain their full wrapping uint8 domain.
  (integer-scalar NavigationScanCount
    :signed false :minimum 0 :maximum 255 :bit-width 8
    (projections (cpp :storage std::uint8_t)))
  (integer-scalar AvoidanceChoice
    :signed true :minimum 0 :maximum 7 :bit-width 8
    (code DirectMovement :value -1 :sentinel true)
    (code StopMovement :value -2 :sentinel true)
    (projections (cpp :storage std::uint8_t))))
