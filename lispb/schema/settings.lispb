(module launch_display_mode
  :header "native/levels/lib/include/ioj/settings/launch_display_mode.h"
  :header-include "ioj/settings/launch_display_mode.h"
  :namespace ioj
  (enum LaunchDisplayMode @native_uint8
    :description "Selects the display policy for this launch."
    :native-api true
    (value Preferences)
    (value Windowed)
    (value Borderless)
    (value Headless)
    (projections (cpp))))

(module mission_startup
  :header "native/sandbox_host/include/ioj/host/mission_startup.h"
  :header-include "ioj/host/mission_startup.h"
  :namespace ioj
  (enum MissionStartup @native_uint8
    :description "Reports whether the requested mission has reached simulation readiness."
    :native-api true
    (value Pending)
    (value Ready)
    (value Failed)
    (projections (cpp))))

(module game_window_mode
  :header "native/levels/lib/include/ioj/settings/game_window_mode.h"
  :header-include "ioj/settings/game_window_mode.h"
  :namespace ioj
  (enum GameWindowMode @native_uint8
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value Windowed :serialized-name "windowed")
    (value Borderless :serialized-name "borderless")
    (value Fullscreen :serialized-name "fullscreen")
    (projections (cpp))))

(module game_quality_level
  :header "native/levels/lib/include/ioj/settings/game_quality_level.h"
  :header-include "ioj/settings/game_quality_level.h"
  :namespace ioj
  (enum GameQualityLevel @native_uint8
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value Low :serialized-name "low")
    (value Medium :serialized-name "medium")
    (value High :serialized-name "high")
    (value Epic :serialized-name "epic")
    (projections (cpp))))

(module game_anti_aliasing_method
  :header "native/levels/lib/include/ioj/settings/game_anti_aliasing_method.h"
  :header-include "ioj/settings/game_anti_aliasing_method.h"
  :namespace ioj
  (enum GameAntiAliasingMethod @native_uint8
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value Off :serialized-name "off")
    (value FXAA :serialized-name "fxaa")
    (value TAA :serialized-name "taa")
    (value TSR :serialized-name "tsr")
    (value SMAA :serialized-name "smaa")
    (projections (cpp))))

(module screen_resolution
  :header "native/levels/lib/include/ioj/settings/screen_resolution.h"
  :header-include "ioj/settings/screen_resolution.h"
  :namespace ioj
  (record ScreenResolution :comparison equality :generate-s7-reader true :generate-s7-writer true
    :s7-tag "resolution" :s7-positional true
    (member width std::int32_t :initializer "" :positive true)
    (member height std::int32_t :initializer "" :positive true)
    (projections (cpp))))

(module application_settings
  :header "native/levels/lib/include/ioj/settings/application_settings.h"
  :header-include "ioj/settings/application_settings.h"
  :namespace ioj
  (record ApplicationSettings :generate-visitor true :generate-s7-reader true :s7-tag "application"
    (member unlock_all_missions bool :initializer "" :required true)
    (member start_levels_paused bool :initializer "" :required true)
    (member show_collision bool :initializer "" :required true)
    (member pause_pie_on_start bool :initializer "" :required true)
    (member print_save_data bool :initializer "" :required true)
    (member export_test_results bool :initializer "" :required true)
    (member frame_log_footer bool :initializer "" :required true)
    (projections (cpp))))
(module video_settings
  :header "native/levels/lib/include/ioj/settings/video_settings.h"
  :header-include "ioj/settings/video_settings.h"
  :namespace ioj
  (record VideoSettings :comparison equality
    (member resolution @int_point :initializer "")
    (member window_mode @game_window_mode :initializer "")
    (member vsync bool :initializer "")
    (member frame_rate_limit float :initializer "")
    (member resolution_scale float :initializer "")
    (member overall_quality @game_graphics_preset :initializer "")
    (member view_distance_quality @game_quality_level :initializer "")
    (member aa_method @game_anti_aliasing_method :initializer "")
    (member aa_quality @game_quality_level :initializer "")
    (member shadow_quality @game_quality_level :initializer "")
    (member global_illumination_quality @game_quality_level :initializer "")
    (member reflections_quality @game_quality_level :initializer "")
    (member post_processing_quality @game_quality_level :initializer "")
    (member texture_quality @game_quality_level :initializer "")
    (member effects_quality @game_quality_level :initializer "")
    (member shading_quality @game_quality_level :initializer "")
    (member bloom bool :initializer "")
    (member motion_blur bool :initializer "")
    (projections (cpp))))

(module audio_settings
  :header "native/levels/lib/include/ioj/settings/audio_settings.h"
  :header-include "ioj/settings/audio_settings.h"
  :namespace ioj
  (record AudioSettings :comparison equality
    (member master_volume float :initializer "")
    (member music_volume float :initializer "")
    (member sfx_volume float :initializer "")
    (member ui_volume float :initializer "")
    (projections (cpp))))

(module controls_settings
  :header "native/levels/lib/include/ioj/settings/controls_settings.h"
  :header-include "ioj/settings/controls_settings.h"
  :namespace ioj
  (record ControlsSettings :comparison equality
    (member mouse_turn_sensitivity float :initializer "")
    (member gamepad_turn_sensitivity float :initializer "")
    (member gamepad_turn_dead_zone float :initializer "")
    (member invert_mouse_pitch bool :initializer "")
    (member invert_mouse_yaw bool :initializer "")
    (member invert_gamepad_pitch bool :initializer "")
    (member invert_gamepad_yaw bool :initializer "")
    (projections (cpp))))

(module game_settings_state
  :header "native/levels/lib/include/ioj/settings/game_settings_state.h"
  :header-include "ioj/settings/game_settings_state.h"
  :namespace ioj
  (record GameSettingsState :comparison equality :generate-visitor true
    :generate-s7-reader true :generate-s7-writer true :s7-tag "user-settings"
    :s7-reader-includes ("ioj/settings/screen_resolution_reader.h")
    :s7-writer-includes ("ioj/settings/screen_resolution_writer.h")
    (member resolution @int_point :initializer "")
    (member window_mode @game_window_mode :initializer "" :required true)
    (member vsync bool :initializer "" :required true)
    (member frame_rate_limit float :initializer "" :required true :finite true :minimum 0)
    (member resolution_scale float :initializer "" :required true :finite true :minimum 50 :maximum 100)
    (member overall_quality @game_graphics_preset :initializer "" :s7-exclude true)
    (member view_distance_quality @game_quality_level :initializer "" :required true)
    (member aa_method @game_anti_aliasing_method :initializer "" :required true)
    (member aa_quality @game_quality_level :initializer "" :required true)
    (member shadow_quality @game_quality_level :initializer "" :required true)
    (member global_illumination_quality @game_quality_level :initializer "" :required true)
    (member reflections_quality @game_quality_level :initializer "" :required true)
    (member post_processing_quality @game_quality_level :initializer "" :required true)
    (member texture_quality @game_quality_level :initializer "" :required true)
    (member effects_quality @game_quality_level :initializer "" :required true)
    (member shading_quality @game_quality_level :initializer "" :required true)
    (member bloom bool :initializer "" :required true)
    (member motion_blur bool :initializer "" :required true)
    (member master_volume float :initializer "" :required true :finite true :minimum 0 :maximum 1)
    (member music_volume float :initializer "" :required true :finite true :minimum 0 :maximum 1)
    (member sfx_volume float :initializer "" :required true :finite true :minimum 0 :maximum 1)
    (member ui_volume float :initializer "" :required true :finite true :minimum 0 :maximum 1)
    (member mouse_turn_sensitivity float :initializer "" :required true :finite true :minimum 0.01 :maximum 2.0)
    (member gamepad_turn_sensitivity float :initializer "" :required true :finite true :minimum 0.25 :maximum 2.0)
    (member gamepad_turn_dead_zone float :initializer "" :required true :finite true :minimum 0.0 :maximum 0.5)
    (member invert_mouse_pitch bool :initializer "" :required true)
    (member invert_mouse_yaw bool :initializer "" :required true)
    (member invert_gamepad_pitch bool :initializer "" :required true)
    (member invert_gamepad_yaw bool :initializer "" :required true)
    (projections (cpp))))

(settings-module game_settings
  :header "native/levels/lib/include/ioj/settings/game_settings.h"
  :source "native/levels/lib/src/game_settings.cpp"
  :header-include "ioj/settings/game_settings.h"
  :namespace ioj
  :api-name GameSettingsAccess
  :storage GameSettingsState
  (category video "Video")
  (category gameplay "Gameplay")
  (category audio "Audio")
  (category controls "Controls")
  (category accessibility "Accessibility")
  (setting resolution "Resolution"
    :tooltip "Display resolution."
    :category video
    :backend game_user_settings
    :apply confirm
    (control choice
      :options-provider supported_resolutions))
  (setting window_mode "Window Mode"
    :category video
    :backend game_user_settings
    :apply confirm
    (control choice
      :options-provider window_modes))
  (setting vsync "VSync"
    :category video
    :backend game_user_settings
    :apply deferred
    (control toggle))
  (setting frame_rate_limit "Frame Rate Limit"
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider frame_rate_limits))
  (setting resolution_scale "Resolution Scale"
    :tooltip "Internal rendering resolution as a percentage of the display resolution."
    :category video
    :backend game_user_settings
    :apply deferred
    (control float-range
      :min 50
      :max 100
      :step 1))
  (setting overall_quality "Overall Quality"
    :tooltip "Set the player-facing graphics quality groups together. Resolution scale, anti-aliasing method, bloom, and motion blur remain independent."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider graphics_presets))
  (setting view_distance_quality "View Distance Quality"
    :tooltip "Controls how far detailed objects remain visible."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting aa_method "Anti-Aliasing Method"
    :tooltip "Select the technique used to smooth jagged edges."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider aa_methods))
  (setting aa_quality "Anti-Aliasing Quality"
    :tooltip "Controls the quality of the selected anti-aliasing method."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels
      :availability-provider aa_quality))
  (setting shadow_quality "Shadow Quality"
    :tooltip "Controls shadow resolution and rendering distance."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting global_illumination_quality "Global Illumination Quality"
    :tooltip "Controls indirect lighting quality."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting reflections_quality "Reflections Quality"
    :tooltip "Controls reflection detail and accuracy."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting post_processing_quality "Post Processing Quality"
    :tooltip "Controls the quality of screen-space visual effects."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting texture_quality "Texture Quality"
    :tooltip "Controls texture detail and streaming quality."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting effects_quality "Effects Quality"
    :tooltip "Controls particle and visual-effects quality."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting shading_quality "Shading Quality"
    :tooltip "Controls material and lighting shading quality."
    :category video
    :backend game_user_settings
    :apply deferred
    (control choice
      :options-provider quality_levels))
  (setting bloom "Bloom"
    :tooltip "Allow bright areas to glow."
    :category video
    :backend game_user_settings
    :apply deferred
    (control toggle))
  (setting motion_blur "Motion Blur"
    :tooltip "Blur moving objects and camera motion."
    :category video
    :backend game_user_settings
    :apply deferred
    (control toggle))
  (setting master_volume "Master Volume"
    :category audio
    :backend audio
    :apply immediate
    (control float-range
      :min 0
      :max 1
      :step 0.01))
  (setting music_volume "Music Volume"
    :category audio
    :backend audio
    :apply immediate
    (control float-range
      :min 0
      :max 1
      :step 0.01))
  (setting sfx_volume "SFX Volume"
    :category audio
    :backend audio
    :apply immediate
    (control float-range
      :min 0
      :max 1
      :step 0.01))
  (setting ui_volume "UI Volume"
    :category audio
    :backend audio
    :apply immediate
    (control float-range
      :min 0
      :max 1
      :step 0.01))
  (setting mouse_turn_sensitivity "Mouse Sensitivity"
    :tooltip "Mouse virtual-stick sensitivity multiplier. 1.0 reaches full deflection after 400 mouse counts."
    :category controls
    :backend input
    :apply immediate
    :device keyboard-mouse
    (control float-range
      :min 0.01
      :max 2.0
      :step 0.01))
  (setting gamepad_turn_sensitivity "Controller Sensitivity"
    :tooltip "Controller turning sensitivity."
    :category controls
    :backend input
    :apply immediate
    :device controller
    (control float-range
      :min 0.25
      :max 2.0
      :step 0.05))
  (setting gamepad_turn_dead_zone "Turn Stick Dead Zone"
    :tooltip "Inner dead zone for the stick controlling turning or aiming."
    :category controls
    :backend input
    :apply immediate
    :device controller
    (control float-range
      :min 0.0
      :max 0.5
      :step 0.01))

  (setting invert_mouse_pitch "Invert Mouse Pitch"
    :tooltip "Reverse mouse pitch. Independent of controller inversion."
    :category controls
    :backend input
    :apply immediate
    :device keyboard-mouse
    (control toggle))
  (setting invert_mouse_yaw "Invert Mouse Yaw"
    :tooltip "Reverse mouse yaw. Independent of controller inversion."
    :category controls
    :backend input
    :apply immediate
    :device keyboard-mouse
    (control toggle))
  (setting invert_gamepad_pitch "Invert Controller Pitch"
    :tooltip "Reverse controller pitch. Off: stick up pitches up. On: stick up pitches down."
    :category controls
    :backend input
    :apply immediate
    :device controller
    (control toggle))
  (setting invert_gamepad_yaw "Invert Controller Yaw"
    :tooltip "Reverse controller yaw, regardless of which stick is bound."
    :category controls
    :backend input
    :apply immediate
    :device controller
    (control toggle))

)
