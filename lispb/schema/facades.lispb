(facade-module test_capital_ship_fighters_command_interface
  :header "native/simulation/include/sandbox/simulation/ships/fighters/TestCapitalShipFightersCommandInterface.h"
  :namespace ml::test_capital_ship_fighters
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade CommandInterface @test_fighters fighters
    :target-storage reference
    (method queue_spawns "std::int32_t"
      (parameter queue @fighter_spawn_queue_const_view))
    (method queue_orders void
      (parameter queue (type-ref @fighter_order_queue :suffix " const&")))
    (method self_destruct_fighter void
      (parameter handle (type-ref @native_registry_handle :suffix " const")))
    (method get_new_spawn_entity_data (type-ref @test_fighters :suffix " const&" :nested "RegistryEntityData")
      :const true)
    (method get_new_spawn_entity_handles (type-ref @spawned_entity_handles :suffix " const&")
      :const true)
    (method get_num_instances "std::int32_t"
      :const true
      :noexcept true)
    (method get_handles "std::span<FRegistryEntityHandle const>"
      :const true
      :noexcept true)
    (method get_target_handles "std::span<FRegistryEntityHandle const>"
      :const true
      :noexcept true)))

