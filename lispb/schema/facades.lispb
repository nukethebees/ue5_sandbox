(module player_command_interface
  :header "native/simulation/include/ioj/sim/player/command_interface.h"
  :namespace ioj::sim::player
  (facade CommandInterface @player_sim simulation
    :target-storage reference
    (method set_config void :noexcept true
      (parameter config "PlayerSimConfig const&"))
    (method set_team void :noexcept true
      (parameter team @native_team))
    (method set_speed_sampling_enabled void :noexcept true
      (parameter enabled bool))
    (method set_forward_input void :noexcept true
      (parameter input float))
    (method set_right_input void :noexcept true
      (parameter input float))
    (method set_up_input void :noexcept true
      (parameter input float))
    (method set_pitch_input void :noexcept true (parameter input float))
    (method set_yaw_input void :noexcept true (parameter input float))
    (method set_roll_input void :noexcept true (parameter input float))
    (method set_accelerator void :noexcept true (parameter input float))
    (method start_boost void)
    (method stop_boost void)
    (method start_brake void)
    (method start_emergency_brake void)
    (method stop_emergency_brake void)
    (method stop_brake void)
    (method select_flight_model_slot void :noexcept true
      (parameter slot "FlightModelSlot"))
    (method set_flight_model_slot_profile bool :noexcept true
      (parameter slot "FlightModelSlot")
      (parameter profile "FlightModelProfile"))
    (method start_fire_laser void)
    (method stop_fire_laser void)
    (method upgrade_laser void :noexcept true)
    (method select_next_laser_fire_rate void :noexcept true)
    (method select_previous_laser_fire_rate void :noexcept true)
    (method set_laser_fire_rate void :noexcept true
      (parameter rate "ShipFireRate"))
    (method add_health void (parameter added_health @native_health))
    (method consume_death_notification bool :noexcept true)))

(module player_phase_interface
  :header "native/simulation/include/ioj/sim/player/phase_interface.h"
  :namespace ioj::sim::player
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade PhaseInterface @player_sim simulation
    :bind-access private
    :method-access private
    :friends ("sim::LevelSim")
    :friend-kind struct
    :target-storage reference
    (method initialise void
      (parameter spawn (type-ref @player_spawn_data :suffix " const&")))
    (method prepare_tick void
      (parameter dt "float const"))
    (method think void
      (parameter dt "float const"))
    (method apply_movement void
      (parameter inputs (type-ref @player_action_inputs :suffix " const")))
    (method generate_fire_commands void)
    (method resolve_damage_events void
      (parameter inputs (type-ref @player_resolution_inputs :suffix " const")))))

(module lasers_phase_interface
  :header "native/simulation/include/ioj/sim/lasers/phase_interface.h"
  :namespace ioj::sim::lasers
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade PhaseInterface @lasers_sim simulation
    :bind-access private
    :method-access private
    :friends ("sim::LevelSim")
    :friend-kind struct
    :target-storage reference
    (method initialise void
      (parameter config (type-ref ioj::sim::LaserSimConfig :suffix " const&")))
    (method simulate void
      (parameter inputs (type-ref @lasers_action_inputs :suffix " const")))
    (method commit_spawns void)
    (method cleanup_entities void)
    (method finish_action void)))

(module capital_ships_phase_interface
  :header "native/simulation/include/ioj/sim/capital_ships/phase_interface.h"
  :namespace ioj::sim::capital_ships
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade PhaseInterface @capital_ships_sim simulation
    :bind-access private
    :method-access private
    :friends ("sim::LevelSim")
    :friend-kind struct
    :target-storage reference
    (method initialise void
      (parameter max_health @settings_positive_health))
    (method prepare_tick void)
    (method resolve_damage_events void
      (parameter inputs (type-ref @capital_ships_resolution_inputs :suffix " const")))
    (method publish_deaths void
      (parameter inputs (type-ref @capital_ships_resolution_inputs :suffix " const")))
    (method remove_components void)
    (method remove_entities void)
    (method finish_action void)))

(module fighters_phase_interface
  :header "native/simulation/include/ioj/sim/fighters/phase_interface.h"
  :namespace ioj::sim::fighters
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade PhaseInterface @fighters_sim simulation
    :bind-access private
    :method-access private
    :friends ("sim::LevelSim")
    :friend-kind struct
    :target-storage reference
    (method initialise void
      (parameter config (type-ref ioj::sim::FighterSimConfig :suffix " const&"))
      (parameter level_data @fighter_level_data))
    (method update_entity_lookup_table void)
    (method prepare_tick void)
    (method think void
      (parameter inputs (type-ref @fighters_thinking_inputs :suffix " const")))
    (method apply_movement void
      (parameter inputs (type-ref @fighters_action_inputs :suffix " const")))
    (method generate_fire_commands void
      (parameter inputs (type-ref @fighters_thinking_inputs :suffix " const")))
    (method commit_spawns void
      (parameter inputs (type-ref @fighters_preparation_inputs :suffix " const")))
    (method resolve_damage_events void
      (parameter inputs (type-ref @fighters_resolution_inputs :suffix " const")))
    (method publish_deaths void
      (parameter inputs (type-ref @fighters_resolution_inputs :suffix " const")))
    (method remove_components void)
    (method remove_entities void)
    (method finish_action void)))

