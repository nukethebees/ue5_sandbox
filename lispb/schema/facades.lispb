(facade-module fighters_command_interface
  :header "native/simulation/include/ioj/sim/fighters/command_interface.h"
  :namespace ioj::sim::fighters
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade CommandInterface @fighters_sim fighters
    :target-storage reference
    (method queue_spawns "std::int32_t"
      (parameter queue @fighter_spawn_queue_const_view))
    (method queue_orders void
      (parameter queue (type-ref @fighter_order_queue :suffix " const&")))
    (method self_destruct_fighter void
      (parameter handle (type-ref @native_registry_handle :suffix " const")))
    (method get_new_spawn_entity_data (type-ref @fighters_sim :suffix " const&" :nested "RegistryEntityData")
      :const true)
    (method get_new_spawn_entity_handles (type-ref @spawned_entity_handles :suffix " const&")
      :const true)
    (method get_num_instances "std::int32_t"
      :const true
      :noexcept true)
    (method get_handles "std::span<ioj::sim::RegistryEntityHandle const>"
      :const true
      :noexcept true)
    (method get_target_handles "std::span<ioj::sim::RegistryEntityHandle const>"
      :const true
      :noexcept true)))

(facade-module player_phase_interface
  :header "native/simulation/include/ioj/sim/player/phase_interface.h"
  :source "native/simulation/src/player/phase_interface.cpp"
  :header-include "ioj/sim/player/phase_interface.h"
  :namespace ioj::sim::player
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade PhaseInterface @player_sim simulation
    :method-access private
    :friends ("::ioj::sim::LevelSim")
    :friend-kind struct
    :definitions-in-source true
    :target-storage reference
    (method begin_play void)
    (method update_timers void
      (parameter dt "float const"))
    (method move void
      (parameter dt "float const"))
    (method queue_commands void)
    (method resolve_damage_events void)
    (method update_entity_registry void)))

