(facade-module fighters_command_interface
  :header "native/simulation/include/ioj/sim/fighters/command_interface.h"
  :namespace ioj::sim::fighters
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade CommandInterface @fighters_sim fighters
    :target-storage reference
    (method queue_spawns "std::int32_t"
      (parameter queue @fighter_spawn_queue_const_view))
    (method queue_orders void
      (parameter queue (type-ref @fighter_order_queue :suffix " const&")))
    (method self_destruct_fighter void
      (parameter handle (type-ref @native_registry_handle :suffix " const")))
    (method get_new_spawn_entity_data "RegistryEntityDataConstView"
      :const true)
    (method get_new_spawn_entity_handles (type-ref @spawned_entity_handles :suffix " const&")
      :const true)
    (method get_num_instances "std::int32_t"
      :const true
      :noexcept true)
    (method get_handles "std::span<RegistryEntityHandle const>"
      :const true
      :noexcept true)
    (method get_parent_ids "std::span<EntityUniqueId const>" :const true)
    (method get_healths "std::span<Health const>" :const true)
    (method set_parent_id void
      (parameter fighter @native_registry_handle)
      (parameter parent @native_unique_id))
    (method get_target_ids "std::span<EntityUniqueId const>"
      :const true
      :noexcept true)))

(facade-module player_command_interface
  :header "native/simulation/include/ioj/sim/player/command_interface.h"
  :namespace ioj::sim::player
  (facade CommandInterface @player_sim simulation
    :target-storage reference
    (method set_config void :noexcept true
      (parameter config "PlayerSimConfig const&"))
    (method set_team void :noexcept true
      (parameter team @native_team))
    (method set_speed_sampling_enabled void :noexcept true
      (parameter enabled bool))
    (method set_move_input void :noexcept true
      (parameter input "ml::Vector2d"))
    (method set_lateral_move_input void :noexcept true
      (parameter input float))
    (method set_vertical_move_input void :noexcept true
      (parameter input float))
    (method set_ship_2d_control void (parameter input "ml::Vector2d"))
    (method set_ship_1d_control_x void (parameter input float))
    (method set_ship_1d_control_y void (parameter input float))
    (method select_next_control_mode void)
    (method select_previous_control_mode void)
    (method start_sampling void :noexcept true)
    (method stop_sampling void)
    (method adjust_desired_forward_velocity void (parameter direction float))
    (method turn void :noexcept true (parameter direction "ml::Vector2d"))
    (method start_boost void)
    (method stop_boost void)
    (method start_brake void)
    (method stop_brake void)
    (method roll void :noexcept true (parameter direction float))
    (method set_flight_mode void :noexcept true
      (parameter mode "SpaceShipFlightMode"))
    (method start_fire_laser void)
    (method stop_fire_laser void)
    (method upgrade_laser void :noexcept true)
    (method select_next_laser_fire_rate void :noexcept true)
    (method select_previous_laser_fire_rate void :noexcept true)
    (method set_laser_fire_rate void :noexcept true
      (parameter rate "ShipFireRate"))
    (method add_health void (parameter added_health @native_health))
    (method consume_death_notification bool :noexcept true)))

(facade-module player_phase_interface
  :header "native/simulation/include/ioj/sim/player/phase_interface.h"
  :source "native/simulation/src/player/phase_interface.cpp"
  :header-include "ioj/sim/player/phase_interface.h"
  :namespace ioj::sim::player
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (facade PhaseInterface @player_sim simulation
    :method-access private
    :friends ("sim::LevelSim")
    :friend-kind struct
    :definitions-in-source true
    :target-storage reference
    (method begin_play void)
    (method prepare_tick void
      (parameter dt "float const"))
    (method think void
      (parameter dt "float const"))
    (method apply_movement void)
    (method generate_fire_commands void)
    (method resolve_damage_events void)
    (method update_entity_registry void)))

