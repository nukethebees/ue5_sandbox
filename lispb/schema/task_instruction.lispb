(module task_instruction
  :header "native/simulation/include/ioj/sim/tasks/instruction.h"
  :namespace ioj::sim::tasks
  (enum InstructionKind @native_uint8 :bit-width 8
    :native-api true
    :helpers (to-serialized-string try-parse-serialized)
    (value Kill :value "0" :serialized-name "kill")
    (value Idle :value "1" :serialized-name "idle")
    (value MoveTo :value "2" :serialized-name "move-to")
    (projections (cpp)))
  (record Idle)
  (record MoveTo
    (member location_index std::uint32_t :bits 32))
  (union InstructionData
    (case Kill @native_unique_id)
    (case Idle @Idle)
    (case MoveTo @MoveTo))
  (record Instruction :layout packed :bits 64
    (member kind @InstructionKind)
    (member data @InstructionData :bits 56 :tag kind)
    (projections (cpp :storage std::uint64_t))))
