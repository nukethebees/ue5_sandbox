(module native_level_camera
  :header "native/levels/lib/include/ioj/levels/level_camera_definition.h"
  :header-include "ioj/levels/level_camera_definition.h"
  :namespace ioj::levels
  :prelude ("#include <vector>")
  (record LevelCameraDefinition :generate-s7-reader true :s7-tag "camera"
    :s7-reader-includes ("ioj/levels/authoring/identifier_reader.h")
    (member target_entity_ids @native_entity_ids :initializer "" :required true :s7-name "look-at")
    (member offset_direction @native_vector3d :initializer "" :required true)
    (member distance double :initializer "" :required true)))

(module native_level_collision_grid
  :header "native/levels/lib/include/ioj/levels/level_collision_grid_definition.h"
  :header-include "ioj/levels/level_collision_grid_definition.h"
  :namespace ioj::levels
  :prelude ("#include <optional>")
  (record LevelCollisionGridDefinition :generate-visitor true :generate-s7-reader true :s7-tag "collision-grid"
    (member level_size @native_optional_vector3d :initializer "")
    (member cell_size @native_optional_vector3d :initializer "")))

(module native_campaign
  :header "native/levels/lib/include/ioj/levels/campaign_definition.h"
  :header-include "ioj/levels/campaign_definition.h"
  :namespace ioj::levels
  :prelude ("#include <vector>")
  (record CampaignDefinition :generate-s7-reader true :s7-tag "campaign"
    :s7-reader-includes ("ioj/levels/authoring/identifier_reader.h")
    (member id @native_campaign_id :initializer "" :required true)
    (member title @native_string :initializer "" :required true)
    (member level_ids @native_level_ids :initializer "" :required true :s7-name "levels")))

(module native_team
  :header "native/levels/lib/include/ioj/levels/team.h"
  :header-include "ioj/levels/team.h"
  :namespace ioj
  (enum Team @native_uint8
    :native-api true
    :helpers (to-string traits to-serialized-string try-parse-serialized)
    :enum-array true
    (unreal-projection ETestTeam
      :enum-array true
      :header "Plugins/SpaceGame/Source/SpaceGamePresentation/Public/SpaceGamePresentation/entities/TestTeam.h"
      :header-include "SpaceGamePresentation/entities/TestTeam.h"
      :conversion-header "Plugins/SpaceGame/Source/SpaceGamePresentation/Public/SpaceGamePresentation/entities/TestTeamConversion.h"
      :native-header-include "ioj/levels/team.h"
      :reflection uenum)
    (value White :value "0" :serialized-name "white")
    (value Red :value "1" :serialized-name "red")
    (value Green :value "2" :serialized-name "green")
    (value Blue :value "3" :serialized-name "blue")
    (value Orange :value "4" :serialized-name "orange")
    (value Yellow :value "5" :serialized-name "yellow")))

(module native_team_result
  :header "native/levels/lib/include/ioj/levels/team_result_definition.h"
  :header-include "ioj/levels/team_result_definition.h"
  :namespace ioj::levels
  (record TeamResultDefinition :comparison equality
    :generate-s7-reader true :s7-tag "team-result"
    :s7-reader-includes ("ioj/levels/authoring/input_readers.h")
    (member team ioj::Team :initializer "Team::White" :required true)
    (member when @input_dependency :initializer "" :required true)
    (member result ioj::TeamOutcome :initializer "TeamOutcome::Victory" :required true)))

(module native_objective_dependency
  :header "native/levels/lib/include/ioj/levels/objective_dependency.h"
  :header-include "ioj/levels/objective_dependency.h"
  :namespace ioj::levels
  (record ObjectiveDependency :comparison equality
    :generate-s7-reader true :s7-tag "objective-resolved" :s7-positional true :s7-constructor false
    :s7-reader-includes ("ioj/levels/authoring/identifier_reader.h")
    (member objective @input_objective_name :initializer "")
    (member outcome ioj::ObjectiveOutcome :initializer "ObjectiveOutcome::Passed")))

(module native_levels_entity_archetype
  :header "native/levels/lib/include/ioj/levels/entity_archetype.h"
  :header-include "ioj/levels/entity_archetype.h"
  :namespace ioj::levels
  (enum EntityArchetype std::uint8_t
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value PlayerFighter :serialized-name "player-fighter")
    (value CapitalShip :serialized-name "capital-ship")
    (value StaticTurret :serialized-name "static-turret")))

(module native_levels_diagnostic_code
  :header "native/levels/lib/include/ioj/levels/diagnostic_code.h"
  :header-include "ioj/levels/diagnostic_code.h"
  :namespace ioj::levels
  (enum DiagnosticCode std::uint8_t
    (value MissingLevelId)
    (value MissingTitle)
    (value InvalidParTime)
    (value UnexpectedParTime)
    (value MissingViewpoint)
    (value ConflictingViewpoints)
    (value PlayerEntityNotFound)
    (value UnsupportedTeam)
    (value EmptyArchetypeId)
    (value UnsupportedArchetype)
    (value ArchetypeRoleMismatch)
    (value DuplicateEntityId)
    (value InvalidPlacement)
    (value InvalidSpawnTime)
    (value DelayedPlayerSpawn)
    (value MissingCameraTarget)
    (value DuplicateCameraTarget)
    (value CameraTargetNotFound)
    (value InvalidCameraDistance)
    (value InvalidCameraOffsetDirection)
    (value InvalidLevelSize)
    (value InvalidGridCellSize)
    (value InvalidGridDimensions)
    (value InvalidMissionStructure)
    (value MissingUnlockLevelId)
    (value DuplicateUnlockCriterion)
    (value SelfUnlockDependency)
    (value FileOpenFailed)
    (value FileReadFailed)
    (value ScriptEvaluationFailed)
    (value UnsupportedValue)
    (value ImproperList)
    (value CyclicStructure)
    (value LimitExceeded)
    (value ExpectedRecord)
    (value ExpectedKeyword)
    (value UnknownProperty)
    (value DuplicateProperty)
    (value MissingProperty)
    (value MissingValue)
    (value InvalidType)
    (value InvalidNumber)
    (value UnknownSymbol)
    (value InvalidSymbol)
    (value UnsupportedEditorFeature)
    (value MissingCampaignId)
    (value MissingCampaignLevels)
    (value DuplicateCampaignLevel)
    (value DuplicateLevelId)
    (value DuplicateCampaignId)
    (value UnavailableLevel)
    (value UnlockCycle)))
