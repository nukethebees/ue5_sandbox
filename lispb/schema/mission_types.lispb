(module objective_outcome
  :header "native/levels/lib/include/ioj/levels/objective_outcome.h"
  :header-include "ioj/levels/objective_outcome.h"
  :namespace ioj
  (enum ObjectiveOutcome std::uint8_t
    :native-api true
    :enum-array true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value Passed :serialized-name "passed")
    (value Failed :serialized-name "failed")
    (value Expired :serialized-name "expired")
    (projections
      (cpp)
      (unreal-projection EObjectiveOutcome
        :header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/ObjectiveOutcome.h"
        :header-include "SpaceGame/missions/ObjectiveOutcome.h"
        :conversion-header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/ObjectiveOutcomeConversion.h"
        :native-header-include "ioj/levels/objective_outcome.h"
        :reflection uenum))))

(module objective_wins_level
  :header "native/levels/lib/include/ioj/levels/objective_wins_level.h"
  :header-include "ioj/levels/objective_wins_level.h"
  :namespace ioj
  (enum ObjectiveWinsLevel std::uint8_t
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value No :serialized-name "no")
    (value Yes :serialized-name "yes")
    (projections (cpp))))

(module mission_outcome
  :header "native/levels/lib/include/ioj/levels/mission_outcome.h"
  :header-include "ioj/levels/mission_outcome.h"
  :namespace ioj
  (enum MissionOutcome std::uint8_t
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (value Victory :serialized-name "victory")
    (value Defeat :serialized-name "defeat")
    (projections
      (cpp)
      (unreal-projection EMissionOutcome
        :header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/MissionOutcome.h"
        :header-include "SpaceGame/missions/MissionOutcome.h"
        :conversion-header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/MissionOutcomeConversion.h"
        :native-header-include "ioj/levels/mission_outcome.h"
        :reflection uenum))))

(module expr_result
  :header "native/levels/lib/include/ioj/levels/expr_result.h"
  :header-include "ioj/levels/expr_result.h"
  :namespace ioj
  (enum ExprResult std::uint8_t
    :native-api true :helpers ()
    (value Pending) (value True) (value False)
    (projections (cpp))))

(module expr_type
  :header "native/levels/lib/include/ioj/levels/expr_type.h"
  :header-include "ioj/levels/expr_type.h"
  :namespace ioj::levels
  (enum ExprType std::uint8_t
    :native-api true :helpers (traits to-serialized-string try-parse-serialized)
    (value All :serialized-name "all-of" :groups (composite))
    (value Any :serialized-name "any-of" :groups (composite))
    (value EntityDestroyed :serialized-name "entity-destroyed")
    (value EntityReachedPosition :serialized-name "entity-reached-position")
    (value TimeElapsed :serialized-name "time-elapsed")
    (value ObjectiveResolved :serialized-name "objective-resolved")
    (value EntityKillsReached :serialized-name "entity-kills-reached")
    (projections (cpp))))
