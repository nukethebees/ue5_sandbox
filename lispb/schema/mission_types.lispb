(module mission_types
  :header "native/levels/lib/include/ioj/levels/mission_types.h"
  :header-include "ioj/levels/mission_types.h"
  :namespace ioj
  (enum ObjectiveOutcome std::uint8_t
    :native-api true
    :enum-array true
    :helpers (traits to-serialized-string try-parse-serialized)
    (unreal-projection EObjectiveOutcome
      :header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/ObjectiveOutcome.h"
      :header-include "SpaceGame/missions/ObjectiveOutcome.h"
      :conversion-header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/ObjectiveOutcomeConversion.h"
      :native-header-include "ioj/levels/mission_types.h"
      :reflection uenum)
    (value Passed :serialized-name "passed")
    (value Failed :serialized-name "failed")
    (value Expired :serialized-name "expired"))
  (enum TeamOutcome std::uint8_t
    :native-api true
    :helpers (traits to-serialized-string try-parse-serialized)
    (unreal-projection ETeamOutcome
      :header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/TeamOutcome.h"
      :header-include "SpaceGame/missions/TeamOutcome.h"
      :conversion-header "Plugins/SpaceGame/Source/SpaceGame/Public/SpaceGame/missions/TeamOutcomeConversion.h"
      :native-header-include "ioj/levels/mission_types.h"
      :reflection uenum)
    (value Victory :serialized-name "victory")
    (value Defeat :serialized-name "defeat"))
  (enum ExprResult std::uint8_t
    :native-api true :helpers ()
    (value Pending) (value True) (value False))
  (enum ExprType std::uint8_t
    :native-api true :helpers (traits to-serialized-string try-parse-serialized)
    (value All :serialized-name "all-of")
    (value Any :serialized-name "any-of")
    (value EntityDestroyed :serialized-name "entity-destroyed")
    (value EntityReachedPosition :serialized-name "entity-reached-position")
    (value TimeElapsed :serialized-name "time-elapsed")
    (value ObjectiveResolved :serialized-name "objective-resolved")
    (value EntityKillsReached :serialized-name "entity-kills-reached")))
