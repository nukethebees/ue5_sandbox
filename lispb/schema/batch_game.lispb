(module fighters_soa
  :header "native/simulation/include/ioj/sim/fighters/fighter_entity_data.h"
  :namespace ioj::sim
  (struct FighterEntityData
    (member entity_ids array @native_unique_id)
    (member integral_biases array uint32)
    (member float_biases array float)
    (member tasks array @native_fighter_task)
    (member locations nested @native_vectors_3f)
    (member desired_move_locations nested @native_vectors_3f)
    (member aim_directions nested @native_vectors_3f)
    (member planned_aim_directions nested @native_vectors_3f)
    (member desired_aiming_directions nested @native_vectors_3f)
    (member movement_directions nested @native_vectors_3f)
    (member velocities nested @native_vectors_3f)
    (member move_distances array float)
    (member speeds array float)
    (member teams array @native_team)
    (member parent_ids array @native_unique_id)
    (member awareness_scan_countdowns array int8)
    (member navigation_update_countdowns_remaining_ticks array int16)
    (member navigation_update_countdowns_periods array int16)
    (member separation_steering nested @native_vectors_3f)
    (member navigation_risk_tiers array @native_navigation_risk_code)
    (member navigation_lower_risk_scan_counts array @native_navigation_scan_count)
    (member avoidance_choice_indices array @native_avoidance_choice)
    (member avoidance_clear_scan_counts array @native_navigation_scan_count)
    (member attack_reposition_countdowns array int16)
    (member attack_cooldowns array int16)
    (member target_ids array @native_unique_id)
    (member target_locations nested @native_vectors_3f)
    (member target_velocities nested @native_vectors_3f)
    (member target_directions nested @native_vectors_3f)
    (member intercept_times array float)
    (member target_distance_sq array float)
    (member target_distances array float)
    (member target_radii array float)
))

