(soa-module lasers_soa
  :header "native/simulation/include/ioj/sim/laser_soa.h"
  :backend standard-library
  :namespace ioj::sim::lasers
  (struct Vectors3f
    :layout-only true
    :equivalent-type @native_vector_3f
    (member xs array float)
    (member ys array float)
    (member zs array float))
  (struct Rotators3f
    :layout-only true
    :equivalent-type @native_rotator_3f
    (member pitches array float)
    (member yaws array float)
    (member rolls array float))
  (struct SpawnRequests
    :operations (all)
    (member locations nested @native_vectors_3f :nested-schema Vectors3f)
    (member rotations nested @native_rotators_3f :nested-schema Rotators3f)
    (member base_velocities nested @native_vectors_3f :nested-schema Vectors3f)
    (member damages array int32)
    (member speeds array float)
    (member max_distances array float)
    (member instigator_handles array @native_registry_handle)
    (member sources array @laser_source)
    (single-allocation SingleAllocationLaserSpawnRequests))
  (struct Entities
    :operations (all)
    (member active array uint8)
    (member sources array @laser_source)
    (member locations nested @native_vectors_3f :nested-schema Vectors3f)
    (member rotations nested @native_rotators_3f :nested-schema Rotators3f)
    (member velocities nested @native_vectors_3f :nested-schema Vectors3f)
    (member damages array int32)
    (member lifetimes_remaining array float)
    (member instigator_handles array @native_registry_handle)
    (member initial_lifetimes array float)
    (member spawn_times array float)
    (single-allocation SingleAllocationLaserEntities)))

