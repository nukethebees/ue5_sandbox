(soa-module fighters_soa
  :header "native/simulation/include/ioj/sim/fighter_entity_data.h"
  :backend standard-library
  :namespace ioj::sim
  (struct Vectors3f
    :layout-only true
    (member xs array float)
    (member ys array float)
    (member zs array float))
  (struct Rotators3f
    :layout-only true
    (member pitches array float)
    (member yaws array float)
    (member rolls array float))
  (struct FighterEntityData
    :operations (all)
    (member entity_ids array @native_unique_id)
    (member entity_handles array @native_registry_handle)
    (member integral_biases array uint32)
    (member float_biases array float)
    (member tasks array @native_fighter_task)
    (member locations nested @native_vectors_3f :nested-schema Vectors3f)
    (member desired_move_locations nested @native_vectors_3f :nested-schema Vectors3f)
    (member aim_directions nested @native_vectors_3f :nested-schema Vectors3f)
    (member planned_aim_directions nested @native_vectors_3f :nested-schema Vectors3f)
    (member desired_aiming_directions nested @native_vectors_3f :nested-schema Vectors3f)
    (member movement_directions nested @native_vectors_3f :nested-schema Vectors3f)
    (member velocities nested @native_vectors_3f :nested-schema Vectors3f)
    (member move_distances array float)
    (member speeds array float)
    (member teams array @native_team)
    (member healths array @native_health)
    (member parent_handles array @native_registry_handle)
    (member awareness_scan_countdowns array int8)
    (member navigation_update_countdowns_remaining_ticks array int16)
    (member navigation_update_countdowns_periods array int16)
    (member separation_steering nested @native_vectors_3f :nested-schema Vectors3f)
    (member navigation_risk_tiers array uint8)
    (member navigation_lower_risk_scan_counts array uint8)
    (member avoidance_choice_indices array int8)
    (member avoidance_clear_scan_counts array uint8)
    (member attack_reposition_countdowns array int16)
    (member attack_cooldowns array int16)
    (member target_handles array @native_registry_handle)
    (member target_locations nested @native_vectors_3f :nested-schema Vectors3f)
    (member target_velocities nested @native_vectors_3f :nested-schema Vectors3f)
    (member target_directions nested @native_vectors_3f :nested-schema Vectors3f)
    (member intercept_times array float)
    (member target_distance_sq array float)
    (member target_distances array float)
    (member target_radii array float)
    (single-allocation SingleAllocationFighterEntityData)))

