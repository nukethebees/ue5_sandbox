(enum-module native_team
  :header "native/simulation/include/ioj/sim/team.h"
  :namespace ioj::sim
  (enum Team @native_uint8
    :native-api true
    :count COUNT
    (unreal-projection ETestTeam
      :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/entities/TestTeam.h"
      :header-include "SpaceGameSimulation/entities/TestTeam.h"
      :conversion-header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/entities/TestTeamConversion.h"
      :native-header-include "ioj/sim/team.h"
      :reflection uenum)
    (value White :value "0" :serialized-name "white")
    (value Red :value "1" :serialized-name "red")
    (value Green :value "2" :serialized-name "green")
    (value Blue :value "3" :serialized-name "blue")
    (value Orange :value "4" :serialized-name "orange")
    (value Yellow :value "5" :serialized-name "yellow")
    (value COUNT :value "6" :hidden true :display-name "Count" :serialized-name "count")))

(enum-module native_mission_mode
  :header "native/simulation/include/ioj/sim/missions/mission_mode.h"
  :namespace ioj::sim
  (enum MissionMode @native_uint8
    :native-api true
    (unreal-projection ETestMissionMode
      :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/missions/TestMissionMode.h"
      :header-include "SpaceGameSimulation/missions/TestMissionMode.h"
      :conversion-header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/missions/TestMissionModeConversion.h"
      :native-header-include "ioj/sim/missions/mission_mode.h"
      :reflection uenum)
    (value None :value "0" :serialized-name "none")
    (value SurviveTime :value "1" :display-name "Survive Time" :serialized-name "survive_time")
    (value KillEnemies :value "2" :display-name "Kill Enemies" :serialized-name "kill_enemies")
    (value KillEnemiesWithinTime :value "3" :display-name "Kill Enemies Within Time" :serialized-name "kill_enemies_within_time")))

(enum-module native_mission_state
  :header "native/simulation/include/ioj/sim/missions/mission_state.h"
  :namespace ioj::sim
  (enum MissionState @native_uint8
    :native-api true
    (unreal-projection ETestMissionState
      :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/missions/TestMissionState.h"
      :header-include "SpaceGameSimulation/missions/TestMissionState.h"
      :conversion-header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/missions/TestMissionStateConversion.h"
      :native-header-include "ioj/sim/missions/mission_state.h"
      :reflection uenum)
    (value NotStarted :value "0" :display-name "Not Started" :serialized-name "not_started")
    (value Running :value "1" :display-name "Running" :serialized-name "running")
    (value Succeeded :value "2" :serialized-name "succeeded")
    (value Failed :value "3" :display-name "Failed" :serialized-name "failed")
    (value Disabled :value "4" :serialized-name "disabled")))

(enum-module native_mission_fail_reason
