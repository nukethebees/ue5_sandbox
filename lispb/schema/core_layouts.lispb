(homogeneous-soa-module sandbox_core_soa_rotators
  :header "Plugins/SandboxCore/Source/SandboxCore/Public/SandboxCore/soa_rotators.h"
  :source "Plugins/SandboxCore/Source/SandboxCore/Private/soa_rotators.cpp"
  :header-include "SandboxCore/soa_rotators.h"
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (layout Rotators
    :components (pitches yaws rolls)
    :input-members (Pitch Yaw Roll)
    :export-specifier SANDBOXCORE_API
    (value-type float f
      :equivalent-type @rotator_3f
      :input-types (@rotator_3f))
    (value-type double d
      :equivalent-type @rotator_3d
      :input-types (@rotator_3d))))
