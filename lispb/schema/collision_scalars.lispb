(module collision_scalars
  :header "native/simulation/include/ioj/sim/collision/collision_scalar_types.h"
  :namespace ioj::sim::collision
  (integer-scalar StaticGeometryIndex
    :signed false
    :minimum 0
    :maximum 4294967294
    :bit-width 32
    (code Invalid :value 4294967295 :sentinel true)
    (projections (cpp :storage std::uint32_t)))
  (integer-scalar CellIndex
    :signed false
    :minimum 0
    :maximum 4294967294
    :bit-width 32
    (code Invalid :value 4294967295 :sentinel true)
    (projections (cpp :storage std::uint32_t)))
  (integer-scalar GridCellCount
    :signed false
    :minimum 0
    :maximum 4294967295
    :bit-width 32
    (projections (cpp :storage std::uint32_t)))
  (integer-scalar SphereInBoundsResult
    :signed false
    :minimum 0
    :maximum 1
    :bit-width 1
    (projections (cpp :storage std::uint8_t))))
