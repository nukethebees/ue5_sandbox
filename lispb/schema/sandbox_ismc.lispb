(module sandbox_ismc_instance_data
  :header "Plugins/SandboxISMC/Source/SandboxISMC/Public/SandboxISMCInstanceData.h"
  :source "Plugins/SandboxISMC/Source/SandboxISMC/Private/SandboxISMCInstanceData.cpp"
  :header-include "SandboxISMCInstanceData.h"
  :namespace ml::sandbox_ismc
  :include-order ("SandboxISMC/" "SandboxCore/")
  (struct InstanceData
    :operations (all)
    :export-specifier SANDBOXISMC_API
    (member positions array @vector_3f_value)
    (member rotations array @quat_4f)))

(module sandbox_ismc_render
  :header "native/core/include/sandbox/core/sandbox_ismc_render.h"
  :header-include "sandbox/core/sandbox_ismc_render.h"
  :backend standard-library
  :namespace ml::sandbox_ismc
  (record Quat32
    (member bits std::uint32_t :initializer ""))
  ; 12-byte GPU ABI: position XYZ, unused padding, then aligned quat32.
  (record PackedTransform
    (member position std::int16_t :count 3 :initializer "")
    (member reserved std::uint16_t :initializer "")
    (member rotation ml::sandbox_ismc::Quat32 :initializer "")))
