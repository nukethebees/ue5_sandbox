(module sandbox_ismc_quat32
  :header "native/ismc/lib/include/ioj/ismc/quat32.h"
  :header-include "ioj/ismc/quat32.h"
  :namespace ioj::ismc
  (record Quat32
    (member bits std::uint32_t :initializer "")
    (projections (cpp))))

(module sandbox_ismc_render
  :header "native/ismc/lib/include/ioj/ismc/render.h"
  :header-include "ioj/ismc/render.h"
  :namespace ioj::ismc
  ; 16-byte GPU ABI: float XYZ followed by quat32.
  (record PackedTransform
    (member position @native_vector_3f :initializer "")
    (member rotation ioj::ismc::Quat32 :initializer "")
    (projections (cpp))))
