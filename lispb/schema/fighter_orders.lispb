(module fighter_orders
  :header "native/simulation/include/ioj/sim/fighters/fighter_orders.h"
  :namespace ioj::sim
  (enum FighterTask @native_uint8
    :native-api true
    :enum-array true
    (value Standby :value "0")
    (value MoveToDestination :value "1")
    (value Attack :value "2")
    (projections (cpp)))
  (integer-scalar FighterOrderBit :bit-width 1)
  (record FighterOrder
    :layout packed :bits 8
    (member task @FighterOrderBit :default 0)
    (member target @FighterOrderBit :default 0)
    (projections (cpp :storage std::uint8_t))))
