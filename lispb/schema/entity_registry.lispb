(soa-module collision_damage_events_soa
  :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/entities/CollisionDamageEventsSoA.h"
  :source "Plugins/SpaceGame/Source/SpaceGameSimulation/Private/entities/CollisionDamageEventsSoA.cpp"
  :header-include "SpaceGameSimulation/entities/CollisionDamageEventsSoA.h"
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  :prelude ("class AActor;" "class UActorComponent;")
  (struct UnresolvedCollisionDamageEvents
    :operations (all)
    :export-specifier SPACEGAMESIMULATION_API
    (member damaged_actors array AActor*)
    (member damage_amounts array int32)
    (member actor_components array UActorComponent*)
    (member hit_items array int32)
    (member instigators array @registry_handle))
  (struct CollisionDamageEvents
    :operations (all)
    :export-specifier SPACEGAMESIMULATION_API
    (member damage_amounts array int32)
    (member actor_components array UActorComponent*)
    (member hit_items array int32)
    (member instigators array @registry_handle)))

(soa-module test_entity_registry_data_soa
  :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/entities/TestEntityRegistryData.h"
  :source "Plugins/SpaceGame/Source/SpaceGameSimulation/Private/entities/TestEntityRegistryData.cpp"
  :header-include "SpaceGameSimulation/entities/TestEntityRegistryData.h"
  :namespace ml::entity_registry
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (struct EntityData
    :operations (all)
    :export-specifier SPACEGAMESIMULATION_API
    (member locations nested @vectors_3f)
    (member velocities nested @vectors_3f)
    (member rotations nested @rotators_f)
    (member radii array float)
    (member healths array int32)
    (member teams array @team)
    (member entity_types array @entity_type)
    (member alive array uint8)
    (function add_disabled void
      :body ("add_uninitialised(count);" "auto view{get_view()};" "auto slice{view.right(count)};" "" "ml::fill(slice.locations, 0.f);" "ml::fill(slice.velocities, 0.f);" "ml::fill(slice.rotations.pitches, 0.f);" "ml::fill(slice.rotations.yaws, 0.f);" "ml::fill(slice.rotations.rolls, 0.f);" "ml::fill(slice.radii, 0.f);" "ml::fill(slice.healths, 0);" "ml::fill(slice.teams, ETestTeam::White);" "ml::fill(slice.entity_types, ETestEntityType::COUNT);" "ml::fill(slice.alive, uint8{0u});")
      :dependencies (array_fill soa_vector_fill)
      :definition-in-source true
      (parameter count "int32 const"))
    (function set_all_alive void
      :body ("ml::fill(alive, uint8{1});")
      :dependencies (array_fill)
      :definition-in-source true)
    (function set_all_velocities void
      :body ("ml::fill(velocities, value);")
      :dependencies (soa_vector_fill)
      :definition-in-source true
      (parameter value "float const"))
    (function set_all_entity_types void
      :body ("ml::fill(entity_types, value);")
      :dependencies (array_fill)
      :definition-in-source true
      (parameter value (type-ref @entity_type :suffix " const")))))
