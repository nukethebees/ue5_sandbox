(soa-module entity_death_info
  :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/entities/EntityDeathInfo.h"
  :source "Plugins/SpaceGame/Source/SpaceGameSimulation/Private/entities/EntityDeathInfo.cpp"
  :header-include "SpaceGameSimulation/entities/EntityDeathInfo.h"
  :include-order ("SpaceGame/" "Sandbox/" "SandboxCore/")
  (struct EntityDeathInfo
    :operations (all)
    :export-specifier SPACEGAMESIMULATION_API
    (member reasons array @death_reason)
    (member victims array @registry_handle)
    (member killers array @registry_handle)
    (function add void
      :body ("reasons.Add(reason);" "victims.Add(victim);" "killers.Add(killer);")
      :definition-in-source true
      (parameter reason (type-ref @death_reason :suffix " const"))
      (parameter victim (type-ref @registry_handle :suffix " const"))
      (parameter killer (type-ref @registry_handle :suffix " const")))
    (function add void
      :body ("add(reason, victim, FRegistryEntityHandle{});")
      :inline true
      (parameter reason (type-ref @death_reason :suffix " const"))
      (parameter victim (type-ref @registry_handle :suffix " const")))))

