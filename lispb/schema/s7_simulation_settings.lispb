(module s7_simulation_settings
  :header "native/simulation/s7/lib/src/generated/simulation_fields.h"
  :header-include "generated/simulation_fields.h"
  :namespace ioj::s7::simulation_fields
  (settings-schema Fields
    :target ioj::s7::SimulationSettingsInput
    :target-header "simulation_settings_input.h"
    (field "tick.tick-rate" "values.clock.tick_rate")
    (field "tick.time-scale" "values.clock.time_scale")
    (field "player-ship.thrust-energy-max" "values.player.thrust_energy_max")
    (field "player-ship.pitch-angle-max" "values.player.pitch_angle_max")
    (field "player-ship.pitch-speed" "values.player.pitch_speed")
    (field "player-ship.yaw-angle-max" "values.player.yaw_angle_max")
    (field "player-ship.yaw-speed" "values.player.yaw_speed")
    (field "player-ship.turn-bank-angle-max" "values.player.turn_bank_angle_max")
    (field "player-ship.turn-bank-speed" "values.player.turn_bank_speed")
    (field "player-ship.health" "values.player_initial.health")
    (field "player-ship.laser-mode" "values.player_initial.laser_mode")
    (field "player-ship.laser-fire-rate" "values.player_initial.laser_fire_rate")
    (section "laser-projectiles" "values.lasers" :record ioj::sim::LaserSimConfig)
    (field "capital-ships.spawn-delay" "values.capital_ships.spawn_delay")
    (field "capital-ships.max-health" "values.capital_ships.max_health")
    (section "fighters" "values.fighters" :record ioj::sim::FighterSimConfig)
    (section "fighters.attack-distance-band" "attack_distance_band" :record ioj::s7::AttackDistanceBandSettings)
    (field "turrets.detection-radius" "values.turrets.detection_radius")
    (field "turrets.target-refresh-frequency" "values.turrets.target_refresh_frequency")
    (field "turrets.max-health" "values.turrets.max_health")
    (field "tube-spinners.yaw-rotation-speed-degrees" "values.spinners.yaw_rotation_speed_degrees")
    (field "collision-grid.level-size" "values.collision_grid_size")
    (field "collision-grid.cell-size" "values.collision_cell_size")
    (section "collision-grid" "values.overlap_response" :record ioj::sim::OverlapResponseConfig)
    (field "hud.player-status-update-period" "values.hud.player_status_update_period")
    (field "hud.entity-count-update-period" "values.hud.entity_count_update_period")
    (field "hud.mission-status-update-period" "values.hud.mission_status_update_period")
    (section "player-ship.laser" "values.player.laser" :record ioj::sim::LaserWeaponSimConfig)
    (section "turrets.laser" "values.turrets.laser" :record ioj::sim::LaserWeaponSimConfig)
    (section "tube-spinners.laser" "values.spinners.laser" :record ioj::sim::LaserWeaponSimConfig)))
