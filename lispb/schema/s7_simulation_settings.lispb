(module s7_simulation_settings
  :header "native/simulation/s7/lib/src/simulation_fields.h"
  :header-include "simulation_fields.h"
  :namespace ioj::s7::simulation_fields
  (settings-schema Fields
    :target ioj::sim::SimulationSettings
    :target-header "ioj/sim/levels/simulation_settings.h"
    (field "tick.tick-rate" "clock.tick_rate")
    (field "tick.time-scale" "clock.time_scale")
    (field "player-ship.thrust-energy-max" "player.thrust_energy_max")
    (field "player-ship.pitch-angle-max" "player.pitch_angle_max")
    (field "player-ship.pitch-speed" "player.pitch_speed")
    (field "player-ship.yaw-angle-max" "player.yaw_angle_max")
    (field "player-ship.yaw-speed" "player.yaw_speed")
    (field "player-ship.turn-bank-angle-max" "player.turn_bank_angle_max")
    (field "player-ship.turn-bank-speed" "player.turn_bank_speed")
    (field "player-ship.health" "player_initial.health")
    (field "player-ship.laser-mode" "player_initial.laser_mode")
    (field "player-ship.laser-fire-rate" "player_initial.laser_fire_rate")
    (section "laser-projectiles" "lasers" :record ioj::sim::LaserSimConfig)
    (field "capital-ships.spawn-delay" "capital_ships.spawn_delay")
    (field "capital-ships.max-health" "capital_ships.max_health")
    (section "fighters" "fighters" :record ioj::sim::FighterSimConfig)
    (field "turrets.detection-radius" "turrets.detection_radius")
    (field "turrets.target-refresh-frequency" "turrets.target_refresh_frequency")
    (field "turrets.max-health" "turrets.max_health")
    (field "tube-spinners.yaw-rotation-speed-degrees" "spinners.yaw_rotation_speed_degrees")
    (field "collision-grid.level-size" "collision_grid_size")
    (field "collision-grid.cell-size" "collision_cell_size")
    (section "collision-grid" "overlap_response" :record ioj::sim::OverlapResponseConfig)
    (field "hud.player-status-update-period" "hud.player_status_update_period")
    (field "hud.entity-count-update-period" "hud.entity_count_update_period")
    (field "hud.mission-status-update-period" "hud.mission_status_update_period")
    (section "player-ship.laser" "player.laser" :record ioj::sim::LaserWeaponSimConfig)
    (section "turrets.laser" "turrets.laser" :record ioj::sim::LaserWeaponSimConfig)
    (section "tube-spinners.laser" "spinners.laser" :record ioj::sim::LaserWeaponSimConfig)))
