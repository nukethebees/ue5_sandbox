(soa-module native_entity_history
  :header "native/simulation/include/ioj/sim/entity_history.h"
  :backend standard-library
  :namespace ioj::sim
  (struct EntityHistoryColumns
    :operations (all)
    (member entity_ids array @native_unique_id)
    (member entity_types array @native_entity_type)
    (member teams array @native_team)
    (member kills array uint32)
    (member killed_by array @native_unique_id)
    (member life_state array @native_life_state)
    (single-allocation EntityHistory)))
