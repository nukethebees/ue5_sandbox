(module timer_handle
  :header "native/simulation/include/ioj/sim/expressions/timer_handle.h"
  :namespace ioj::sim
  (record TimerHandle :layout packed :bits 32 :invalid-value 0xffffffff
    (member index std::uint32_t :bits 32)
    (projections (cpp :storage std::uint32_t))))

(module timer_state
  :header "native/simulation/include/ioj/sim/expressions/detail/timer_state.h"
  :namespace ioj::sim::detail
  (enum TimerState std::uint8_t
    :bit-width 2
    :native-api true :helpers ()
    (value NotStarted) (value Started) (value Finished)
    (projections (cpp))))

(module timer_entry
  :header "native/simulation/include/ioj/sim/expressions/detail/timer_entry.h"
  :namespace ioj::sim::detail
  (integer-scalar CountdownIndex :bit-width 30)
  (record TimerEntry :layout packed :bits 32
    (member state @timer_state)
    (member index @CountdownIndex)
    (projections (cpp :storage std::uint32_t))))
