(module level_authoring_grammar
  :header "native/level_authoring/lib/include/ioj/levels/authoring/grammar.h"
  :namespace ioj::levels::authoring
  (enum EffectSyntax @native_uint8
    :native-api true :helpers (traits to-serialized-string try-parse-serialized)
    (value Win :serialized-name "win")
    (value ChangePoints :serialized-name "change-points")
    (value Stop :serialized-name "stop")
    (value Spawn :serialized-name "spawn")
    (value StartTimer :serialized-name "start-timer")
    (projections (cpp)))
)
