(enum-module test_entity_type
  :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/entities/TestEntityType.h"
  :source "Plugins/SpaceGame/Source/SpaceGameSimulation/Private/entities/TestEntityTypeEnum.cpp"
  :header-include "SpaceGameSimulation/entities/TestEntityType.h"
  :prelude ("enum class ETestEntityType : uint8;" "namespace ml {" "SPACEGAMESIMULATION_API auto get_entity_display_name(ETestEntityType type) -> FString const&;" "SPACEGAMESIMULATION_API auto get_entity_class_name(ETestEntityType type) -> FString const&;" "SPACEGAMESIMULATION_API auto get_entity_short_name(ETestEntityType type) -> FString const&;" "}")
  :helper-namespace ml
  (enum ETestEntityType uint8
    :reflection uenum
    :enum-array true
    :count COUNT
    :conversions (lex-to-string string-view display-string-view lex-to-serialized-string try-parse-serialized)
    :export-specifier SPACEGAMESIMULATION_API
    (value PlayerShip
      :display-name "Player Ship"
      :serialized-name player_ship)
    (value Turret
      :serialized-name turret)
    (value CapitalShip
      :display-name "Capital Ship"
      :serialized-name capital_ship)
    (value CapitalShipFighter
      :display-name "Capital Ship Fighter"
      :serialized-name capital_ship_fighter)
    (value TubeSpinner
      :display-name "Tube Spinner"
      :serialized-name tube_spinner)
    (value COUNT
      :hidden true)))
