(enum-module game_ui_style_types
  :header "Plugins/SpaceGame/Source/SpaceGamePresentation/Public/SpaceGamePresentation/ui/style/GameUiStyleTypes.h"
  :source "Plugins/SpaceGame/Source/SpaceGamePresentation/Private/ui/style/GameUiStyleTypes.cpp"
  :header-include "SpaceGamePresentation/ui/style/GameUiStyleTypes.h"
  :helper-namespace ml::ioj
  (enum EGameTextStyle uint8
    :reflection uenum
    :enum-array true
    :conversions (lex-to-string string-view display-string-view)
    :export-specifier SPACEGAMEPRESENTATION_API
    (value Body)
    (value BodySecondary
      :display-name "Body Secondary")
    (value Caption)
    (value Heading1
      :display-name "Heading 1")
    (value Heading2
      :display-name "Heading 2")
    (value Heading3
      :display-name "Heading 3")
    (value Warning)
    (value HudPrimary
      :display-name "HUD Primary")
    (value HudSecondary
      :display-name "HUD Secondary")
    (value Disabled))
  (enum EGameButtonStyle uint8
    :reflection uenum
    :enum-array true
    :conversions (lex-to-string string-view display-string-view)
    :export-specifier SPACEGAMEPRESENTATION_API
    (value Primary)
    (value Secondary))
  (enum EGameUiIcon uint8
    :reflection uenum
    :enum-array true
    :conversions (lex-to-string string-view display-string-view)
    :export-specifier SPACEGAMEPRESENTATION_API
    (value Hive)
    (value Video)
    (value Gameplay)
    (value Audio)
    (value Controls)
    (value Accessibility)
    (value System)
    (value LevelIncomplete)
    (value LevelComplete)))

(enum-module mission_modes
  :header "Plugins/SpaceGame/Source/SpaceGameSimulation/Public/SpaceGameSimulation/missions/TestMissionMode.h"
  :source "Plugins/SpaceGame/Source/SpaceGameSimulation/Private/missions/TestMissionMode.cpp"
  :header-include "SpaceGameSimulation/missions/TestMissionMode.h"
  :helper-namespace ml
  (enum ETestMissionMode uint8
    :reflection uenum
    :enum-array true
    :conversions (lex-to-string string-view display-string-view lex-to-serialized-string try-parse-serialized)
    :export-specifier SPACEGAMESIMULATION_API
    (value None
      :serialized-name none)
    (value SurviveTime
      :display-name "Survive Time"
      :serialized-name survive_time)
    (value KillEnemies
      :display-name "Kill Enemies"
      :serialized-name kill_enemies)
    (value KillEnemiesWithinTime
      :display-name "Kill Enemies Within Time"
      :serialized-name kill_enemies_within_time)))

