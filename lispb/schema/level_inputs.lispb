(module positional_inputs
  :header "native/level_authoring/lib/include/ioj/levels/authoring/positional_inputs.h"
  :header-include "ioj/levels/authoring/positional_inputs.h"
  :namespace ioj::levels::authoring

  (record UnlockInput :generate-s7-writer true
    :s7-writer-includes ("ioj/levels/authoring/input_writers.h" "ioj/levels/level_camera_definition_writer.h")
    :generate-s7-reader true :s7-tag "level-completed" :s7-positional true
    :s7-reader-includes ("ioj/levels/authoring/identifier_reader.h")
    (member level @input_level_id :initializer "" :s7-name "level-id")
    (projections (cpp)))
  )

(module level_inputs
  :header "native/level_authoring/lib/include/ioj/levels/authoring/level_inputs.h"
  :header-include "ioj/levels/authoring/level_inputs.h"
  :namespace ioj::levels::authoring
  (record EntityInput :generate-s7-writer true
    :s7-writer-includes ("ioj/levels/authoring/input_writers.h" "ioj/levels/authoring/positional_inputs_writer.h" "ioj/levels/level_camera_definition_writer.h")
    :generate-visitor true :generate-s7-reader true :s7-tag "entity"
    :s7-reader-includes ("ioj/levels/authoring/input_readers.h"
                        "ioj/levels/authoring/positional_inputs_reader.h")
    (member id @input_entity_id :initializer "")
    (member archetype ioj::levels::EntityArchetype :initializer "" :required true)
    (member team ioj::Team :initializer "" :required true)
    (member position @native_vector3d :initializer "" :required true)
    (member rotation @native_vector3d :initializer "")
    (member spawn_at @input_spawn_time :initializer "")
    (member health @input_optional_health :initializer "")
    (member laser_damage @input_optional_nonnegative_int :initializer "")
    (member initial_spawn_delay @input_optional_delay :initializer "")
    (member spawn_cooldown @input_optional_delay :initializer "")
    (member initial_fire_point @input_optional_nonnegative_int :initializer "")
    (projections (cpp)))


  (record LevelInput :generate-s7-writer true
    :s7-writer-includes ("ioj/levels/authoring/input_writers.h" "ioj/levels/authoring/positional_inputs_writer.h" "ioj/levels/level_camera_definition_writer.h")
    :generate-s7-reader true :s7-tag "level"
    :s7-reader-includes ("ioj/levels/level_camera_definition_reader.h")
    (member id @input_level_id :initializer "" :required true)
    (member title @native_string :initializer "" :required true)
    (member description @native_string :initializer "")
    (member par_time @input_optional_float :initializer "" :finite true)
    (member unlock @input_unlocks :initializer "")
    (member player @input_entity_id :initializer "")
    (member camera @input_camera :initializer "")
    (member settings @input_settings :initializer "")
    (member logic @input_logic :initializer "")
    (member entities @input_entities :initializer "")
    (projections (cpp)))
  (record IncludedLevelInput :generate-s7-reader true :s7-tag "included-level"
    (member path @native_string :initializer "" :required true)
    (member value @input_level_value :initializer "")
    (member error @input_optional_string :initializer "")
    (projections (cpp)))
  (record IncludedCampaignInput :generate-s7-reader true :s7-tag "included-campaign"
    :s7-reader-includes ("ioj/levels/campaign_definition_reader.h")
    (member path @native_string :initializer "" :required true)
    (member value @input_campaign_value :initializer "")
    (member error @input_optional_string :initializer "")
    (projections (cpp)))
  (record CatalogInput :generate-s7-reader true :s7-tag "catalog" :s7-constructor false
    (member levels @input_levels :initializer "")
    (member campaigns @input_campaigns :initializer "")
    (projections (cpp))))

(module s7_constructors
  :header "native/level_authoring/lib/include/ioj/levels/authoring/record_constructors.h"
  :namespace ioj::levels::authoring
  :s7-constructors true)
