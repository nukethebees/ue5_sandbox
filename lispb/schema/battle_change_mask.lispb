(module battle_change_mask
  :header "native/simulation/include/ioj/sim/telemetry/battle_change_mask.h"
  :namespace ioj::sim::telemetry
  (record BattleChangeMask
    (member alive std::uint32_t :initializer "")
    (member spawned std::uint32_t :initializer "")
    (member destroyed std::uint32_t :initializer "")
    (member shots std::uint32_t :initializer "")
    (member hits std::uint32_t :initializer "")
    (member damage_dealt std::uint32_t :initializer "")
    (member damage_received std::uint32_t :initializer "")
    (member kills std::uint32_t :initializer "")
    (member kill_matrix std::uint64_t :initializer "")
    (member active_lasers bool :initializer "")
    (member lasers_fired bool :initializer "")
    (projections (cpp))))
