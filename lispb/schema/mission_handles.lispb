(module mission_leaf_kind
  :header "native/simulation/include/ioj/sim/missions/leaf_kind.h"
  :namespace ioj::sim
  (enum LeafKind std::uint8_t
    :bit-width 3
    :native-api true :enum-array true :helpers (traits)
    :ordering (task)
    (value EntityDestroyed :groups (task))
    (value EntityReachedPosition :groups (task))
    (value TimeElapsed)
    (value ObjectiveResolved)
    (value EntityKillsReached :groups (task))
    (projections (cpp))))

(module mission_expr_kind
  :header "native/simulation/include/ioj/sim/missions/expr_kind.h"
  :namespace ioj::sim
  (enum ExprKind std::uint8_t
    :bit-width 1
    :native-api true :helpers ()
    (value Composite) (value Leaf)
    (projections (cpp))))

(module mission_composite_kind
  :header "native/simulation/include/ioj/sim/missions/composite_kind.h"
  :namespace ioj::sim
  (enum CompositeKind std::uint8_t
    :bit-width 1
    :native-api true :helpers ()
    (value Any) (value All)
    (projections (cpp))))

(module mission_objective_id
  :header "native/simulation/include/ioj/sim/missions/objective_id.h"
  :namespace ioj::sim
  (record ObjectiveId :layout packed :bits 16 :invalid-value 0xffff
    (member index std::uint16_t :bits 16)
    (projections (cpp :storage std::uint16_t))))

(module mission_objective_prerequisite
  :header "native/simulation/include/ioj/sim/missions/objective_prerequisite.h"
  :namespace ioj::sim
  (record ObjectivePrerequisite :layout packed :bits 32
    (member objective @mission_objective_id)
    (member outcome @objective_outcome)
    (projections (cpp :storage std::uint32_t))))

(module mission_leaf_handle
  :header "native/simulation/include/ioj/sim/missions/leaf_handle.h"
  :namespace ioj::sim
  (record LeafHandle :layout packed :bits 31
    (member index @mission_leaf_index :bits 28)
    (member kind @mission_leaf_kind)
    (projections (cpp :storage std::uint32_t))))

(module mission_expr_handle
  :header "native/simulation/include/ioj/sim/missions/expr_handle.h"
  :namespace ioj::sim
  (record Composite
    (member kind @mission_composite_kind)
    (member index @mission_composite_index :bits 28))
  (union ExprData
    (case Composite @Composite)
    (case Leaf @mission_leaf_handle))
  (record ExprHandle :layout packed :bits 32 :invalid-value 0xffffffff
    (member kind @mission_expr_kind)
    (member data @ExprData :bits 31 :tag kind)
    (projections (cpp :storage std::uint32_t))))

(module mission_leaf_data_handle
  :header "native/simulation/include/ioj/sim/missions/leaf_data_handle.h"
  :namespace ioj::sim
  (record LeafDataHandle :layout packed :bits 32
    (member index @mission_leaf_data_index :bits 24)
    (member kind @mission_leaf_kind :bits 8)
    (projections (cpp :storage std::uint32_t))))
