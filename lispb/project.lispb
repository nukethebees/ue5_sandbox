(lispb-project
  :language-version 1
  :project-root ".."

  (cpp-schema compiler-ir
    :types "native/lispb/schema/compiler_types.lispb"
    :sources ("native/lispb/schema/compiler_ir.lispb")
    :output-root (project-path "native/lispb/include/codegen/ast"))

  (cpp-schema compiler-schema
    :types "native/lispb/schema/compiler_types.lispb"
    :sources ("native/lispb/schema/compiler_schema.lispb")
    :output-root (project-path "native/lispb/include/codegen/schema"))

  (cpp-schema layout-analysis
    :types "native/layout/schema/types.lispb"
    :sources (
      "native/layout/schema/code_table.lispb"
      "native/layout/schema/component_table.lispb"
      "native/layout/schema/distribution_entry_table.lispb"
      "native/layout/schema/distribution_table.lispb"
      "native/layout/schema/packed_field_table.lispb"
      "native/layout/schema/physical_fact_table.lispb"
      "native/layout/schema/relationship_table.lispb"
      "native/layout/schema/scalar_table.lispb"
      "native/layout/schema/selection_table.lispb"
      "native/layout/schema/soa_column_table.lispb"
      "native/layout/schema/tag_table.lispb"
      "native/layout/schema/type_analysis_table.lispb"
      "native/layout/schema/workload_table.lispb")
    :output-root (project-path "native/layout/lib"))

  (cpp-schema sandbox-code
    :types "lispb/schema/types.lispb"
    :sources (
      "lispb/schema/native_simulation_model.lispb"
      "lispb/schema/native_levels.lispb"
      "lispb/schema/level_inputs.lispb"
      "lispb/schema/mission_types.lispb"
      "lispb/schema/mission_handles.lispb"
      "lispb/schema/level_authoring_grammar.lispb"
      "lispb/schema/s7_simulation_settings.lispb"
      "lispb/schema/s7_starfield_settings.lispb"
      "lispb/schema/s7_presentation_settings.lispb"
      "lispb/schema/native_traces.lispb"
      "lispb/schema/level_telemetry_history.lispb"
      "lispb/schema/native_collision.lispb"
        "lispb/schema/native_entity_cell_data.lispb"
        "lispb/schema/native_world_aabbs.lispb"
        "lispb/schema/native_entity_life_state.lispb"
        "lispb/schema/native_direct_damage_events.lispb"
        "lispb/schema/native_entity_death_info.lispb"
        "lispb/schema/native_entity_history.lispb"
        "lispb/schema/native_entity_type.lispb"
        "lispb/schema/native_simulation_enums.lispb"
        "lispb/schema/native_entity_id.lispb"
        "lispb/schema/entity_instance_handle.lispb"
        "lispb/schema/native_fighter_order_queue.lispb"
        "lispb/schema/fighter_orders.lispb"
        "lispb/schema/health.lispb"
        "lispb/schema/sim_tick.lispb"
        "lispb/schema/level_events.lispb"
        "lispb/schema/collision_scalars.lispb"
        "lispb/schema/query_results.lispb"
        "lispb/schema/fighter_navigation_types.lispb"
        "lispb/schema/native_vectors.lispb"
        "lispb/schema/native_rotators.lispb"
        "lispb/schema/native_radar_positions.lispb"
      "lispb/schema/level_definition.lispb"
      "lispb/schema/batch_game.lispb"
      "lispb/schema/enums.lispb"
      "lispb/schema/sandbox_ismc.lispb"
      "lispb/schema/facades.lispb"
      "lispb/schema/settings.lispb")
    :output-root (project-path "."))

  (cpp-schema cpp-compile-fixture
    :types "native/lispb/tests/compile_fixture/types.lispb"
    :sources ("native/lispb/tests/compile_fixture/modules.lispb")
    :output-root (project-path "native/lispb/tests/compile_fixture/generated"))

  (cpp-schema native-soa-fixture
    :types "native/lispb/tests/native_soa/schema/types.lispb"
    :sources ("native/lispb/tests/native_soa/schema/fixture.lispb")
    :output-root (project-path "native/lispb/tests/native_soa"))

  (slate slate-core-widgets
    :sources ("Plugins/SandboxUI/Source/SandboxUI/Private/widgets/CoreWidgets.lispb")
    :output-root (project-path "Plugins/SandboxUI/Source/SandboxUI/Private/widgets/generated"))

  (slate slate-s7-script-editor
    :sources ("Source/SandboxEditor/levels/S7LevelScriptEditor.lispb"
              "Source/SandboxEditor/levels/S7LevelAuthoringModeToolkit.lispb")
    :output-root (project-path "Source/SandboxEditor/levels/generated"))
  (slate slate-ui-showcase
    :sources ("Plugins/SandboxUI/Source/SandboxUIExamples/Private/SandboxUIShowcase.lispb")
    :output-root (project-path "Plugins/SandboxUI/Source/SandboxUIExamples/Private/generated"))
  (slate slate-heatmap-benchmark
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Benchmarks/Heatmap/HeatmapBenchmarkSlate.lispb")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/Benchmarks/Heatmap/generated"))
  (slate slate-experiment-widgets
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Widgets/ExperimentPanels.lispb")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/Widgets/generated"))
  (slate slate-radar
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Radar3D/Radar3DShowcase.lispb")
    :include-directories ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Widgets")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/Radar3D/generated"))
  (slate slate-heatmap-rdg
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/HeatmapRDG/HeatmapRDGShowcase.lispb")
    :include-directories ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Widgets")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/HeatmapRDG/generated"))
  (slate slate-scatter
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Scatter3D/Scatter3DShowcase.lispb")
    :include-directories ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Widgets")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/Scatter3D/generated"))
  (slate slate-smoke
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/SlateDslSmoke/SlateDslSmokeWidget.lispb")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/SlateDslSmoke/generated"))
  (slate slate-volume-heatmap
    :sources ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/VolumeHeatmap3D/VolumeHeatmap3DShowcase.lispb")
    :include-directories ("Plugins/SandboxUI/Source/SbxUIExperiments/Private/Widgets")
    :output-root (project-path "Plugins/SandboxUI/Source/SbxUIExperiments/Private/VolumeHeatmap3D/generated"))
  (slate slate-game-options
    :sources ("Plugins/SpaceGame/Source/SpaceGame/Private/ui/main_menu/SGameOptionsView.lispb")
    :output-root (project-path "Plugins/SpaceGame/Source/SpaceGame/Private/ui/main_menu/generated"))
  (slate slate-level-select
    :sources ("Plugins/SpaceGame/Source/SpaceGameS7/Private/SScriptLevelSelectView.lispb")
    :output-root (project-path "Plugins/SpaceGame/Source/SpaceGameS7/Private/generated"))
  (slate slate-compile-fixture
    :sources ("native/lispb/slate/tests/compile/widgets.lispb")
    :output-root (build-path "native/lispb/slate/compile-generated"))

  (kernel kernel-standard
    :sources (
      "Plugins/SandboxCore/Source/SandboxCore/Kernels/array_math.lispb"
      "Plugins/SandboxCore/Source/SandboxCore/Kernels/candidate_math.lispb"
      "native/lispb/kernel/tests/constants.lispb")
    :output-root (build-path "native/lispb/kernel/standard-generated"))

  (kernel kernel-native-core
    :sources (
      "Plugins/SandboxCore/Source/SandboxCore/Kernels/array_math.lispb"
      "native/core/Kernels/vector_lerp.lispb")
    :output-root (project-path "native/core"))

  (material ui-glow-material
    :source "Plugins/SandboxUI/Source/SandboxUI/Private/materials/UiGlowComposite.lispb"
    :artifact (project-path "Intermediate/MaterialGen/UiGlowComposite.smat"))
  (material world-soft-target-material
    :source "Plugins/SpaceGame/Source/SpaceGamePresentation/Private/materials/SoftTargetWorld.lispb"
    :artifact (project-path "Intermediate/MaterialGen/SoftTargetWorld.smat"))
  (material radar-display-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/RadarDisplay.lispb"
    :artifact (project-path "Intermediate/MaterialGen/RadarDisplay.smat"))
  (material energy-shield-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/EnergyShield.lispb"
    :artifact (project-path "Intermediate/MaterialGen/EnergyShield.smat"))
  (material space-energy-field-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/SpaceEnergyFieldDisplay.lispb"
    :artifact (project-path "Intermediate/MaterialGen/SpaceEnergyField.smat"))
  (material glowing-cross-material
    :source "Source/Sandbox/materials/GlowingCross.lispb"
    :artifact (project-path "Intermediate/MaterialGen/GlowingCross.smat"))
  (material vertex-ripple-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/VertexRipple.lispb"
    :artifact (project-path "Intermediate/MaterialGen/VertexRipple.smat"))
  (material construction-spawn-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/ConstructionSpawn.lispb"
    :artifact (project-path "Intermediate/MaterialGen/ConstructionSpawn.smat"))
  (material planet-atmosphere-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/PlanetAtmosphere.lispb"
    :artifact (project-path "Intermediate/MaterialGen/PlanetAtmosphere.smat"))
  (material planet-surface-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/PlanetSurface.lispb"
    :artifact (project-path "Intermediate/MaterialGen/PlanetSurface.smat"))
  (material tactical-scan-material
    :source "Plugins/SandboxShaders/Source/SbxShadersExperiments/Private/materials/TacticalScan.lispb"
    :artifact (project-path "Intermediate/MaterialGen/TacticalScan.smat"))
  (material celestial-analytic-material
    :source "Plugins/SandboxShaders/Source/SandboxCelestials/Private/materials/CelestialAnalytic.lispb"
    :artifact (project-path "Intermediate/MaterialGen/CelestialAnalytic.smat"))
  (material space-dust-material
    :source "Plugins/SandboxShaders/Source/SandboxShaders/Private/materials/SpaceDust.lispb"
    :artifact (project-path "Intermediate/MaterialGen/SpaceDust.smat"))

  (group slate-production
    :targets (
      slate-s7-script-editor
      slate-core-widgets
      slate-ui-showcase
      slate-heatmap-benchmark
      slate-experiment-widgets
      slate-radar
      slate-heatmap-rdg
      slate-scatter
      slate-smoke
      slate-volume-heatmap
      slate-game-options
      slate-level-select))
  (group committed-code
    :targets (compiler-ir compiler-schema layout-analysis sandbox-code native-soa-fixture slate-production kernel-native-core))
  (group materials
    :targets (
      ui-glow-material
      world-soft-target-material
      radar-display-material
      energy-shield-material
      space-energy-field-material
      glowing-cross-material
      vertex-ripple-material
      construction-spawn-material
      planet-atmosphere-material
      planet-surface-material
      tactical-scan-material)))
