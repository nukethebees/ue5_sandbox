# performance-inefficient-vector-operation is intentionally disabled: its 27
# reserve() suggestions were mostly generator/test setup, including tiny component
# lists. The benefit does not justify spreading allocation tuning through that code.
# bugprone-exception-escape is disabled pending review: MSVC allocation and I/O
# paths dominate its findings, including CLI exceptions already caught by std::exception.
# Keep exception-policy changes separate from routine tidy fixes.
# Deferred after review; findings are saved for a separate follow-up:
# bugprone-integer-division: intentional integer grid coordinates (3 findings).
# bugprone-incorrect-roundings: sign-aware rounding matching FMath::SinCos (1).
# bugprone-return-const-ref-from-parameter: locally consumed projections (2).
# bugprone-signed-char-misuse: nonnegative int8_t avoidance indices (2).
# bugprone-suspicious-stringview-data-usage: Windows calls already pass lengths (5).
# bugprone-misplaced-widening-cast: mixes guarded/constant arithmetic with size
# calculations needing bounds review (17); defer that review rather than add casts.
# bugprone-narrowing-conversions: includes mission kill-count signedness policy (4).
# bugprone-unchecked-optional-access: 721 reports, including checked result wrappers
# and explicitly guarded optionals; too noisy for this rollout.
Checks:
  - '-*'
  - modernize-use-nullptr
  - modernize-use-override
  - readability-redundant-control-flow
  - readability-redundant-string-init
  - performance-unnecessary-value-param
  - performance-move-const-arg
  - bugprone-argument-comment
  - bugprone-use-after-move
  - performance-unnecessary-copy-initialization
  - bugprone-dangling-handle
  - bugprone-inaccurate-erase
  - bugprone-undefined-memory-manipulation
  - bugprone-suspicious-memset-usage
  - bugprone-sizeof-expression
  - bugprone-unused-raii
  - performance-for-range-copy
  - performance-implicit-conversion-in-loop
  - performance-move-constructor-init
  - performance-type-promotion-in-math-fn
  - bugprone-assert-side-effect
  - bugprone-assignment-in-if-condition
  - bugprone-bad-signal-to-kill-thread
  - bugprone-bitwise-pointer-cast
  - bugprone-bool-pointer-implicit-conversion
  - bugprone-branch-clone
  - bugprone-capturing-this-in-member-variable
  - bugprone-casting-through-void
  - bugprone-chained-comparison
  - bugprone-compare-pointer-to-member-virtual-function
  - bugprone-copy-constructor-init
  - bugprone-crtp-constructor-accessibility
  - bugprone-dynamic-static-initializers
  - bugprone-empty-catch
  - bugprone-fold-init-type
  - bugprone-forward-declaration-namespace
  - bugprone-forwarding-reference-overload
  - bugprone-implicit-widening-of-multiplication-result
  - bugprone-inc-dec-in-conditions
  - bugprone-incorrect-enable-if
  - bugprone-incorrect-enable-shared-from-this
  - bugprone-infinite-loop
  - bugprone-lambda-function-name
ExtraArgsBefore:
  - /EHsc
CheckOptions:
  # Preserve checks on runtime products without flagging constants proven to fit.
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
