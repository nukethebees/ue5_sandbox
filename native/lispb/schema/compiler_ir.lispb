(module compiler_type_operation
  :header "type_operation.h"
  :namespace lispb::codegen
  (enum TypeOperation std::uint8_t
    :native-api true
    :helpers (to-string to-serialized-string try-parse-serialized formatter)
    (value add_element :serialized-name "add-element")
    (value remove_at_swap :serialized-name "remove-at-swap")
    (value set_element :serialized-name "set-element")
    (projections (cpp))))

(module compiler_record_kind
  :header "record_kind.h"
  :namespace lispb::codegen
  (enum RecordKind std::uint8_t
    :native-api true
    :helpers (to-serialized-string try-parse-serialized)
    (value struct_ :serialized-name "struct")
    (value class_ :serialized-name "class")
    (value union_ :serialized-name "union")
    (projections (cpp))))

(module compiler_parameter_passing
  :header "parameter_passing.h"
  :namespace lispb::codegen
  (enum ParameterPassing std::uint8_t
    :native-api true
    :helpers (try-parse-serialized)
    (value const_reference :serialized-name "const-ref")
    (value value :serialized-name "value")
    (projections (cpp))))

(module compiler_node_kind
  :header "node_kind.h"
  :namespace lispb::codegen
  (enum NodeKind std::uint8_t
    (value invalid)
    (value raw)
    (value raw_lines)
    (value line_comment)
    (value block_comment)
    (value block)
    (value if_stmt)
    (value switch_stmt)
    (value break_stmt)
    (value expr_stmt)
    (value return_stmt)
    (value assignment_stmt)
    (value variable_declaration_stmt)
    (value static_assert_)
    (value new_lines)
    (value access_specifier)
    (value include)
    (value include_dependencies)
    (value forward_declaration)
    (value friend_declaration)
    (value using_declaration)
    (value instance_member)
    (value static_member)
    (value constexpr_member)
    (value function)
    (value enum_)
    (value struct_)
    (value namespace_)
    (value line_directive)
    (value for_stmt)
    (projections (cpp))))

(module compiler_function_flags
  :header "function_flags.h"
  :namespace lispb::codegen
  (record FunctionFlags :layout packed :bits 8
    (member is_constexpr bool :bits 1)
    (member is_inline bool :bits 1)
    (member is_nodiscard bool :bits 1)
    (member define_in_header bool :bits 1)
    (projections (cpp :storage std::uint8_t))))

(module compiler_cpp_file_flags
  :header "cpp_file_flags.h"
  :namespace lispb::codegen
  (record CppFileFlags :layout packed :bits 8
    (member pragma_once bool :bits 1)
    (member clang_format_off bool :bits 1)
    (member format_generated bool :bits 1)
    (projections (cpp :storage std::uint8_t))))

(module access
  :header "access.h"
  :namespace lispb::codegen
  (enum Access std::uint8_t
    :native-api true
    :helpers (to-serialized-string try-parse-serialized)
    (value public_ :serialized-name "public")
    (value protected_ :serialized-name "protected")
    (value private_ :serialized-name "private")
    (projections (cpp))))
