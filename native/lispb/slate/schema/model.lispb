(module slate_parameter_kind
  :header "parameter_kind.h"
  :namespace slate_codegen::detail
  (enum ParameterKind std::uint8_t
    :native-api true
    :helpers (to-serialized-string try-parse-serialized)
    (value value :serialized-name "value")
    (value callback :serialized-name "callback")
    (value factory :serialized-name "factory")
    (value existing :serialized-name "existing")))

(module structural_form
