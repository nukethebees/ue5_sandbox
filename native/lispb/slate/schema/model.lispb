    (value fill :serialized-name "fill")
    (value assign :serialized-name "assign")
    (value existing :serialized-name "existing")
    (value call :serialized-name "call")
    (value let_ :serialized-name "let")
    (value params :serialized-name "params")))

(module slot_option
