(module native_soa_fixture
  :header "native_soa_types.h"
  :backend standard-library
  :namespace ml::native_soa_fixture
  (record Pair
    (member x float)
    (member y float))
  (record Node
    (member next (type-ref Node :suffix "*"))
    (member weight float))
  (record First (member other (type-ref Second :suffix "*")))
  (record Second (member other (type-ref First :suffix "*")))

  (struct PointerA :operations (all)
    (member others array (type-ref PointerB :suffix "*")))
  (struct PointerB :operations (all)
    (member others array (type-ref PointerA :suffix "*")))
  (struct ReverseB :operations (all)
    (member others array (type-ref ReverseA :suffix "*")))
  (struct ReverseA :operations (all)
    (member others array (type-ref ReverseB :suffix "*")))
  (record MixedRecord (member rows (type-ref MixedRows :suffix "*")))
  (struct MixedRows :operations (all)
    (member records array (type-ref MixedRecord :suffix "*")))
  (record Envelope
    (member pairs Pair :count 3)
    (member node Node)
    (member aligned @aligned32))
  (struct PairRows
    :operations (all)
    (member pairs array Pair)
    (member pointers array (type-ref Node :suffix "*")))
  (struct Vectors
    :operations (all)
    :vector-components (xs ys zs)
    (member xs array float)
    (member ys array float)
    (member zs array float))
  (struct Rows
    :operations (all)
    (member values array int32)
    (member positions nested Vectors :nested-schema Vectors)
    (member velocities nested Vectors :nested-schema Vectors)
    (single-allocation SingleRows))
  (struct AlignmentRows
    :operations (all)
    (member bytes array uint8)
    (member odd array @odd_bytes)
    (member aligned32 array @aligned32)
    (member nested nested Vectors :nested-schema Vectors)
    (member aligned64 array @aligned64)
    (member aligned256 array @aligned256)
    (single-allocation SingleAlignmentRows)))
