  (record ApiPair (member x float) (member y float))
  (struct ApiCoordinates
    :layout-only true
    :equivalent-type ApiPair
    :vector-components (xs ys)
    (member xs array float)
    (member ys array float)
    (view-function x_at float
      (parameter index std::int32_t)
      :body #cpp{return $column(xs)[index];}cpp#)
    (mutable-view-function shift_x void
      (parameter amount float)
      :body #cpp{auto xs = $column(xs);
auto const count = num();
for (std::int32_t i{}; i < count; ++i) { xs[i] += amount; }}cpp#))
  (struct ApiRows
    :view-name ApiView
    :const-view-name ApiConstView
    :export-specifier COMPILE_FIXTURE_API
    :operations (set-num reserve append-from copy-element)
    :using-declarations ("Value = float")
