  :prelude #cpp{#define NATIVE_SOA_FIXTURE_API}cpp#
  :namespace ioj::native_soa_fixture
  (struct Counts
    (member count array std::uint32_t))
  (record Pair
    (member x float)
    (member y float)
    (projections (cpp)))
  (record Node
    (member next (type-ref Node :suffix "*"))
    (member weight float)
    (projections (cpp)))
  (record First (member other (type-ref Second :suffix "*")) (projections (cpp)))
  (record Second (member other (type-ref First :suffix "*")) (projections (cpp)))

  (struct PointerB
    (member others array (type-ref PointerA :suffix "*")))
  (struct PointerA
    (member others array (type-ref PointerB :suffix "*")))
  (record MixedRecord (member rows (type-ref MixedRows :suffix "*")) (projections (cpp)))
  (struct MixedRows
    (member records array (type-ref MixedRecord :suffix "*")))
  (record Envelope
    (member pairs Pair :count 3)
    (member node Node)
    (member aligned @aligned32)
    (projections (cpp)))
  (struct PairRows
    (member pairs array Pair)
    (member pointers array (type-ref Node :suffix "*")))
  (struct Vectors
    (member xs array float)
    (member ys array float)
    (member zs array float))
  (struct OddPairs
    :layout-only true
    (member first array @odd_bytes)
    (member second array @odd_bytes))
  (struct VectorGroups
    :layout-only true
    (member starts nested Vectors)
    (member ends nested Vectors))
  (struct SingleRows
    (member values array int32)
    (member positions nested Vectors)
    (member velocities nested Vectors))
  (struct SingleAlignmentRows
    (member bytes array uint8)
    (member odd nested OddPairs)
    (member aligned32 array @aligned32)
    (member nested nested VectorGroups)
    (member aligned64 array @aligned64)
    (member aligned256 array @aligned256))
  (record ApiPair (member x float) (member y float) (projections (cpp)))
  (struct ApiCoordinates
    :layout-only true
    :equivalent-type ApiPair
    (member xs array float :equivalent-member x)
    (member ys array float :equivalent-member y)
    (view-function x_at float :definition-in-source true
      (parameter index std::uint32_t)
      :body #cpp{return $column(xs)[index];}cpp#)
    (mutable-view-function shift_x void
      (parameter amount float)
      :body #cpp{auto xs = $column(xs);
auto const count = num();
for (std::uint32_t i{}; i < count; ++i) { xs[i] += amount; }}cpp#))
  (struct ApiOwner
    :export-specifier NATIVE_SOA_FIXTURE_API
    :using-declarations ("Value = float")
    :field-mask-name ApiMask
    :field-enum-name ApiField
    (member values array float :mask-field true)
    (member masks array ApiMask)
    (member positions nested ApiCoordinates)
    (function append_value auto
      (parameter row float) :append-columns (values))
    (function append_empty std::uint32_t :definition-in-source true
      :append-columns ())
    (function schema_version int :static true :constexpr true :nodiscard true
      :body ("return 7;"))
    (function identity T :static true :constexpr true :nodiscard true
      :template-parameters "typename T" :requires "(sizeof(T) > 0)"
      (parameter value T) :body ("return value;"))
    (view-function schema_version int :constexpr true :nodiscard true
      :body ("return 7;"))
    (mutable-view-function mutable_version auto :trailing-return-type int
      :constexpr true :nodiscard true :body ("return 8;"))
    (function first_value float :const true :inline true
      :body #cpp{return $column(values)[0];}cpp#)
    (function total Value :const true :definition-in-source true
      :body #cpp{auto values = $column(values);
float result{};
auto const count = num();
for (std::uint32_t i{}; i < count; ++i) { result += values[i]; }
return result;}cpp#)
    (view-function first_x float :definition-in-source true
      :body #cpp{return $column(positions.xs)[0];}cpp#)
    (mutable-view-function assign_first void
      (parameter value float)
      :body #cpp{$column(values)[0] = value;}cpp#))
  (struct EquivalentOwner
    :equivalent-type ApiPair
    (member xs array float :equivalent-member x)
    (member ys array float :equivalent-member y))
  (record ApiReference (member owner (type-ref ApiOwner :suffix "*")) (projections (cpp)))
  (struct AccessorOwner
    :equivalent-type @vector3
    (member horizontal array float :equivalent-member x :equivalent-accessor true)
    (member vertical array float :equivalent-member y :equivalent-accessor true)
    (member depth array float :equivalent-member z :equivalent-accessor true))
)
