(module selection_table
  :header "ioj/layout/analysis/selection_table.hpp"
  :source "ioj/layout/analysis/selection_table.cpp"
  :header-include "ioj/layout/analysis/selection_table.hpp"
  :backend standard-library
  :namespace ioj::layout
  :prelude #cpp{#include <optional>}cpp#
  (struct SelectionTable
    :storage vector
    :operations (set-num reset)
    (member source array @size_t)
    (member operation array @access_operation)
    (member bytes array @payload_footprint)
    (member bits array @payload_footprint)
    (member cache array @region_footprint)
    (member pages array @region_footprint)
    (member capacity_slack_bytes array @optional_uint64_t)
    (function append @size_t :definition-in-source true
      (parameter selected_source @size_t)
      (parameter selected_operation @access_operation)
      :body #cpp{auto const row{num()};
set_num(row + 1);
source[row] = selected_source;
operation[row] = selected_operation;
return row;}cpp#)
  ))
