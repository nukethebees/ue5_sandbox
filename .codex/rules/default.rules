# Git
# ---------------------------------------------
# Integration remains privileged; never allow the entire coj prefix.
prefix_rule(
    pattern=["coj", "integrate"],
    decision="prompt"
)
prefix_rule(
    pattern=["coj", "git"],
    decision="allow"
)
prefix_rule(
    pattern=["coj", "prepare-worktree"],
    decision="allow"
)
prefix_rule(
    pattern=["coj", "install-central-tools"],
    decision="allow"
)
prefix_rule(
    pattern=["git", "status"], 
    decision="allow"
)
prefix_rule(
    pattern=["git", "diff"], 
    decision="allow"
)

# CMake
# ---------------------------------------------
prefix_rule(
    pattern=["cmake", "--preset"], 
    decision="allow"
)
prefix_rule(
    pattern=["cmake", "--workflow", "--preset"], 
    decision="allow"
)
prefix_rule(
    pattern=["cmake", "--build", "--preset"], 
    decision="allow"
)
prefix_rule(
    pattern=["ctest"], 
    decision="allow"
)

# rg
# ---------------------------------------------
prefix_rule(
    pattern=["rg", "--files"], 
    decision="allow"
)

# Powershell
# ---------------------------------------------
prefix_rule(
    pattern=["Get-Content"], 
    decision="allow"
)
prefix_rule(
    pattern=["Select-Object"], 
    decision="allow"
)
prefix_rule(
    pattern=["Get-ChildItem"], 
    decision="allow"
)

# Clang Tools
# ---------------------------------------------
prefix_rule(
    pattern=["clang-tidy"], 
    decision="allow"
)
prefix_rule(
    pattern=["clang-format", "-i"], 
    decision="allow"
)

# Python
# ---------------------------------------------
prefix_rule(
    pattern=["python", "-m", "unittest"], 
    decision="allow"
)
prefix_rule(
    pattern=["pyright"], 
    decision="allow"
)

# Named Codex session inspection and membership-checked self-cleanup only.
# Launching or stopping a complete session is not covered by this allowance.
prefix_rule(
    pattern=["coj", "codex", ["processes", "clean"]],
    decision="allow",
    match=["coj codex processes dev1", "coj codex clean dev1 --dry-run", "coj codex clean dev1"],
    not_match=["coj codex start dev1", "coj codex stop dev1"]
)
