{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "unreal",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_MANIFEST_FEATURES": "soa-mimalloc"
      }
    },
    {
      "name": "codegen",
      "displayName": "Code generator",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SANDBOX_CODEGEN_ONLY": true
      }
    },
    {
      "name": "kernel-benchmark",
      "displayName": "Native kernel benchmark",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SANDBOX_CODEGEN_ONLY": true,
        "SANDBOX_KERNEL_BENCHMARKS": true,
        "VCPKG_MANIFEST_FEATURES": "kernel-benchmarks"
      }
    },
    {
      "name": "kernel-benchmark-plots",
      "displayName": "Native kernel benchmark plots",
      "inherits": "kernel-benchmark",
      "cacheVariables": {
        "SANDBOX_KERNEL_BENCHMARK_PLOTS": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "unreal",
      "cacheVariables": {
        "UE_CONFIGURATION": "Debug"
      }
    },
    {
      "name": "debug-game",
      "displayName": "DebugGame",
      "inherits": "unreal",
      "cacheVariables": {
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "development",
      "displayName": "Development",
      "inherits": "unreal",
      "cacheVariables": {
        "UE_CONFIGURATION": "Development"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "benchmark"
      }
    },
    {
      "name": "sandbox-ismc-benchmark",
      "displayName": "SandboxISMC benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "editor-only"
      }
    },
    {
      "name": "spark-benchmark",
      "displayName": "Spark renderer benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "editor-only",
        "SANDBOX_SPARK_BENCHMARK_SECONDS": "10",
        "SANDBOX_SPARK_BENCHMARK_CAPACITY": "50000",
        "SANDBOX_SPARK_BENCHMARK_SPARKS_PER_HIT": "96",
        "SANDBOX_SPARK_BENCHMARK_IMPACTS_PER_FRAME": "100",
        "SANDBOX_SPARK_BENCHMARK_WARMUP_FRAMES": "60"
      }
    },
    {
      "name": "shipping",
      "displayName": "Shipping",
      "inherits": "unreal",
      "cacheVariables": {
        "UE_CONFIGURATION": "Shipping"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "inherits": "unreal",
      "cacheVariables": {
        "UE_CONFIGURATION": "Test"
      }
    },
    {
      "name": "native-soa",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "kernel-benchmarks;soa-mimalloc",
        "SANDBOX_CODEGEN_ONLY": true,
        "CMAKE_BUILD_TYPE": "Release",
        "SANDBOX_NATIVE_SOA_BENCHMARKS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "single-allocation-soa-spacing-confirmation",
      "configurePreset": "benchmark",
      "targets": ["single-allocation-soa-spacing-confirmation"]
    },
    {
      "name": "single-allocation-soa-spacing",
      "configurePreset": "benchmark",
      "targets": ["single-allocation-soa-spacing"]
    },
    {
      "name": "single-allocation-soa-plots",
      "configurePreset": "benchmark",
      "targets": ["single-allocation-soa-plots"]
    },
    {
      "name": "codegen",
      "configurePreset": "codegen",
      "targets": ["sandbox-codegen", "sandbox-slatec", "sandbox-kernelc", "codegen-tests", "slate-codegen-tests", "kernel-codegen-tests"]
    },
    {
      "name": "kernel-benchmark",
      "configurePreset": "kernel-benchmark",
      "targets": ["kernel-native-simd-tests", "kernel-native-benchmarks"]
    },
    {
      "name": "kernel-benchmark-plots",
      "configurePreset": "kernel-benchmark-plots",
      "targets": ["kernel-native-simd-tests", "kernel-benchmark-report"]
    },
    {
      "name": "kernel-benchmark-plots-full",
      "configurePreset": "kernel-benchmark-plots",
      "targets": ["kernel-native-simd-tests", "kernel-benchmark-report-full"]
    },
    {
      "name": "kernel-vector-layout-benchmark-plots",
      "configurePreset": "kernel-benchmark-plots",
      "targets": ["kernel-native-simd-tests", "kernel-vector-layout-benchmark-report"]
    },
    {
      "name": "generate-code",
      "configurePreset": "codegen",
      "targets": ["generate-code"]
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": ["dev-core"]
    },
    {
      "name": "debug-game",
      "configurePreset": "debug-game",
      "targets": ["dev-core"]
    },
    {
      "name": "development",
      "configurePreset": "development",
      "targets": ["dev-core"]
    },
    {
      "name": "shipping",
      "configurePreset": "shipping",
      "targets": ["dev-core"]
    },
    {
      "name": "test",
      "configurePreset": "test",
      "targets": ["dev-core"]
    },
    {
      "name": "resave-assets",
      "configurePreset": "debug-game",
      "targets": ["resave-assets"]
    },
    {
      "name": "generate-lab-mesh-assemblies",
      "configurePreset": "debug-game",
      "targets": ["generate-lab-mesh-assemblies"]
    },
    {
      "name": "generate-project-files",
      "configurePreset": "debug-game",
      "targets": ["generate-project-files"]
    },
    {
      "name": "format-code",
      "configurePreset": "debug-game",
      "targets": ["format-code"]
    },
    {
      "name": "format-all-code",
      "configurePreset": "debug-game",
      "targets": ["format-all-code"]
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "targets": ["benchmarks"]
    },
    {
      "name": "gpu-starfield-benchmark",
      "configurePreset": "development",
      "targets": ["editor"]
    },
    {
      "name": "sandbox-ismc-benchmark",
      "configurePreset": "sandbox-ismc-benchmark",
      "targets": ["editor"]
    },
    {
      "name": "spark-benchmark",
      "configurePreset": "spark-benchmark",
      "targets": ["editor"]
    },
    {
      "name": "native-soa",
      "configurePreset": "native-soa",
      "targets": ["native-soa-tests", "native-soa-tests-mimalloc", "native-soa-benchmarks", "native-soa-reserve-matrix", "native-soa-reserve-matrix-mimalloc", "codegen-tests"]
    },
    {
      "name": "native-soa-reserve",
      "configurePreset": "native-soa",
      "targets": ["native-soa-reserve-report"]
    },
    {
      "name": "native-soa-reserve-matrix",
      "configurePreset": "native-soa",
      "targets": ["native-soa-reserve-matrix-report"]
    }
  ],
  "testPresets": [
    {
      "name": "single-allocation-soa-spacing-confirmation-correctness",
      "configurePreset": "benchmark",
      "output": { "verbosity": "verbose" },
      "execution": { "jobs": 1, "noTestsAction": "error" },
      "filter": { "include": { "name": "^SandboxCore\\.SingleAllocation\\.Spacing\\.(Correctness|ShapeCorrectness|AffinityCorrectness|ConfirmationSmoke|ConfirmationReportTests)$" } }
    },
    {
      "name": "single-allocation-soa-spacing-correctness",
      "configurePreset": "benchmark",
      "output": { "verbosity": "verbose" },
      "execution": { "jobs": 1, "noTestsAction": "error" },
      "filter": { "include": { "name": "^SandboxCore\\.SingleAllocation\\.Spacing\\.(Correctness|PipelineSmoke)$" } }
    },
    {
      "name": "single-allocation-soa-iteration-investigation",
      "displayName": "Isolated SoA iteration column-spacing comparison",
      "inherits": "single-allocation-soa-benchmark",
      "filter": {
        "include": {
          "name": "^SandboxCore\\.SingleAllocation\\.IterationInvestigation\\."
        }
      }
    },
    {
      "name": "single-allocation-soa-reserve",
      "displayName": "Single-allocation SoA reserve only",
      "inherits": "single-allocation-soa-benchmark",
      "filter": {
        "include": {
          "name": "^SandboxCore\\.SingleAllocation\\.Timing\\.reserve_(TArray|SingleMimalloc)$"
        }
      }
    },
    {
      "name": "single-allocation-soa-benchmark",
      "displayName": "Single-allocation SoA comparison",
      "inherits": "benchmark-tests",
      "output": {
        "verbosity": "verbose"
      },
      "filter": {
        "include": {
          "name": "^SandboxCore\\.SingleAllocation\\.(BulkBenchmarkCorrectness|BenchmarkCorrectness|Timing\\.[A-Za-z0-9_]+)$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "kernel-benchmark-tests",
      "configurePreset": "kernel-benchmark",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "native-kernel-benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "kernel-benchmark-plot-tests",
      "configurePreset": "kernel-benchmark-plots",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "native-kernel-benchmark|kernel-benchmark-plot"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "codegen-tests",
      "configurePreset": "codegen",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "codegen"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^all$"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "benchmark-tests",
      "configurePreset": "benchmark",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gpu-starfield-benchmark-tests",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu-benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gpu-starfield-matrix-tests",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu-starfield-matrix"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sandbox-ismc-benchmark",
      "configurePreset": "sandbox-ismc-benchmark",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "sandbox-ismc-benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "spark-benchmark",
      "configurePreset": "spark-benchmark",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "spark-benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-input-smoke-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "input-smoke"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-level-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "level"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-unit-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "native-soa",
      "configurePreset": "native-soa",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^(native-soa|SingleAllocationSoa\\.|Json\\.LoadsExperimentalStdlibSoa)"
        }
      }
    }
  ],
