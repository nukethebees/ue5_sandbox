{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "codegen",
      "displayName": "Code generator",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SANDBOX_CODEGEN_ONLY": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Debug"
      }
    },
    {
      "name": "debug-game",
      "displayName": "DebugGame",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "development",
      "displayName": "Development",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Development"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "benchmark"
      }
    },
    {
      "name": "shipping",
      "displayName": "Shipping",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Shipping"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Test"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "codegen",
      "configurePreset": "codegen",
      "targets": ["sandbox-codegen", "sandbox-slatec", "codegen-tests", "slate-codegen-tests"]
    },
    {
      "name": "generate-code",
      "configurePreset": "codegen",
      "targets": ["generate-code"]
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": ["dev-core"]
    },
    {
      "name": "debug-game",
      "configurePreset": "debug-game",
      "targets": ["dev-core"]
    },
    {
      "name": "development",
      "configurePreset": "development",
      "targets": ["dev-core"]
    },
    {
      "name": "shipping",
      "configurePreset": "shipping",
      "targets": ["dev-core"]
    },
    {
      "name": "test",
      "configurePreset": "test",
      "targets": ["dev-core"]
    },
    {
      "name": "resave-assets",
      "configurePreset": "debug-game",
      "targets": ["resave-assets"]
    },
    {
      "name": "generate-project-files",
      "configurePreset": "debug-game",
      "targets": ["generate-project-files"]
    },
    {
      "name": "format-code",
      "configurePreset": "debug-game",
      "targets": ["format-code"]
    },
    {
      "name": "format-all-code",
      "configurePreset": "debug-game",
      "targets": ["format-all-code"]
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "targets": ["benchmarks"]
    },
    {
      "name": "gpu-starfield-benchmark",
      "configurePreset": "development",
      "targets": ["editor"]
    }
  ],
  "testPresets": [
    {
      "name": "codegen-tests",
      "configurePreset": "codegen",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "codegen"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "^all$"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "benchmark-tests",
      "configurePreset": "benchmark",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gpu-starfield-benchmark-tests",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu-benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "gpu-starfield-matrix-tests",
      "configurePreset": "development",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "gpu-starfield-matrix"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-level-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "level"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "debug-game-unit-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "unit"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "codegen",
      "steps": [
        { "type": "configure", "name": "codegen" },
        { "type": "build", "name": "codegen" },
        { "type": "test", "name": "codegen-tests" }
      ]
    },
    {
      "name": "generate-code",
      "steps": [
        { "type": "configure", "name": "codegen" },
        { "type": "build", "name": "generate-code" }
      ]
    },
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "debug-game",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "debug-game" }
      ]
    },
    {
      "name": "development",
      "steps": [
        { "type": "configure", "name": "development" },
        { "type": "build", "name": "development" }
      ]
    },
    {
      "name": "shipping",
      "steps": [
        { "type": "configure", "name": "shipping" },
        { "type": "build", "name": "shipping" }
      ]
    },
    {
      "name": "test",
      "steps": [
        { "type": "configure", "name": "test" },
        { "type": "build", "name": "test" }
      ]
    },
    {
      "name": "resave-assets",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "resave-assets" }
      ]
    },
    {
      "name": "generate-project-files",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "generate-project-files" }
      ]
    },
    {
      "name": "format-code",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "format-code" }
      ]
    },
    {
      "name": "format-all-code",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "format-all-code" }
      ]
    },
    {
      "name": "debug-game-tests",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "debug-game" },
        { "type": "test", "name": "debug-game-tests" }
      ]
    },
    {
      "name": "benchmark",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "benchmark-tests" }
      ]
    },
    {
      "name": "gpu-starfield-benchmark",
      "steps": [
        { "type": "configure", "name": "development" },
        { "type": "build", "name": "gpu-starfield-benchmark" },
        { "type": "test", "name": "gpu-starfield-benchmark-tests" }
      ]
    },
    {
      "name": "gpu-starfield-matrix",
      "steps": [
        { "type": "configure", "name": "development" },
        { "type": "build", "name": "gpu-starfield-benchmark" },
        { "type": "test", "name": "gpu-starfield-matrix-tests" }
      ]
    },
    {
      "name": "debug-game-unit-tests",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "debug-game" },
        { "type": "test", "name": "debug-game-unit-tests" }
      ]
    }
  ]
}
