{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Debug"
      }
    },
    {
      "name": "debug-game",
      "displayName": "DebugGame",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "development",
      "displayName": "Development",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Development"
      }
    },
    {
      "name": "benchmark",
      "displayName": "Benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "benchmark"
      }
    },
    {
      "name": "shipping",
      "displayName": "Shipping",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Shipping"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "inherits": "base",
      "cacheVariables": {
        "UE_CONFIGURATION": "Test"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "targets": ["dev-core"]
    },
    {
      "name": "debug-game",
      "configurePreset": "debug-game",
      "targets": ["dev-core"]
    },
    {
      "name": "development",
      "configurePreset": "development",
      "targets": ["dev-core"]
    },
    {
      "name": "shipping",
      "configurePreset": "shipping",
      "targets": ["dev-core"]
    },
    {
      "name": "test",
      "configurePreset": "test",
      "targets": ["dev-core"]
    },
    {
      "name": "resave-assets",
      "configurePreset": "debug-game",
      "targets": ["resave-assets"]
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "targets": ["benchmarks"]
    }
  ],
  "testPresets": [
    {
      "name": "debug-game-tests",
      "configurePreset": "debug-game",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "benchmark-tests",
      "configurePreset": "benchmark",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "benchmark"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" }
      ]
    },
    {
      "name": "debug-game",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "debug-game" }
      ]
    },
    {
      "name": "development",
      "steps": [
        { "type": "configure", "name": "development" },
        { "type": "build", "name": "development" }
      ]
    },
    {
      "name": "shipping",
      "steps": [
        { "type": "configure", "name": "shipping" },
        { "type": "build", "name": "shipping" }
      ]
    },
    {
      "name": "test",
      "steps": [
        { "type": "configure", "name": "test" },
        { "type": "build", "name": "test" }
      ]
    },
    {
      "name": "resave-assets",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "resave-assets" }
      ]
    },
    {
      "name": "debug-game-tests",
      "steps": [
        { "type": "configure", "name": "debug-game" },
        { "type": "build", "name": "debug-game" },
        { "type": "test", "name": "debug-game-tests" }
      ]
    },
    {
      "name": "benchmark",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "benchmark-tests" }
      ]
    }
  ]
}
