(defmacro s7-action (id label enabled clicked)
  (SButton
    :Text (loc "SS7LevelScriptEditor" $id $label)
    :IsEnabled (method $enabled)
    :OnClicked (method $clicked)))

(defmacro s7-row (left right)
  (auto
    (hbox
      (fill :padding 2 $left)
      (fill :padding 2 $right))))

(widget-class SS7LevelScriptEditor
  (function BuildRoot
    (params)
    (vbox
      (auto :padding 4
        (vbox
          (s7-row
            (s7-action "Load" "Load Source" can_load_source load_source)
            (SButton
              :Text (method reload_text)
              :IsEnabled (method can_reload_source)
              :OnClicked (method reload_source)))
          (s7-row
            (s7-action "Import" "Import Source" can_import_source import_source)
            (s7-action "Export" "Export Scene" can_export_scene export_scene))
          (s7-row
            (s7-action "Save" "Save Buffer" can_save_buffer save_buffer)
            (SSpacer))))
      (auto :padding (4 0)
        (assign state_ STextBlock :AutoWrapText true))
      (fill :padding 4
        (assign source_ SMultiLineEditableTextBox
          :AutoWrapText false
          :OnTextChanged (method on_source_changed)))
      (auto :padding 4
        (SBorder
          (assign status_ SMultiLineEditableTextBox
            :IsReadOnly true
            :AutoWrapText true))))))
