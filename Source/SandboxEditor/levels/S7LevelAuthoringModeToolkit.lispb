(defmacro authoring-action (id label clicked)
  (SButton
    :Text (loc "FS7LevelAuthoringModeToolkit" $id $label)
    :OnClicked (method $clicked)))

(defmacro authoring-row (left right)
  (auto
    (hbox
      (fill :padding 2 $left)
      (fill :padding 2 $right))))

(widget-class FS7LevelAuthoringModeToolkit
  (function BuildRoot
    (params (existing details))
    (vbox
      (auto :padding 2
        (vbox
          (authoring-row
            (authoring-action "CheckExport" "Check Export" check_export)
            (authoring-action "Export" "Export Scene" export_scene))
          (authoring-row
            (authoring-action "Create" "Create Mission" create_document)
            (authoring-action "Link" "Link / Change Script" link_script))
          (authoring-row
            (authoring-action "Rebuild" "Rebuild Scene" rebuild_scene)
            (authoring-action "ValidateSaved" "Validate Saved Mission" validate_playable_level))
          (authoring-row
            (authoring-action "EditScript" "Edit Mission Source" open_script_editor)
            (authoring-action "EditResources" "Edit Resources" open_level_config))
          (authoring-row
            (assign entity_id_ SEditableTextBox
              :HintText (loc "FS7LevelAuthoringModeToolkit" "EntityIdHint" "Selected entity ID"))
            (authoring-action "RenameEntity" "Rename Entity ID" rename_selected_entity))))
      (auto :padding 4
        (assign status_ SMultiLineEditableTextBox :IsReadOnly true :AutoWrapText true))
      (auto (existing details)))))
