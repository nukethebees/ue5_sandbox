(defmacro authoring-action (id label tooltip clicked)
  (SButton
    :Text (loc "FS7LevelAuthoringModeToolkit" $id $label)
    :ToolTipText $tooltip
    :OnClicked (method $clicked)))

(defmacro authoring-row (left right)
  (auto
    (hbox
      (fill :padding 2 $left)
      (fill :padding 2 $right))))

(widget-class FS7LevelAuthoringModeToolkit
  (function BuildRoot
    (params (existing details) (existing grid) (existing bounds))
    (vbox
      (auto :padding 2
        (vbox
          (authoring-row
            (authoring-action "CheckScene" "Check Scene"
              (loc "FS7LevelAuthoringModeToolkit" "CheckSceneTooltip" "Check pending placements, the linked script and shared assets. See results in the Output Log.") check_scene)
            (authoring-action "Export" "Export Scene"
              (loc "FS7LevelAuthoringModeToolkit" "ExportTooltip" "Write enabled actors and the viewpoint to editor-config.scm.") export_scene))
          (authoring-row
            (authoring-action "Create" "Create Level Script"
              (loc "FS7LevelAuthoringModeToolkit" "CreateTooltip" "Create a level script and scene file for this map, link them, and configure Play.") create_document)
            (authoring-action "Link" "Link Existing Script"
              (loc "FS7LevelAuthoringModeToolkit" "LinkTooltip" "Use an existing level script for this map and configure Play.") link_script))
          (authoring-row
            (authoring-action "Rebuild" "Rebuild Scene from Script"
              (loc "FS7LevelAuthoringModeToolkit" "RebuildTooltip" "Reload saved placements and viewpoint. Pending scene edits block rebuild. See the Output Log.") rebuild_scene)
            (authoring-action "ForceRebuild" "Force Rebuild from Script"
              (loc "FS7LevelAuthoringModeToolkit" "ForceRebuildTooltip" "Discard pending scene edits and restore placements and viewpoint from the saved script.") force_rebuild_scene))
          (auto :padding 2
            (authoring-action "EditScript" "Edit Level Script"
              (loc "FS7LevelAuthoringModeToolkit" "EditScriptTooltip" "Open the linked .scm file in your external editor.") open_script_editor))
          (authoring-row (existing grid) (existing bounds))
          (auto :padding 2
            (assign script_id_row_ SBox
              (hbox
                (auto :padding 2 (STextBlock :Text (loc "FS7LevelAuthoringModeToolkit" "ScriptId" "Script ID")))
                (fill :padding 2 (assign entity_id_ SEditableTextBox
                  :ToolTipText (loc "FS7LevelAuthoringModeToolkit" "ScriptIdTooltip" "Press Enter to rename this actor's exported ID. Update references in handwritten scripts.")
                  :OnTextCommitted (method commit_script_id))))))))
      (auto (existing details)))))
