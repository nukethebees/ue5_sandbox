{
  "version": 1,
  "components": [
    {
      "name": "integration-policy",
      "paths": [".integration-gates.json", ".agent-git.json"],
      "gates": ["agent-git-tests", "jobserver-tests", "csharp-tools-tests", "powershell-checks", "python-checks", "cmake-checks", "native-tests", "codegen-tests", "unreal-tests", "development-build"],
      "affects": []
    },
    {
      "name": "docs",
      "paths": ["AGENTS.md", "README.md", "docs/", "PowerShell/README.md", "cmake/README.md"],
      "gates": [],
      "affects": []
    },
    {
      "name": "powershell",
      "paths": ["dev.ps1", "PowerShell/"],
      "gates": ["powershell-checks"],
      "affects": ["agent-git"]
    },
    {
      "name": "python",
      "paths": ["Scripts/"],
      "gates": ["python-checks"],
      "affects": []
    },
    {
      "name": "native-presets",
      "paths": ["cmake/presets/native.json"],
      "gates": ["cmake-checks", "native-tests"],
      "affects": []
    },
    {
      "name": "unreal-presets",
      "paths": ["cmake/presets/unreal.json"],
      "gates": ["cmake-checks", "unreal-tests", "development-build"],
      "affects": []
    },
    {
      "name": "preset-generator",
      "paths": ["cmake/presets/"],
      "gates": ["python-checks", "cmake-checks", "native-tests", "unreal-tests", "development-build"],
      "affects": []
    },
    {
      "name": "global-cmake",
      "paths": ["CMakeLists.txt", "CMakePresets.json", "cmake/"],
      "gates": ["cmake-checks", "csharp-tools-tests", "native-tests", "codegen-tests", "unreal-tests", "development-build"],
      "affects": []
    },
    {
      "name": "native-unreal-interface",
      "paths": ["native/core/include/", "native/memory/include/", "native/simulation/include/", "native/level_authoring/include/"],
      "gates": ["native-tests", "unreal-tests", "development-build"],
      "affects": []
    },
    {
      "name": "native",
      "paths": ["native/"],
      "gates": ["native-tests"],
      "affects": []
    },
    {
      "name": "codegen",
      "paths": ["Codegen/", "lispb/"],
      "gates": ["codegen-tests", "native-tests"],
      "affects": []
    },
    {
      "name": "unreal",
      "paths": ["Source/", "Plugins/", "unreal/", "Config/", "Sandbox.uproject"],
      "gates": ["unreal-tests", "development-build"],
      "affects": []
    },
    {
      "name": "benchmark",
      "paths": ["native/simulation_benchmark/"],
      "gates": ["benchmark-build"],
      "affects": []
    },
    {
      "name": "agent-git",
      "paths": ["tools/AgentGit/", "tools/AgentGit.Tests/"],
      "gates": ["agent-git-tests"],
      "affects": []
    },
    {
      "name": "agent-git-installer",
      "paths": ["tools/AgentGitInstaller/", "tools/AgentGitInstaller.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "architecture-checks",
      "paths": ["tools/ArchitectureChecks/", "tools/ArchitectureChecks.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "benchmark-tools",
      "paths": ["tools/BenchmarkTools/", "tools/BenchmarkTools.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "code-format-tools",
      "paths": ["tools/CodeFormatTools/", "tools/CodeFormatTools.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "game-package-tools",
      "paths": ["tools/GamePackageTools/", "tools/GamePackageTools.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "git-tools",
      "paths": ["tools/GitTools/", "tools/GitTools.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "native-binary-tools",
      "paths": ["tools/NativeBinaryTools/", "tools/NativeBinaryTools.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "unreal-build-tools",
      "paths": ["tools/UnrealBuildTools/", "tools/UnrealBuildTools.Tests/"],
      "gates": ["csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "git-support",
      "paths": ["tools/GitSupport/"],
      "gates": ["csharp-tools-tests"],
      "affects": ["agent-git", "agent-git-installer", "git-tools"]
