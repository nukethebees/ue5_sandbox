      "affects": []
    },
    {
      "name": "jobserver",
      "paths": ["tools/jobserver/"],
      "gates": ["jobserver-tests"],
      "affects": []
    },
    {
      "name": "rust-tools",
      "paths": ["tools/rust/"],
      "gates": ["rust-tools-tests"],
      "affects": []
    },
    {
      "name": "perf-tools",
      "paths": ["tools/perf/"],
      "gates": ["benchmark-build"],
      "affects": []
    },
    {
      "name": "csharp-infrastructure",
      "paths": ["tools/Directory.Build.props", "tools/Directory.Build.targets", "tools/Tools.slnx"],
      "gates": ["agent-git-tests", "csharp-tools-tests"],
      "affects": []
    },
    {
      "name": "unknown-tools",
      "paths": ["tools/"],
      "gates": ["tool-tests", "native-tests"],
      "affects": []
    }
  ]
}
