{
  "version": 9,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "native",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "SANDBOX_WITH_UNREAL": false,
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-simulation",
      "configurePreset": "native-debug",
      "targets": ["native-simulation-tests"]
    },
    {
      "name": "codegen",
      "configurePreset": "native-debug",
      "targets": ["lispb", "codegen-tests", "slate-codegen-tests", "kernel-codegen-tests"]
    },
    {
      "name": "generate-code",
      "configurePreset": "native-debug",
      "targets": ["generate-code"]
    },
    {
      "name": "native-core",
      "configurePreset": "native-release",
      "targets": ["native-core-tests"]
    },
    {
      "name": "native-memory",
      "configurePreset": "native-debug",
      "targets": ["native-memory-tests"]
    },
    {
      "name": "native-mesh",
      "configurePreset": "native-debug",
      "targets": ["mesh-gen-tests"]
    },
    {
      "name": "native-s7",
      "configurePreset": "native-debug",
      "targets": ["sandbox-s7-tests"]
    }
  ],
  "testPresets": [
    {
      "name": "native-simulation",
      "inherits": "test-base",
      "configurePreset": "native-debug",
      "filter": { "include": { "label": "native-simulation" } },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "codegen-tests",
      "inherits": "test-base",
      "configurePreset": "native-debug",
      "filter": {
        "include": {
          "label": "codegen"
        }
      }
    },
    {
      "name": "native-core",
      "inherits": "test-base",
      "configurePreset": "native-release",
      "filter": {
        "include": {
          "label": "native-core"
        }
      }
    },
    {
      "name": "native-memory",
      "inherits": "test-base",
      "configurePreset": "native-debug",
      "filter": {
        "include": {
          "name": "^native-memory-tests$"
        }
      }
    },
    {
      "name": "native-mesh",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "native-mesh"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "native-s7",
      "inherits": "test-base",
      "configurePreset": "native-debug",
      "filter": {
        "include": {
          "label": "native-s7"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "native-simulation",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "native-simulation" },
        { "type": "test", "name": "native-simulation" }
      ]
    },
    {
      "name": "codegen",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "codegen" },
        { "type": "test", "name": "codegen-tests" }
      ]
    },
    {
      "name": "generate-code",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "generate-code" }
      ]
    },
    {
      "name": "native-mesh",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "native-mesh" },
        { "type": "test", "name": "native-mesh" }
      ]
    },
    {
      "name": "native-core",
      "steps": [
        { "type": "configure", "name": "native-release" },
        { "type": "build", "name": "native-core" },
        { "type": "test", "name": "native-core" }
      ]
    },
    {
      "name": "native-memory",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "native-memory" },
        { "type": "test", "name": "native-memory" }
      ]
    },
    {
      "name": "native-s7",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "native-s7" },
        { "type": "test", "name": "native-s7" }
      ]
    }
  ]
}
