{
  "version": 9,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "native",
      "hidden": true,
      "inherits": "windows-clang-cl",
      "cacheVariables": {
        "SANDBOX_WITH_UNREAL": false,
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "native-msvc",
      "hidden": true,
      "inherits": "windows-msvc",
      "cacheVariables": {
        "SANDBOX_WITH_UNREAL": false,
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "inherits": "native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-debug-msvc",
      "displayName": "Native Debug (MSVC)",
      "inherits": "native-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release-msvc",
      "displayName": "Native Release (MSVC)",
      "inherits": "native-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-debug-msvc",
      "configurePreset": "native-debug-msvc"
    },
    {
      "name": "native-release-msvc",
      "configurePreset": "native-release-msvc"
    },
    {
      "name": "codegen",
      "configurePreset": "native-debug",
      "targets": ["lispb", "codegen-tests", "slate-codegen-tests", "kernel-codegen-tests"]
    },
    {
      "name": "generate-code",
      "configurePreset": "native-debug",
      "targets": ["generate-code"]
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "inherits": "test-base",
      "configurePreset": "native-debug",
      "filter": { "include": { "label": "all" } }
    },
    {
      "name": "native-release",
      "inherits": "test-base",
      "configurePreset": "native-release",
      "filter": { "include": { "label": "all" } }
    },
    {
      "name": "native-debug-msvc",
      "inherits": "test-base",
      "configurePreset": "native-debug-msvc",
      "filter": { "include": { "label": "all" } }
    },
    {
      "name": "native-release-msvc",
      "inherits": "test-base",
      "configurePreset": "native-release-msvc",
      "filter": { "include": { "label": "all" } }
    },
    {
      "name": "codegen-tests",
      "inherits": "test-base",
      "configurePreset": "native-debug",
      "filter": {
        "include": {
          "label": "codegen"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "native-debug",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "native-debug" },
        { "type": "test", "name": "native-debug" }
      ]
    },
    {
      "name": "native-release",
      "steps": [
        { "type": "configure", "name": "native-release" },
        { "type": "build", "name": "native-release" },
        { "type": "test", "name": "native-release" }
      ]
    },
    {
      "name": "native-debug-msvc",
      "steps": [
        { "type": "configure", "name": "native-debug-msvc" },
        { "type": "build", "name": "native-debug-msvc" },
        { "type": "test", "name": "native-debug-msvc" }
      ]
    },
    {
      "name": "native-release-msvc",
      "steps": [
        { "type": "configure", "name": "native-release-msvc" },
        { "type": "build", "name": "native-release-msvc" },
        { "type": "test", "name": "native-release-msvc" }
      ]
    },
    {
      "name": "codegen",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "codegen" },
        { "type": "test", "name": "codegen-tests" }
      ]
    },
    {
      "name": "generate-code",
      "steps": [
        { "type": "configure", "name": "native-debug" },
        { "type": "build", "name": "generate-code" }
      ]
    }
  ]
}
