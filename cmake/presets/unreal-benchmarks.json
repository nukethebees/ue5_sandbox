{
  "version": 9,
  "include": ["unreal.json"],
  "configurePresets": [
    {
      "name": "benchmark",
      "displayName": "Benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "benchmark"
      }
    },
    {
      "name": "sandbox-ismc-benchmark",
      "displayName": "SandboxISMC benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "editor-only"
      }
    },
    {
      "name": "spark-benchmark",
      "displayName": "Spark renderer benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "editor-only",
        "SANDBOX_SPARK_BENCHMARK_SECONDS": "10",
        "SANDBOX_SPARK_BENCHMARK_CAPACITY": "50000",
        "SANDBOX_SPARK_BENCHMARK_SPARKS_PER_HIT": "96",
        "SANDBOX_SPARK_BENCHMARK_IMPACTS_PER_FRAME": "100",
        "SANDBOX_SPARK_BENCHMARK_WARMUP_FRAMES": "60"
      }
    },
    {
      "name": "telemetry-benchmark",
      "displayName": "SpaceGame telemetry benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "editor-only"
      }
    },
    {
      "name": "frame-memory-level-benchmark",
      "displayName": "SpaceGame frame-memory level benchmark",
      "inherits": "development",
      "cacheVariables": {
        "SANDBOX_TEST_SUITE": "editor-only"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "single-allocation-soa-spacing-confirmation",
      "configurePreset": "benchmark",
      "targets": ["single-allocation-soa-spacing-confirmation"]
    },
    {
      "name": "single-allocation-soa-spacing",
      "configurePreset": "benchmark",
      "targets": ["single-allocation-soa-spacing"]
    },
    {
      "name": "single-allocation-soa-plots",
      "configurePreset": "benchmark",
      "targets": ["single-allocation-soa-plots"]
    },
    {
      "name": "benchmark",
      "configurePreset": "benchmark",
      "targets": ["benchmarks"]
    },
    {
      "name": "gpu-starfield-benchmark",
      "configurePreset": "development",
      "targets": ["editor"]
    },
    {
      "name": "sandbox-ismc-benchmark",
      "configurePreset": "sandbox-ismc-benchmark",
      "targets": ["editor"]
    },
    {
      "name": "spark-benchmark",
      "configurePreset": "spark-benchmark",
      "targets": ["editor"]
    },
    {
      "name": "telemetry-benchmark",
      "configurePreset": "telemetry-benchmark",
      "targets": ["editor"]
    },
    {
      "name": "frame-memory-level-benchmark",
      "configurePreset": "frame-memory-level-benchmark",
      "targets": ["editor"]
    }
  ],
  "testPresets": [
    {
      "name": "single-allocation-soa-spacing-confirmation-correctness",
      "inherits": "test-base",
      "configurePreset": "benchmark",
      "output": { "verbosity": "verbose" },
      "execution": { "jobs": 1 },
      "filter": { "include": { "name": "^SandboxCore\\.SingleAllocation\\.Spacing\\.(Correctness|ShapeCorrectness|AffinityCorrectness|ConfirmationSmoke|ConfirmationReportTests)$" } }
    },
    {
      "name": "single-allocation-soa-spacing-correctness",
      "inherits": "test-base",
      "configurePreset": "benchmark",
      "output": { "verbosity": "verbose" },
      "execution": { "jobs": 1 },
      "filter": { "include": { "name": "^SandboxCore\\.SingleAllocation\\.Spacing\\.(Correctness|PipelineSmoke)$" } }
    },
    {
      "name": "single-allocation-soa-iteration-investigation",
      "displayName": "Isolated SoA iteration column-spacing comparison",
      "inherits": "single-allocation-soa-benchmark",
      "filter": {
        "include": {
          "name": "^SandboxCore\\.SingleAllocation\\.IterationInvestigation\\."
        }
      }
    },
    {
      "name": "single-allocation-soa-reserve",
      "displayName": "Single-allocation SoA reserve only",
      "inherits": "single-allocation-soa-benchmark",
      "filter": {
        "include": {
          "name": "^SandboxCore\\.SingleAllocation\\.Timing\\.reserve_(TArray|SingleMimalloc)$"
        }
      }
    },
    {
      "name": "single-allocation-soa-benchmark",
      "displayName": "Single-allocation SoA comparison",
      "inherits": "benchmark-tests",
      "output": {
        "verbosity": "verbose"
      },
      "filter": {
        "include": {
          "name": "^SandboxCore\\.SingleAllocation\\.(BulkBenchmarkCorrectness|BenchmarkCorrectness|Timing\\.[A-Za-z0-9_]+)$"
        }
      },
      "execution": {
        "jobs": 1
      }
    },
    {
      "name": "benchmark-tests",
      "inherits": "test-base",
      "configurePreset": "benchmark",
      "filter": {
        "include": {
          "label": "^benchmark$"
        }
      }
    },
    {
      "name": "gpu-starfield-benchmark-tests",
      "inherits": "test-base",
      "configurePreset": "development",
      "filter": {
        "include": {
          "label": "gpu-benchmark"
        }
      }
    },
    {
      "name": "gpu-starfield-matrix-tests",
      "inherits": "test-base",
      "configurePreset": "development",
      "filter": {
        "include": {
          "label": "gpu-starfield-matrix"
        }
      }
    },
    {
      "name": "sandbox-ismc-benchmark",
      "inherits": "test-base",
      "configurePreset": "sandbox-ismc-benchmark",
      "filter": {
        "include": {
          "label": "sandbox-ismc-benchmark"
        }
      }
    },
    {
      "name": "spark-benchmark",
      "inherits": "test-base",
      "configurePreset": "spark-benchmark",
      "filter": {
        "include": {
          "label": "^spark-benchmark$"
        }
      }
    },
    {
      "name": "telemetry-benchmark",
      "inherits": "test-base",
      "configurePreset": "telemetry-benchmark",
      "filter": {
        "include": {
          "label": "^telemetry-benchmark$"
        }
      }
    },
    {
      "name": "frame-memory-level-benchmark",
      "inherits": "test-base",
      "configurePreset": "frame-memory-level-benchmark",
      "filter": {
        "include": {
          "label": "^frame-memory-level-benchmark$"
        }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "single-allocation-soa-spacing-confirmation",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "single-allocation-soa-spacing-confirmation-correctness" },
        { "type": "build", "name": "single-allocation-soa-spacing-confirmation" }
      ]
    },
    {
      "name": "single-allocation-soa-spacing",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "single-allocation-soa-spacing-correctness" },
        { "type": "build", "name": "single-allocation-soa-spacing" }
      ]
    },
    {
      "name": "single-allocation-soa-reserve",
      "displayName": "Build and profile the SoA reserve comparison",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "single-allocation-soa-reserve" },
        { "type": "build", "name": "single-allocation-soa-plots" }
      ]
    },
    {
      "name": "single-allocation-soa-benchmark",
      "displayName": "Build and run the single-allocation SoA comparison",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "single-allocation-soa-benchmark" },
        { "type": "build", "name": "single-allocation-soa-plots" }
      ]
    },
    {
      "name": "benchmark",
      "steps": [
        { "type": "configure", "name": "benchmark" },
        { "type": "build", "name": "benchmark" },
        { "type": "test", "name": "benchmark-tests" }
      ]
    },
    {
      "name": "gpu-starfield-benchmark",
      "steps": [
        { "type": "configure", "name": "development" },
        { "type": "build", "name": "gpu-starfield-benchmark" },
        { "type": "test", "name": "gpu-starfield-benchmark-tests" }
      ]
    },
    {
      "name": "gpu-starfield-matrix",
      "steps": [
        { "type": "configure", "name": "development" },
        { "type": "build", "name": "gpu-starfield-benchmark" },
        { "type": "test", "name": "gpu-starfield-matrix-tests" }
      ]
    },
    {
      "name": "sandbox-ismc-benchmark",
      "steps": [
        { "type": "configure", "name": "sandbox-ismc-benchmark" },
        { "type": "build", "name": "sandbox-ismc-benchmark" },
        { "type": "test", "name": "sandbox-ismc-benchmark" }
      ]
    },
    {
      "name": "spark-benchmark",
      "steps": [
        { "type": "configure", "name": "spark-benchmark" },
        { "type": "build", "name": "spark-benchmark" },
        { "type": "test", "name": "spark-benchmark" }
      ]
    },
    {
      "name": "telemetry-benchmark",
      "steps": [
        { "type": "configure", "name": "telemetry-benchmark" },
        { "type": "build", "name": "telemetry-benchmark" },
        { "type": "test", "name": "telemetry-benchmark" }
      ]
    },
    {
      "name": "frame-memory-level-benchmark",
      "steps": [
        { "type": "configure", "name": "frame-memory-level-benchmark" },
        { "type": "build", "name": "frame-memory-level-benchmark" },
        { "type": "test", "name": "frame-memory-level-benchmark" }
      ]
    }
  ]
}
