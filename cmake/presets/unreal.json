{
  "version": 9,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "unreal",
      "hidden": true,
      "inherits": "windows-clang-cl",
      "cacheVariables": {
        "CMAKE_C_FLAGS_RELEASE": "/O2 /DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Zi /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Zi /DNDEBUG",
        "SANDBOX_WITH_UNREAL": true
      }
    },
    {
      "name": "unreal-msvc",
      "hidden": true,
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_C_FLAGS_RELEASE": "/O2 /DNDEBUG",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "/O2 /Zi /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "/O2 /Zi /DNDEBUG",
        "SANDBOX_WITH_UNREAL": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "unreal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UE_CONFIGURATION": "Debug"
      }
    },
    {
      "name": "debug-game",
      "displayName": "DebugGame",
      "inherits": "unreal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "development",
      "displayName": "Development",
      "inherits": "unreal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "UE_CONFIGURATION": "Development"
      }
    },
    {
      "name": "shipping",
      "displayName": "Shipping",
      "inherits": "unreal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UE_CONFIGURATION": "Shipping"
      }
    },
    {
      "name": "test",
      "displayName": "Test",
      "inherits": "unreal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UE_CONFIGURATION": "Test"
      }
    },
    {
      "name": "debug-msvc",
      "displayName": "Debug (MSVC native)",
      "inherits": "unreal-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UE_CONFIGURATION": "Debug"
      }
    },
    {
      "name": "debug-game-msvc",
      "displayName": "DebugGame (MSVC native)",
      "inherits": "unreal-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UE_CONFIGURATION": "DebugGame"
      }
    },
    {
      "name": "development-msvc",
      "displayName": "Development (MSVC native)",
      "inherits": "unreal-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "UE_CONFIGURATION": "Development"
      }
    },
    {
      "name": "shipping-msvc",
      "displayName": "Shipping (MSVC native)",
      "inherits": "unreal-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UE_CONFIGURATION": "Shipping"
      }
    },
    {
      "name": "test-msvc",
      "displayName": "Test (MSVC native)",
      "inherits": "unreal-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UE_CONFIGURATION": "Test"
      }
    }
  ],
