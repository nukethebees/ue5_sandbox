diff --git a/clang/test/Analysis/track-control-dependency-reclamation.cpp b/clang/test/Analysis/track-control-dependency-reclamation.cpp
new file mode 100644
--- /dev/null
+++ b/clang/test/Analysis/track-control-dependency-reclamation.cpp
@@ -0,0 +1,26 @@
+// RUN: %clang_analyze_cc1 -std=c++23 -analyzer-checker=core \
+// RUN:   -analyzer-config track-conditions=true,graph-trim-interval=19 \
+// RUN:   -analyzer-output=text -verify %s
+
+// Reclamation can recycle the shift operand's node into a later invocation of
+// next() before the report's control-dependency visitor runs. The visitor must
+// retain the original CFG block and frame, not the recyclable node.
+int next(int x) {
+  if (x > 0) // expected-note {{Assuming 'x' is <= 0}}
+             // expected-note@-1 {{Taking false branch}}
+    return x + 1;
+  return x - 1; // expected-note {{Returning value}}
+}
+
+unsigned test(int bits) {
+  for (int i = 0; i < 4; ++i) { // expected-note {{Loop condition is true}}
+    int b = next(bits); // expected-note {{Calling 'next'}}
+                       // expected-note@-1 {{Returning from 'next'}}
+                       // expected-note@-2 {{'b' initialized here}}
+    if (b < 0) // expected-note {{Assuming 'b' is < 0}}
+               // expected-note@-1 {{Taking true branch}}
+      return unsigned{1} << b; // expected-warning {{Right operand is negative in left shift}}
+                               // expected-note@-1 {{The result of left shift is undefined because the right operand is negative}}
+  }
+  return 0;
+}
