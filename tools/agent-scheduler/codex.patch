+impl SpawnedProcess {
+    /// Supply a root-only event for backends whose ordinary exit waits for output.
+    pub fn with_root_exit(mut self, root_exit: oneshot::Receiver<i32>) -> Self {
+        self.session.root_exit_rx = Some(root_exit);
+        self
+    }
+
+    /// Observe true root exit before publishing ordinary process completion.
+    /// Output draining is unchanged. Standard pipe/PTY exit already comes from child.wait().
+    pub fn on_root_exit(&mut self, observer: impl FnOnce(Option<i32>) + Send + 'static) {
+        let root = self.session.root_exit_rx.take();
+        let (exit_tx, exit_rx) = oneshot::channel();
+        let original = std::mem::replace(&mut self.exit_rx, exit_rx);
+        tokio::spawn(async move {
+            let result = if let Some(root) = root {
+                observer(root.await.ok());
+                original.await
+            } else {
+                let result = original.await;
+                observer(result.as_ref().ok().copied());
+                result
+            };
+            if let Ok(code) = result {
+                let _ = exit_tx.send(code);
+            }
+        });
+    }
+}
