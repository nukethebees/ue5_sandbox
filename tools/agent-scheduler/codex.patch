+#[test]
+fn runner_root_exit_is_separate_from_output_and_final_completion() -> Result<()> {
+    let mut frames = tempfile::tempfile()?;
+    for message in [
+        Message::RootExit {
+            payload: ExitPayload {
+                exit_code: 17,
+                timed_out: false,
+            },
+        },
+        Message::Output {
+            payload: crate::ipc_framed::OutputPayload {
+                data_b64: encode_bytes(b"tail"),
+                stream: OutputStream::Stdout,
+            },
+        },
+        Message::Exit {
+            payload: ExitPayload {
+                exit_code: 23,
+                timed_out: false,
+            },
+        },
+    ] {
+        write_frame(
+            &mut frames,
+            &FramedMessage {
+                version: IPC_PROTOCOL_VERSION,
+                message,
+            },
+        )?;
+    }
+    frames.rewind()?;
+    let (stdout_tx, mut stdout_rx) = broadcast::channel(4);
+    let (root_tx, root_rx) = oneshot::channel();
+    let (exit_tx, exit_rx) = oneshot::channel();
+    start_runner_stdout_reader(
+        frames,
+        stdout_tx,
+        /*stderr_tx*/ None,
+        exit_tx,
+        Some(root_tx),
+    );
+    assert_eq!(root_rx.blocking_recv()?, 17);
+    assert_eq!(stdout_rx.blocking_recv()?, b"tail");
+    assert_eq!(exit_rx.blocking_recv()?, 23);
+    Ok(())
+}
