+bool ASandboxISMCBenchmarkActor::establish_viewport() {
+    if (requested_width_ == 0 && requested_height_ == 0 && output_directory_.IsEmpty()) {
+        viewport_ready_ = true;
+        return true;
+    }
+
+    auto* const client{GetWorld()->GetGameViewport()};
+    auto* const viewport{client != nullptr ? client->GetGameViewport() : nullptr};
+    if (viewport != nullptr && requested_width_ > 0 && requested_height_ > 0) {
+        if (!viewport_requested_) {
+            viewport->SetFixedViewportSize(requested_width_, requested_height_);
+            viewport_requested_ = true;
+            return false;
+        }
+        observed_viewport_ = viewport->GetSizeXY();
+        if (observed_viewport_ == FIntPoint{requested_width_, requested_height_}) {
+            viewport_ready_ = true;
+            warmup_started_seconds_ = FPlatformTime::Seconds();
+            return false;
+        }
+    } else if (FPlatformTime::Seconds() - warmup_started_seconds_ < 10.0) {
+        return false;
+    }
+
+    terminate_benchmark(FString::Printf(
+        TEXT("Viewport verification failed before warmup: requested %dx%d, observed %dx%d"),
+        requested_width_,
+        requested_height_,
+        observed_viewport_.X,
+        observed_viewport_.Y));
+    return false;
+}
+
+void ASandboxISMCBenchmarkActor::save_conditions(FString const& error) const {
+    if (output_directory_.IsEmpty()) {
+        return;
+    }
+
+    auto const result{MakeShared<FJsonObject>()};
+    result->SetNumberField(TEXT("schemaVersion"), 1);
+    result->SetStringField(TEXT("runId"), run_id_);
+    result->SetBoolField(TEXT("complete"), error.IsEmpty());
+    result->SetStringField(TEXT("error"), error);
+    auto const conditions{MakeShared<FJsonObject>()};
+    auto const number{[&](TCHAR const* key, double value) {
+        conditions->SetStringField(key, FString::Printf(TEXT("%.9g"), value));
+    }};
+    conditions->SetStringField(TEXT("result_schema"), TEXT("1"));
+    conditions->SetStringField(TEXT("mode"), get_mode_name());
+    conditions->SetStringField(TEXT("visibility"), get_visibility_name());
+    conditions->SetStringField(TEXT("bounds"), get_bounds_name());
+    conditions->SetStringField(TEXT("custom_data"), get_custom_data_name());
+    conditions->SetStringField(TEXT("rhi"),
+                               GDynamicRHI != nullptr ? GDynamicRHI->GetName() : TEXT("unknown"));
+    number(TEXT("instances"), instance_count_);
+    number(TEXT("update_percent"), update_percentage_);
+    number(TEXT("churn"), churn_enabled_ ? 1 : 0);
+    number(TEXT("min_instances"), minimum_live_count_);
+    number(TEXT("half_cycle_updates"), churn_half_cycle_updates_);
+    number(TEXT("replacement_percent"), replacement_percentage_);
+    number(TEXT("warmup_updates"), warmup_updates_);
+    number(TEXT("warmup_seconds"), warmup_seconds_);
+    number(TEXT("measurement_seconds"), automatic_stop_seconds_);
+    number(TEXT("shadows"), cast_shadows_ ? 1 : 0);
+    number(TEXT("trace"), capture_insights_trace_ ? 1 : 0);
+    number(TEXT("requested_width"), requested_width_);
+    number(TEXT("requested_height"), requested_height_);
+    number(TEXT("observed_width"), observed_viewport_.X);
+    number(TEXT("observed_height"), observed_viewport_.Y);
+    number(TEXT("grid_spacing"), grid_spacing_);
+    number(TEXT("grid_gap"), grid_gap_);
+    number(TEXT("movement_amplitude"), vertical_movement_amplitude_);
+    number(TEXT("movement_frequency"), movement_frequency_hz_);
+    number(TEXT("rotation_speed"), rotation_speed_degrees_);
+    number(TEXT("frame_limits_disabled"), frame_rate_limits_disabled_ ? 1 : 0);
+    for (auto const* name : {TEXT("r.ScreenPercentage"),
+                             TEXT("r.DynamicRes.OperationMode"),
+                             TEXT("r.VSync"),
+                             TEXT("r.VSyncEditor"),
+                             TEXT("t.MaxFPS")}) {
+        if (auto const* variable{IConsoleManager::Get().FindConsoleVariable(name)}) {
+            number(name, variable->GetFloat());
+        }
+    }
+    result->SetObjectField(TEXT("conditions"), conditions);
+    FString json;
+    auto const writer{TJsonWriterFactory<>::Create(&json)};
+    FJsonSerializer::Serialize(result, writer);
+    auto const path{FPaths::Combine(output_directory_, TEXT("result.json"))};
+    IFileManager::Get().MakeDirectory(*output_directory_, true);
+    auto const temporary{path + TEXT(".tmp")};
+    if (!FFileHelper::SaveStringToFile(json, *temporary) ||
+        !IFileManager::Get().Move(*path, *temporary, true, true)) {
+        UE_LOG(LogSandboxISMCBenchmark, Error, TEXT("Could not publish conditions to %s"), *path);
     }
 }
