(kernel-module array_math
  (emit unreal
    (header "ArrayKernels.h")
    (source "ArrayKernels.cpp")
    (header-include "ArrayKernels.h")
    (namespace ml)
    (export COMPILE_FIXTURE_API))

  (type-set numeric int32 float double)
  (type-set floating float double)

  (map add
    (types numeric)
    (operand data array)
    (operand value scalar)
    (output out)
    (expression (+ data value))
    (variants
      (in-place data add_in_place)))

  (map subtract
    (types numeric)
    (operand data array)
    (operand value scalar)
    (output out)
    (expression (- data value))
    (variants
      (in-place data subtract_in_place)))

  (map multiply
    (types numeric)
    (operand lhs array)
    (operand rhs (array scalar))
    (output out)
    (expression (* lhs rhs))
    (variants
      (out-of-place multiply)
      (in-place lhs multiply_in_place)))

  (map divide
    (types numeric)
    (operand data array)
    (operand value scalar)
    (output out)
    (expression (/ data value))
    (variants
      (in-place data divide_in_place)))

  (map add_nan
    (types floating)
    (operand data array)
    (output out)
    (expression (+ data (constant nan)))
    (variants
      (out-of-place add_nan)))

  (map add_infinity
    (types floating)
    (operand data array)
    (output out)
    (expression (+ data (constant infinity)))
    (variants
      (out-of-place add_infinity)))

  (map add_negative_infinity
    (types floating)
    (operand data array)
    (output out)
    (expression (+ data (constant negative-infinity)))
    (variants
      (out-of-place add_negative_infinity))))
